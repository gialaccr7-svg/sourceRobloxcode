      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">DamagePopup</string>
          <string name="Source"><![CDATA[--!strict
-- DamagePopup.luau
-- Spawns animated 3D BillboardGui damage numbers and combat notifications
-- (Red normal damage, Yellow/Orange crits, Guard Break warnings, Blocked hits)

local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local DamagePopup = {}

export type PopupType = "Normal" | "Crit" | "GuardBreak" | "Blocked" | "WallSplat" | "Awakening"

type StyleConfig = {
	TextColor: Color3,
	StrokeColor: Color3,
	TextSize: number,
	Prefix: string,
	Suffix: string,
	ScaleMultiplier: number,
	Font: Enum.Font,
}

local STYLES: { [PopupType]: StyleConfig } = {
	Normal = {
		TextColor = Color3.fromRGB(255, 65, 65), -- Bright red
		StrokeColor = Color3.fromRGB(40, 5, 5),
		TextSize = 26,
		Prefix = "-",
		Suffix = "",
		ScaleMultiplier = 1.0,
		Font = Enum.Font.GothamBlack,
	},
	Crit = {
		TextColor = Color3.fromRGB(255, 205, 40), -- Golden yellow
		StrokeColor = Color3.fromRGB(120, 45, 0),
		TextSize = 34,
		Prefix = "CRIT! -",
		Suffix = "!",
		ScaleMultiplier = 1.35,
		Font = Enum.Font.GothamBlack,
	},
	GuardBreak = {
		TextColor = Color3.fromRGB(255, 120, 20), -- Vivid orange
		StrokeColor = Color3.fromRGB(60, 10, 0),
		TextSize = 32,
		Prefix = "⚡ ",
		Suffix = " ⚡",
		ScaleMultiplier = 1.4,
		Font = Enum.Font.GothamBlack,
	},
	Blocked = {
		TextColor = Color3.fromRGB(120, 210, 255), -- Ice blue
		StrokeColor = Color3.fromRGB(10, 30, 60),
		TextSize = 22,
		Prefix = "🛡️ -",
		Suffix = "",
		ScaleMultiplier = 0.9,
		Font = Enum.Font.GothamBold,
	},
	WallSplat = {
		TextColor = Color3.fromRGB(255, 80, 180), -- Magenta / Hot pink
		StrokeColor = Color3.fromRGB(50, 0, 30),
		TextSize = 32,
		Prefix = "💥 WALL SPLAT -",
		Suffix = "",
		ScaleMultiplier = 1.3,
		Font = Enum.Font.GothamBlack,
	},
	Awakening = {
		TextColor = Color3.fromRGB(190, 80, 255), -- Electric purple
		StrokeColor = Color3.fromRGB(40, 0, 80),
		TextSize = 38,
		Prefix = "🔥 -",
		Suffix = " 🔥",
		ScaleMultiplier = 1.5,
		Font = Enum.Font.GothamBlack,
	},
}

-- Resolves target instance or creates an attachment if given a Vector3
local function resolveAdornee(target: Instance | Vector3): (Instance?, Attachment?, Vector3)
	if typeof(target) == "Vector3" then
		local att = Instance.new("Attachment")
		att.WorldPosition = target + Vector3.new(0, 2.5, 0)
		att.Parent = workspace.Terrain
		return nil, att, target
	elseif typeof(target) == "Instance" then
		if target:IsA("Model") then
			local head = target:FindFirstChild("Head") or target:FindFirstChild("HumanoidRootPart") or target.PrimaryPart
			if head and head:IsA("BasePart") then
				return head, nil, head.Position
			end
		elseif target:IsA("BasePart") or target:IsA("Attachment") then
			return target, nil, if target:IsA("BasePart") then target.Position else target.WorldPosition
		end
	end
	return nil, nil, Vector3.zero
end

-- Primary spawn function
function DamagePopup.Spawn(
	target: Instance | Vector3,
	amount: number | string,
	popupType: PopupType?,
	customColor: Color3?
)
	local pType = popupType or "Normal"
	local style = STYLES[pType] or STYLES.Normal

	local adornee, tempAttachment, basePos = resolveAdornee(target)
	if not adornee and not tempAttachment then
		return
	end

	-- Create BillboardGui
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "DamageBillboard"
	billboard.Size = UDim2.new(0, 180, 0, 60)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 150
	billboard.LightInfluence = 0
	billboard.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

	-- Random horizontal drift so consecutive combo hits don't stack directly on top
	local spreadX = (math.random() - 0.5) * 2.8
	local spreadY = (math.random() * 0.8)
	local startOffset = Vector3.new(spreadX, 2.5 + spreadY, 0)
	billboard.StudsOffset = startOffset

	if adornee then
		billboard.Adornee = adornee
		billboard.Parent = adornee
	elseif tempAttachment then
		billboard.Adornee = tempAttachment
		billboard.Parent = tempAttachment
	end

	-- Text container with scale punch
	local textLabel = Instance.new("TextLabel")
	textLabel.Name = "DamageLabel"
	textLabel.Size = UDim2.new(1, 0, 1, 0)
	textLabel.Position = UDim2.new(0.5, 0, 0.5, 0)
	textLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	textLabel.BackgroundTransparency = 1
	textLabel.Font = style.Font
	textLabel.TextSize = style.TextSize
	textLabel.TextColor3 = customColor or style.TextColor
	textLabel.TextStrokeColor3 = style.StrokeColor
	textLabel.TextStrokeTransparency = 0
	textLabel.ZIndex = 10

	-- Format text display
	if typeof(amount) == "number" then
		local rounded = math.round(amount * 10) / 10
		textLabel.Text = style.Prefix .. tostring(rounded) .. style.Suffix
	else
		textLabel.Text = tostring(amount)
	end

	-- UIStroke for extra punchy anime outline
	local uiStroke = Instance.new("UIStroke")
	uiStroke.Thickness = 2.5
	uiStroke.Color = style.StrokeColor
	uiStroke.Transparency = 0
	uiStroke.Parent = textLabel

	-- UIGradient for vibrant vertical sheen
	local uiGradient = Instance.new("UIGradient")
	uiGradient.Rotation = 90
	uiGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
		ColorSequenceKeypoint.new(0.4, textLabel.TextColor3),
		ColorSequenceKeypoint.new(1, textLabel.TextColor3:Lerp(Color3.new(0, 0, 0), 0.3)),
	})
	uiGradient.Parent = textLabel

	-- UIScale for punchy bounce animation
	local uiScale = Instance.new("UIScale")
	uiScale.Scale = 0.4
	uiScale.Parent = textLabel

	textLabel.Parent = billboard

	-- Animation Sequence:
	-- Phase 1: Snappy pop up scale punch (0.4 -> 1.35 * multiplier -> 1.0)
	local targetScale = style.ScaleMultiplier
	local popTween = TweenService:Create(
		uiScale,
		TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{ Scale = targetScale * 1.3 }
	)
	local settleTween = TweenService:Create(
		uiScale,
		TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Scale = targetScale }
	)

	-- Phase 2: Upward drift and fade out
	local endOffset = startOffset + Vector3.new(spreadX * 0.5, 3.2, 0)
	local driftTween = TweenService:Create(
		billboard,
		TweenInfo.new(0.85, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ StudsOffset = endOffset }
	)

	local fadeTween = TweenService:Create(
		textLabel,
		TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ TextTransparency = 1, TextStrokeTransparency = 1 }
	)
	local strokeFade = TweenService:Create(
		uiStroke,
		TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ Transparency = 1 }
	)

	-- Execute animation
	popTween:Play()
	popTween.Completed:Connect(function()
		settleTween:Play()
	end)

	driftTween:Play()

	-- Trigger fade after brief display
	task.delay(0.45, function()
		fadeTween:Play()
		strokeFade:Play()
	end)

	-- Clean up
	task.delay(0.95, function()
		if billboard and billboard.Parent then
			billboard:Destroy()
		end
		if tempAttachment and tempAttachment.Parent then
			tempAttachment:Destroy()
		end
	end)
end

-- Preset Spawners
function DamagePopup.Normal(target: Instance | Vector3, amount: number)
	DamagePopup.Spawn(target, amount, "Normal")
end

function DamagePopup.Crit(target: Instance | Vector3, amount: number)
	DamagePopup.Spawn(target, amount, "Crit")
end

function DamagePopup.GuardBreak(target: Instance | Vector3)
	DamagePopup.Spawn(target, "GUARD BREAK!", "GuardBreak")
end

function DamagePopup.Blocked(target: Instance | Vector3, amount: number)
	DamagePopup.Spawn(target, amount, "Blocked")
end

function DamagePopup.WallSplat(target: Instance | Vector3, amount: number)
	DamagePopup.Spawn(target, amount, "WallSplat")
end

function DamagePopup.Awakening(target: Instance | Vector3, amount: number)
	DamagePopup.Spawn(target, amount, "Awakening")
end

-- Auto-listener on client: connects to CombatEvent & BlockEvent to spawn popups automatically
if RunService:IsClient() then
	task.spawn(function()
		local ReplicatedStorage = game:GetService("ReplicatedStorage")
		local remotes = ReplicatedStorage:WaitForChild("Remotes", 8) :: Folder?
		if not remotes then return end

		local combatEvent = remotes:WaitForChild("CombatEvent", 5) :: RemoteEvent?
		if combatEvent then
			combatEvent.OnClientEvent:Connect(function(action: string, data: any)
				if typeof(data) ~= "table" or not data.Target then return end

				if action == "HitConfirm" then
					local dmg = data.Damage or 0
					if data.Blocked then
						DamagePopup.Blocked(data.Target, dmg)
					elseif data.Knockback or (data.Step and data.Step >= 4) then
						DamagePopup.Crit(data.Target, dmg)
					else
						DamagePopup.Normal(data.Target, dmg)
					end
				elseif action == "WallSplat" then
					local dmg = data.Damage or 10
					DamagePopup.WallSplat(data.Target, dmg)
				end
			end)
		end

		local blockEvent = remotes:WaitForChild("BlockEvent", 5) :: RemoteEvent?
		if blockEvent then
			blockEvent.OnClientEvent:Connect(function(targetChar: Model, isBlocking: boolean, guardBroken: boolean)
				if guardBroken and targetChar then
					DamagePopup.GuardBreak(targetChar)
				end
			end)
		end
	end)
end

return DamagePopup
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">GokuChoreography</string>
          <string name="Source"><![CDATA[--!strict
-- Original R15 choreography. Angles are degrees; every key is a full-body pose.
type Pose = { [string]: CFrame }
type Frame = { Pose: Pose, Duration: number, EasingStyle: Enum.EasingStyle?, EasingDirection: Enum.EasingDirection? }
type Sequence = { Loop: boolean, Keyframes: { Frame } }
local sequences: { [string]: Sequence } = {}
local function a(x: number, y: number?, z: number?): CFrame
	return CFrame.Angles(math.rad(x), math.rad(y or 0), math.rad(z or 0))
end
local guard: Pose = {
	Root = CFrame.new(0, -0.16, 0), Waist = a(5, -12), Neck = a(-3, 10),
	RightShoulder = a(38, -12, 18), RightElbow = a(88), RightWrist = a(0, 0, -8),
	LeftShoulder = a(55, 10, -20), LeftElbow = a(95), LeftWrist = a(0, 0, 8),
	RightHip = a(-12, 8, 7), RightKnee = a(-18), RightAnkle = a(10),
	LeftHip = a(14, -8, -7), LeftKnee = a(-12), LeftAnkle = a(4),
}
local function f(duration: number, changes: Pose, sharp: boolean?): Frame
	local pose = table.clone(guard)
	for name, transform in changes do pose[name] = transform end
	return { Pose = pose, Duration = duration,
		EasingStyle = if sharp then Enum.EasingStyle.Quart else Enum.EasingStyle.Sine,
		EasingDirection = if sharp then Enum.EasingDirection.Out else Enum.EasingDirection.InOut }
end
local function add(name: string, frames: { Frame }, loop: boolean?)
	sequences[name] = { Loop = loop or false, Keyframes = frames }
end
local function punch(right: boolean, power: number): Pose
	local side = if right then "Right" else "Left"
	local sign = if right then -1 else 1
	return {
		Root = CFrame.new(0, -0.2, -0.12 * power), Waist = a(9, sign * 24 * power, sign * 4), Neck = a(-5, -sign * 16),
		[side .. "Shoulder"] = a(94, sign * 6, sign * 9), [side .. "Elbow"] = a(8), [side .. "Wrist"] = a(0, sign * 12),
		RightHip = a(if right then 8 else -15, 5, 7), LeftHip = a(if right then -15 else 8, -5, -7),
	}
end
for step = 1, 4 do
	local right = step % 2 == 1
	local frames = { f(0.055, { Waist = a(-4, if right then 18 else -18) }), f(0.065, punch(right, if step == 4 then 1.4 else 1), true) }
	if step == 3 then
		frames[2] = f(0.075, { Waist = a(-12, -28), RightShoulder = a(112, 5, -20), RightElbow = a(62), Root = CFrame.new(0, 0.12, -0.1) }, true)
	end
	table.insert(frames, f(0.07, frames[2].Pose))
	table.insert(frames, f(0.13, {}))
	add("M1_" .. step, frames)
end
local function barrage(name: string, count: number, interval: number)
	local frames: { Frame } = {}
	for i = 1, count do
		table.insert(frames, f(interval * 0.58, punch(i % 2 == 1, 0.8), true))
		table.insert(frames, f(interval * 0.42, { Waist = a(4, if i % 2 == 1 then -8 else 8) }))
	end
	table.insert(frames, f(0.065, punch(true, 1.5), true))
	table.insert(frames, f(0.12, punch(true, 1.3)))
	table.insert(frames, f(0.14, {}))
	add(name, frames)
end
barrage("RushAttack", 12, 0.10)
barrage("OmnidirectionalPunches", 20, 0.075)
-- Cup both hands at the right hip, coil, and release on the server damage beat.
local charge: Pose = {
	Root = CFrame.new(0, -0.32, 0.12), Waist = a(5, 36, -5), Neck = a(-3, -30),
	RightShoulder = a(-41.4, -11.2, -24.1), RightElbow = a(130.7), RightWrist = a(-15, -25, -22),
	LeftShoulder = a(-1.3, -2.0, 79.0), LeftElbow = a(32.9), LeftWrist = a(15, 35, 28),
	RightHip = a(-20, 18, 12), RightKnee = a(-30), RightAnkle = a(12),
	LeftHip = a(22, -15, -12), LeftKnee = a(-20), LeftAnkle = a(8),
}
local release: Pose = {
	Root = CFrame.new(0, -0.25, 0.18), Waist = a(12, -8), Neck = a(-9, 6),
	RightShoulder = a(76.9, 13.1, -29.2), RightElbow = a(9.6), RightWrist = a(0, -12, -12),
	LeftShoulder = a(67.6, 1.2, 25.4), LeftElbow = a(17.4), LeftWrist = a(0, 12, 12),
	RightHip = a(-24, 10, 10), RightKnee = a(-30), LeftHip = a(22, -10, -10),
}
local function beam(name: string, windup: number)
	add(name, { f(0.16, charge), f(windup - 0.22, charge), f(0.06, release, true),
		f(0.08, release),
		f(0.25, release), f(0.18, {}) })
end
beam("Kamehameha", 0.50)
beam("SuperKamehameha", 0.55)
local function slam(name: string, windup: number)
	add(name, {
		f(0.10, { Root = CFrame.new(0, -0.45, 0), Waist = a(18), RightHip = a(30, 0, 10), LeftHip = a(30, 0, -10), RightKnee = a(-55), LeftKnee = a(-55) }),
		f(windup - 0.16, { Root = CFrame.new(0, 0.1, 0), Waist = a(-15), RightShoulder = a(155, 0, 12), LeftShoulder = a(155, 0, -12), RightElbow = a(35), LeftElbow = a(35) }),
		f(0.06, { Root = CFrame.new(0, -0.6, -0.1), Waist = a(44), Neck = a(-20), RightShoulder = a(32, 0, -10), LeftShoulder = a(32, 0, 10), RightElbow = a(15), LeftElbow = a(15), RightHip = a(34), LeftHip = a(34), RightKnee = a(-65), LeftKnee = a(-65) }, true),
		f(0.15, { Root = CFrame.new(0, -0.4, 0), Waist = a(24), RightKnee = a(-30), LeftKnee = a(-30) }), f(0.27, {}),
	})
end
slam("GroundSlam", 0.30)
slam("CataclysmicSlam", 0.40)
local teleport: Pose = { RightShoulder = a(96.9, 22.5, -72.2), RightElbow = a(130.4), RightWrist = a(0, -30, -10), Waist = a(0, 18), Neck = a(0, -15) }
add("InstantTransmission", { f(0.12, teleport), f(0.66, teleport), f(0.08, {}) })
add("SpiritBomb", {
	f(0.16, { Waist = a(-10), Neck = a(-20), RightShoulder = a(130, 0, 22), LeftShoulder = a(130, 0, -22), RightElbow = a(15), LeftElbow = a(15) }),
	f(0.33, { Root = CFrame.new(0, 0.15, 0), Waist = a(-12), Neck = a(-24), RightShoulder = a(172, 0, 15), LeftShoulder = a(172, 0, -15), RightElbow = a(8), LeftElbow = a(8) }),
	f(0.06, { Waist = a(28), Neck = a(-10), RightShoulder = a(82, 0, -8), LeftShoulder = a(82, 0, 8), RightElbow = a(8), LeftElbow = a(8), Root = CFrame.new(0, -0.2, -0.2) }, true),
	f(0.30, { Waist = a(18), RightShoulder = a(75), LeftShoulder = a(75), RightElbow = a(12), LeftElbow = a(12) }), f(0.22, {}),
})
add("CounterPunish", { f(0.05, { Waist = a(-6, 28) }), f(0.07, punch(true, 1.5), true), f(0.10, punch(true, 1.2)), f(0.15, {}) })
add("FlashDash", { f(0.06, { Waist = a(25), Neck = a(-20), RightShoulder = a(-35), LeftShoulder = a(-35), RightHip = a(35), LeftHip = a(-25) }), f(0.14, { Waist = a(20), Neck = a(-15), RightShoulder = a(-30), LeftShoulder = a(-30) }), f(0.12, {}) })
add("AwakeningTransform", {
	f(0.4, { Root = CFrame.new(0, -0.5, 0), Waist = a(18), Neck = a(20), RightShoulder = a(10, 0, 30), LeftShoulder = a(10, 0, -30), RightElbow = a(100), LeftElbow = a(100), RightKnee = a(-35), LeftKnee = a(-35) }),
	f(0.3, { Root = CFrame.new(0, -0.4, 0), Waist = a(12), RightShoulder = a(8, 0, 35), LeftShoulder = a(8, 0, -35), RightElbow = a(105), LeftElbow = a(105) }),
	f(0.10, { Waist = a(-12), Neck = a(-26), RightShoulder = a(0, 0, 48), LeftShoulder = a(0, 0, -48), RightElbow = a(35), LeftElbow = a(35) }, true),
	f(0.85, { Waist = a(-8), Neck = a(-18), RightShoulder = a(0, 0, 42), LeftShoulder = a(0, 0, -42), RightElbow = a(30), LeftElbow = a(30) }), f(0.35, {}),
})
local block: Pose = { RightShoulder = a(72, -20, 22), LeftShoulder = a(72, 20, -22), RightElbow = a(115), LeftElbow = a(115), Neck = a(8) }
add("Block", { f(0.10, block), f(0.8, block) }, true)
add("Hitstun", { f(0.05, { Waist = a(-18, 8), Neck = a(-12), RightShoulder = a(-12, 0, 30), LeftShoulder = a(-12, 0, -30) }, true), f(0.17, {}) })
sequences.HeavyPunch = sequences.Kamehameha
sequences.SeriousPunch = sequences.SuperKamehameha
sequences.CounterStance = sequences.InstantTransmission
sequences.GodspeedCounter = sequences.SpiritBomb
sequences.ConsecutivePunches = sequences.RushAttack
return sequences
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">MovesetData</string>
          <string name="Source"><![CDATA[--!strict
-- MovesetData.luau
-- Authoritative configuration for R15 Saitama-like Martial Arts character moveset:
-- 4 Core Skills (Rush Attack, Heavy Punch, Ground Slam, Counter/Flash Dash)
-- Awakening Transformation (Key G, Serious Mode, Omnidirectional Punches, Serious Punch)

export type SkillConfig = {
	Id: number,
	Name: string,
	KeyName: string,
	Description: string,
	Cooldown: number,
	Damage: number,
	Duration: number,
	WindupTime: number,
	HitboxSize: Vector3,
	HitboxOffset: Vector3,
	KnockbackForce: number,
	KnockbackLift: number,
	GuardBreak: boolean,
	CausesKnockdown: boolean,
	CausesHitstun: boolean,
	HitstunDuration: number,
	AnimationName: string,
	SoundId: string?,
	VFXType: string,
	HitCount: number?,
	HitInterval: number?,
	FinisherDamage: number?,
	FinisherKnockback: number?,
	FinisherLift: number?,
	AoeRadius: number?,
	CounterWindow: number?,
	CounterPunishDamage: number?,
	FlashDashDistance: number?,
	FlashDashDuration: number?,
	DestroysEnvironment: boolean?,
}

export type AwakeningConfig = {
	Name: string,
	KeyName: string,
	Description: string,
	RequiredRageMeter: number,
	TransformationDuration: number,
	Duration: number,
	WalkSpeedBuff: number,
	CooldownReduction: number, -- fraction, e.g. 0.30 = 30% reduction
	DamageMultiplier: number, -- e.g. 1.5x
	AnimationName: string,
	AuraColor: Color3,
}

local MovesetData = {}

-- Awakening Transformation settings (Super Saiyan / Serious Mode)
MovesetData.AwakeningConfig = {
	Name = "Super Saiyan / Serious Mode",
	KeyName = "G",
	Description = "Reach 100% Rage to awaken Goku's Super Saiyan power. Grants 24 WalkSpeed, 30% CDR, 1.5x damage, and evolves skills into Super Saiyan God / Serious moves.",
	RequiredRageMeter = 100,
	TransformationDuration = 2.0, -- Cinematic power-up lock
	Duration = 30.0, -- Active duration in seconds
	WalkSpeedBuff = 24.0, -- Normal is 16.0
	CooldownReduction = 0.30, -- 30% CDR
	DamageMultiplier = 1.50, -- 1.5x damage
	AnimationName = "AwakeningTransform",
	AuraColor = Color3.fromRGB(255, 215, 30),
} :: AwakeningConfig

-- Base 4 Skills (Goku Base Mode: Rush Attack, Kamehameha, Kaioken, Instant Transmission)
MovesetData.BaseSkills = {
	[1] = {
		Id = 1,
		Name = "Rush Attack (Consecutive Punches)",
		KeyName = "Z",
		Description = "Goku unleashes a rapid martial arts punch barrage (Đấm liên hoàn), trapping the target in continuous hitstun with forward momentum before blasting them back with a finisher strike.",
		Cooldown = 10.0,
		Damage = 2.5, -- per tick
		Duration = 1.5,
		WindupTime = 0.12,
		HitboxSize = Vector3.new(6.0, 6.0, 7.0),
		HitboxOffset = Vector3.new(0, 0, -3.8),
		KnockbackForce = 0, -- intermediate hits do not knock away
		KnockbackLift = 0,
		GuardBreak = false,
		CausesKnockdown = false,
		CausesHitstun = true,
		HitstunDuration = 0.35,
		AnimationName = "RushAttack",
		SoundId = "rbxassetid://0",
		VFXType = "GokuRushFlurry",
		HitCount = 12,
		HitInterval = 0.10,
		FinisherDamage = 10.0,
		FinisherKnockback = 45.0,
		FinisherLift = 6.0,
		DestroysEnvironment = false,
	} :: SkillConfig,

	[2] = {
		Id = 2,
		Name = "Kamehameha (Heavy Punch)",
		KeyName = "X",
		Description = "Goku takes a charging stance at hip gathering radiant blue Ki energy, then releases a colossal Kamehameha beam blast (Heavy Punch) that shatters obstacles, breaks enemy guard (Guard Break), and deals multi-hit damage with heavy knockback.",
		Cooldown = 14.0,
		Damage = 40.0,
		Duration = 1.2,
		WindupTime = 0.50,
		HitboxSize = Vector3.new(12.0, 10.0, 48.0),
		HitboxOffset = Vector3.new(0, 0, -24.0),
		KnockbackForce = 90.0,
		KnockbackLift = 15.0,
		GuardBreak = true,
		CausesKnockdown = true,
		CausesHitstun = true,
		HitstunDuration = 1.8,
		AnimationName = "Kamehameha",
		SoundId = "rbxassetid://0",
		VFXType = "KamehamehaBeam",
		DestroysEnvironment = true,
	} :: SkillConfig,

	[3] = {
		Id = 3,
		Name = "Kaioken / Ground Slam",
		KeyName = "C",
		Description = "Goku bursts into a crimson Kaioken aura, boosting speed and unleashing a rapid succession of martial arts strikes ending with an earth-shattering Ground Slam that launches enemies airborne and fractures obstacles.",
		Cooldown = 16.0,
		Damage = 32.0,
		Duration = 1.0,
		WindupTime = 0.30, -- jump ascent
		HitboxSize = Vector3.new(36.0, 12.0, 36.0),
		HitboxOffset = Vector3.new(0, -1.0, 0),
		KnockbackForce = 30.0,
		KnockbackLift = 65.0, -- Upward knockup
		GuardBreak = false,
		CausesKnockdown = true,
		CausesHitstun = true,
		HitstunDuration = 1.3,
		AnimationName = "GroundSlam",
		SoundId = "rbxassetid://0",
		VFXType = "KaiokenSlamCrater",
		AoeRadius = 18.0,
		DestroysEnvironment = true,
	} :: SkillConfig,

	[4] = {
		Id = 4,
		Name = "Instant Transmission (Counter / Flash Dash)",
		KeyName = "V",
		Description = "Goku places two fingers to his forehead and vanishes in a blue Ki flash, instantly teleporting behind the target (Counter / Flash Dash) to strike with a crushing heavy blow, or dashing forward at godspeed.",
		Cooldown = 18.0,
		Damage = 35.0,
		Duration = 0.8,
		WindupTime = 0.15,
		HitboxSize = Vector3.new(8.0, 8.0, 8.0),
		HitboxOffset = Vector3.new(0, 0, -3.5),
		KnockbackForce = 65.0,
		KnockbackLift = 12.0,
		GuardBreak = true,
		CausesKnockdown = true,
		CausesHitstun = true,
		HitstunDuration = 1.4,
		AnimationName = "InstantTransmission",
		SoundId = "rbxassetid://0",
		VFXType = "InstantTransmissionFlash",
		CounterWindow = 0.8,
		CounterPunishDamage = 35.0,
		FlashDashDistance = 35.0,
		FlashDashDuration = 0.20,
		DestroysEnvironment = true,
	} :: SkillConfig,
}

-- Awakened Upgraded Skills (Super Saiyan Mode: Super Rush Attack, Super Kamehameha, Kaioken x20, Spirit Bomb)
MovesetData.AwakenedSkills = {
	[1] = {
		Id = 1,
		Name = "Super Rush Attack (Omnidirectional Punches)",
		KeyName = "Z",
		Description = "Move at supersonic speed generating golden Ki afterimages around the foe, striking 20 rapid times before an explosive double-fist finish.",
		Cooldown = 12.0,
		Damage = 3.0,
		Duration = 1.7,
		WindupTime = 0.10,
		HitboxSize = Vector3.new(8.0, 7.0, 8.0),
		HitboxOffset = Vector3.new(0, 0, -4.5),
		KnockbackForce = 0,
		KnockbackLift = 0,
		GuardBreak = false,
		CausesKnockdown = true,
		CausesHitstun = true,
		HitstunDuration = 0.35,
		AnimationName = "OmnidirectionalPunches",
		SoundId = "rbxassetid://0",
		VFXType = "OmniPunchAfterimages",
		HitCount = 20,
		HitInterval = 0.075,
		FinisherDamage = 20.0,
		FinisherKnockback = 75.0,
		FinisherLift = 15.0,
		DestroysEnvironment = true,
	} :: SkillConfig,

	[2] = {
		Id = 2,
		Name = "Super Kamehameha (Serious Punch)",
		KeyName = "X",
		Description = "Execute the legendary Super Kamehameha (Serious Punch). Unleashes a massive golden-blue Ki beam across a 50-stud corridor, pulverizing barriers and dealing 80 damage with colossal knockback.",
		Cooldown = 18.0,
		Damage = 80.0,
		Duration = 1.2,
		WindupTime = 0.55,
		HitboxSize = Vector3.new(16.0, 12.0, 50.0),
		HitboxOffset = Vector3.new(0, 0, -25.0),
		KnockbackForce = 130.0,
		KnockbackLift = 25.0,
		GuardBreak = true,
		CausesKnockdown = true,
		CausesHitstun = true,
		HitstunDuration = 2.2,
		AnimationName = "SuperKamehameha",
		SoundId = "rbxassetid://0",
		VFXType = "SuperKamehamehaShockwave",
		DestroysEnvironment = true,
	} :: SkillConfig,

	[3] = {
		Id = 3,
		Name = "Kaioken x20 (Cataclysmic Slam)",
		KeyName = "C",
		Description = "Burst into the blazing crimson aura of Kaioken x20 (Cataclysmic Slam) and plummet with earth-shattering power, shattering a 28-stud radius and ejecting all targets high into the air.",
		Cooldown = 18.0,
		Damage = 48.0,
		Duration = 1.0,
		WindupTime = 0.40,
		HitboxSize = Vector3.new(56.0, 16.0, 56.0),
		HitboxOffset = Vector3.new(0, -1.0, 0),
		KnockbackForce = 45.0,
		KnockbackLift = 85.0,
		GuardBreak = false,
		CausesKnockdown = true,
		CausesHitstun = true,
		HitstunDuration = 1.5,
		AnimationName = "CataclysmicSlam",
		SoundId = "rbxassetid://0",
		VFXType = "KaiokenCataclysmicCrater",
		AoeRadius = 28.0,
		DestroysEnvironment = true,
	} :: SkillConfig,

	[4] = {
		Id = 4,
		Name = "Spirit Bomb (Godspeed Counter)",
		KeyName = "V",
		Description = "Goku leaps high into the air gathering a colossal Spirit Bomb above head, hurling the giant energy sphere forward for a catastrophic 30-stud AOE explosion (Spirit Bomb / Godspeed Counter).",
		Cooldown = 20.0,
		Damage = 50.0,
		Duration = 1.2,
		WindupTime = 0.35,
		HitboxSize = Vector3.new(10.0, 10.0, 10.0),
		HitboxOffset = Vector3.new(0, 0, -4.0),
		KnockbackForce = 75.0,
		KnockbackLift = 20.0,
		GuardBreak = true,
		CausesKnockdown = true,
		CausesHitstun = true,
		HitstunDuration = 1.8,
		AnimationName = "SpiritBomb",
		SoundId = "rbxassetid://0",
		VFXType = "SpiritBombExplosion",
		CounterWindow = 1.0,
		CounterPunishDamage = 50.0,
		FlashDashDistance = 50.0,
		FlashDashDuration = 0.20,
		DestroysEnvironment = true,
	} :: SkillConfig,
}

-- Returns skill configuration according to slot ID and awakening state
function MovesetData.GetSkill(skillId: number, isAwakened: boolean?): SkillConfig?
	if isAwakened then
		local awakened = MovesetData.AwakenedSkills[skillId]
		if awakened then
			return awakened
		end
	end
	return MovesetData.BaseSkills[skillId]
end

-- Returns the effective cooldown for a skill, applying awakening CDR if active
function MovesetData.GetCooldown(skillId: number, isAwakened: boolean?): number
	local skill = MovesetData.GetSkill(skillId, isAwakened)
	if not skill then
		return 0
	end
	if isAwakened then
		return skill.Cooldown * (1 - MovesetData.AwakeningConfig.CooldownReduction)
	end
	return skill.Cooldown
end

-- Returns the effective damage for a skill, applying awakening damage multiplier if active
function MovesetData.GetDamage(skillId: number, isAwakened: boolean?): number
	local skill = MovesetData.GetSkill(skillId, isAwakened)
	if not skill then
		return 0
	end
	if isAwakened then
		return skill.Damage * MovesetData.AwakeningConfig.DamageMultiplier
	end
	return skill.Damage
end

-- Returns all skills table for UI / HUD or enumeration
function MovesetData.GetAllSkills(isAwakened: boolean?): { [number]: SkillConfig }
	if isAwakened then
		return MovesetData.AwakenedSkills
	end
	return MovesetData.BaseSkills
end

-- Returns the awakening configuration
function MovesetData.GetAwakeningConfig(): AwakeningConfig
	return MovesetData.AwakeningConfig
end

return MovesetData
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">RagdollHelper</string>
          <string name="Source"><![CDATA[--!strict
-- RagdollHelper.luau
-- Shared R15 Ragdoll physics management module for Core Combat & Physics
-- Configures BallSocketConstraints, joint limits, NoCollisionConstraints, and state transitions.

local Workspace = game:GetService("Workspace")

export type JointLimit = {
	UpperAngle: number,
	TwistLowerAngle: number,
	TwistUpperAngle: number,
}

local JointLimits: { [string]: JointLimit } = {
	["Neck"] = { UpperAngle = 45, TwistLowerAngle = -40, TwistUpperAngle = 40 },
	["Waist"] = { UpperAngle = 40, TwistLowerAngle = -35, TwistUpperAngle = 35 },
	["Root"] = { UpperAngle = 25, TwistLowerAngle = -20, TwistUpperAngle = 20 },
	["LeftShoulder"] = { UpperAngle = 85, TwistLowerAngle = -60, TwistUpperAngle = 60 },
	["RightShoulder"] = { UpperAngle = 85, TwistLowerAngle = -60, TwistUpperAngle = 60 },
	["LeftElbow"] = { UpperAngle = 90, TwistLowerAngle = -10, TwistUpperAngle = 10 },
	["RightElbow"] = { UpperAngle = 90, TwistLowerAngle = -10, TwistUpperAngle = 10 },
	["LeftWrist"] = { UpperAngle = 30, TwistLowerAngle = -25, TwistUpperAngle = 25 },
	["RightWrist"] = { UpperAngle = 30, TwistLowerAngle = -25, TwistUpperAngle = 25 },
	["LeftHip"] = { UpperAngle = 65, TwistLowerAngle = -35, TwistUpperAngle = 35 },
	["RightHip"] = { UpperAngle = 65, TwistLowerAngle = -35, TwistUpperAngle = 35 },
	["LeftKnee"] = { UpperAngle = 80, TwistLowerAngle = -10, TwistUpperAngle = 10 },
	["RightKnee"] = { UpperAngle = 80, TwistLowerAngle = -10, TwistUpperAngle = 10 },
	["LeftAnkle"] = { UpperAngle = 35, TwistLowerAngle = -20, TwistUpperAngle = 20 },
	["RightAnkle"] = { UpperAngle = 35, TwistLowerAngle = -20, TwistUpperAngle = 20 },
}

local RagdollHelper = {}

-- Sets up BallSocketConstraints and NoCollisionConstraints for an R15 character rig.
function RagdollHelper.SetupRig(character: Model)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.RigType ~= Enum.HumanoidRigType.R15 then
		return
	end

	local ragdollFolder = character:FindFirstChild("RagdollConstraints")
	if ragdollFolder then
		return -- Rig already configured
	end

	ragdollFolder = Instance.new("Folder")
	ragdollFolder.Name = "RagdollConstraints"
	ragdollFolder.Parent = character

	for _, descendant in character:GetDescendants() do
		if descendant:IsA("Motor6D") and descendant.Name ~= "Root" then
			local motor = descendant
			local part0 = motor.Part0
			local part1 = motor.Part1

			if part0 and part1 then
				-- Attachment 0 on Part0 matching Motor6D.C0
				local att0 = Instance.new("Attachment")
				att0.Name = "RagdollAtt0_" .. motor.Name
				att0.CFrame = motor.C0
				att0.Parent = part0

				-- Attachment 1 on Part1 matching Motor6D.C1
				local att1 = Instance.new("Attachment")
				att1.Name = "RagdollAtt1_" .. motor.Name
				att1.CFrame = motor.C1
				att1.Parent = part1

				-- BallSocketConstraint
				local socket = Instance.new("BallSocketConstraint")
				socket.Name = "Socket_" .. motor.Name
				socket.Attachment0 = att0
				socket.Attachment1 = att1
				socket.LimitsEnabled = true
				socket.TwistLimitsEnabled = true

				local limits = JointLimits[motor.Name] or { UpperAngle = 50, TwistLowerAngle = -30, TwistUpperAngle = 30 }
				socket.UpperAngle = limits.UpperAngle
				socket.TwistLowerAngle = limits.TwistLowerAngle
				socket.TwistUpperAngle = limits.TwistUpperAngle
				socket.Restitution = 0.05
				socket.Enabled = false
				socket.Parent = ragdollFolder

				-- NoCollisionConstraint between adjacent parts
				local noCollision = Instance.new("NoCollisionConstraint")
				noCollision.Name = "NoCollision_" .. part0.Name .. "_" .. part1.Name
				noCollision.Part0 = part0
				noCollision.Part1 = part1
				noCollision.Parent = ragdollFolder
			end
		end
	end
end

-- Checks if a character is currently in a ragdoll state
function RagdollHelper.IsRagdolled(character: Model): boolean
	return character:GetAttribute("IsRagdolled") == true
end

-- Activates ragdoll state on character
function RagdollHelper.Ragdoll(character: Model)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local hrp = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not humanoid or humanoid.Health <= 0 then
		return
	end

	RagdollHelper.SetupRig(character)

	character:SetAttribute("IsRagdolled", true)
	character:SetAttribute("RagdollStartTime", os.clock())

	-- Humanoid state suppression to prevent standing up / walking animations
	humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, false)
	humanoid.AutoRotate = false
	humanoid.PlatformStand = true
	humanoid:ChangeState(Enum.HumanoidStateType.Physics)

	-- Disable Motor6Ds except Root
	for _, descendant in character:GetDescendants() do
		if descendant:IsA("Motor6D") and descendant.Name ~= "Root" then
			descendant.Enabled = false
		end
	end

	-- Enable BallSocketConstraints
	local ragdollFolder = character:FindFirstChild("RagdollConstraints")
	if ragdollFolder then
		for _, descendant in ragdollFolder:GetChildren() do
			if descendant:IsA("BallSocketConstraint") then
				descendant.Enabled = true
			end
		end
	end

	-- Adjust collision masks
	if hrp then
		hrp.CanCollide = false
	end

	local collidableParts = {
		"Head", "UpperTorso", "LowerTorso",
		"LeftUpperArm", "LeftLowerArm", "LeftHand",
		"RightUpperArm", "RightLowerArm", "RightHand",
		"LeftUpperLeg", "LeftLowerLeg", "LeftFoot",
		"RightUpperLeg", "RightLowerLeg", "RightFoot",
	}

	for _, partName in collidableParts do
		local part = character:FindFirstChild(partName)
		if part and part:IsA("BasePart") then
			part.CanCollide = true
		end
	end
end

-- Deactivates ragdoll state and restores normal character posture
function RagdollHelper.Unragdoll(character: Model)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local hrp = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local lowerTorso = character:FindFirstChild("LowerTorso") :: BasePart?
	if not humanoid then
		return
	end

	-- Disable BallSocketConstraints
	local ragdollFolder = character:FindFirstChild("RagdollConstraints")
	if ragdollFolder then
		for _, descendant in ragdollFolder:GetChildren() do
			if descendant:IsA("BallSocketConstraint") then
				descendant.Enabled = false
			end
		end
	end

	-- Re-enable Motor6Ds
	for _, descendant in character:GetDescendants() do
		if descendant:IsA("Motor6D") then
			descendant.Enabled = true
		end
	end

	-- Reposition HumanoidRootPart upright over LowerTorso to avoid clipping into ground
	if hrp and lowerTorso then
		local groundRay = RagdollHelper.RaycastGround(character, 5)
		local groundY = lowerTorso.Position.Y + 2.0
		if groundRay then
			groundY = groundRay.Position.Y + 3.0
		end
		local currentLook = lowerTorso.CFrame.LookVector
		local flatLook = Vector3.new(currentLook.X, 0, currentLook.Z)
		if flatLook.Magnitude < 0.1 then
			flatLook = hrp.CFrame.LookVector
		else
			flatLook = flatLook.Unit
		end

		hrp.CFrame = CFrame.lookAt(Vector3.new(lowerTorso.Position.X, groundY, lowerTorso.Position.Z), Vector3.new(lowerTorso.Position.X + flatLook.X, groundY, lowerTorso.Position.Z + flatLook.Z))
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
		hrp.CanCollide = true
	end

	-- Restore Humanoid state
	humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
	humanoid.PlatformStand = false
	humanoid.AutoRotate = true
	humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)

	character:SetAttribute("IsRagdolled", false)
end

-- Raycasts down to check ground contact for recovery
function RagdollHelper.RaycastGround(character: Model, distance: number?): RaycastResult?
	local checkDist = distance or 4.0
	local refPart = character:FindFirstChild("LowerTorso") or character:FindFirstChild("HumanoidRootPart")
	if not refPart or not refPart:IsA("BasePart") then
		return nil
	end

	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	raycastParams.FilterDescendantsInstances = { character }
	raycastParams.IgnoreWater = true

	local origin = refPart.Position
	local direction = Vector3.new(0, -checkDist, 0)

	return Workspace:Raycast(origin, direction, raycastParams)
end

-- Checks if character is grounded
function RagdollHelper.IsGrounded(character: Model): boolean
	local hit = RagdollHelper.RaycastGround(character, 3.8)
	return hit ~= nil
end

return RagdollHelper
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">ScreenShake</string>
          <string name="Source"><![CDATA[--!strict
-- ScreenShake.luau
-- Shared module exposing camera screen shake triggers and presets for combat events,
-- heavy hits, awakening transformations, and explosions.

export type ShakeOptions = {
	Intensity: number?,
	Duration: number?,
	Frequency: number?,
	RotationalRatio: number?, -- ratio of rotational shake vs translational shake
	TraumaExponent: number?, -- non-linear power curve for decay (default 2)
	FadeInTime: number?,
	FadeOutTime: number?,
}

local RunService = game:GetService("RunService")
local isClient = RunService:IsClient()

local ScreenShake = {}

-- Handler registered by CameraController on the client
local activeHandler: ((intensity: number, duration: number, frequency: number, options: ShakeOptions?) -> ())? = nil
local pendingQueue: { { intensity: number, duration: number, frequency: number, options: ShakeOptions? } } = {}

-- Preset configurations
local PRESETS = {
	Light = {
		Intensity = 0.35,
		Duration = 0.15,
		Frequency = 30,
		RotationalRatio = 0.6,
		TraumaExponent = 2.0,
	},
	Medium = {
		Intensity = 0.75,
		Duration = 0.25,
		Frequency = 32,
		RotationalRatio = 0.8,
		TraumaExponent = 2.0,
	},
	Heavy = {
		Intensity = 1.85,
		Duration = 0.45,
		Frequency = 26,
		RotationalRatio = 1.1,
		TraumaExponent = 2.2,
	},
	Explosion = {
		Intensity = 2.40,
		Duration = 0.60,
		Frequency = 22,
		RotationalRatio = 1.3,
		TraumaExponent = 2.5,
	},
	Awakening = {
		Intensity = 2.80,
		Duration = 1.60,
		Frequency = 18,
		RotationalRatio = 1.4,
		TraumaExponent = 1.8,
	},
	WallSplat = {
		Intensity = 1.60,
		Duration = 0.35,
		Frequency = 28,
		RotationalRatio = 1.0,
		TraumaExponent = 2.0,
	},
	GuardBreak = {
		Intensity = 2.00,
		Duration = 0.50,
		Frequency = 24,
		RotationalRatio = 1.2,
		TraumaExponent = 2.0,
	},
}

-- Register the active camera shake handler (typically CameraController.client)
function ScreenShake.SetHandler(handler: (intensity: number, duration: number, frequency: number, options: ShakeOptions?) -> ())
	activeHandler = handler
	-- Flush any early queued shakes
	if #pendingQueue > 0 then
		for _, queued in pendingQueue do
			task.spawn(handler, queued.intensity, queued.duration, queued.frequency, queued.options)
		end
		table.clear(pendingQueue)
	end
end

-- Primary shake trigger function
function ScreenShake.Shake(intensity: number?, duration: number?, frequency: number?, options: ShakeOptions?)
	if not isClient then
		return
	end

	local finalIntensity = intensity or 1.0
	local finalDuration = duration or 0.3
	local finalFrequency = frequency or 25

	if activeHandler then
		activeHandler(finalIntensity, finalDuration, finalFrequency, options)
	else
		-- Queue until CameraController registers
		if #pendingQueue < 20 then
			table.insert(pendingQueue, {
				intensity = finalIntensity,
				duration = finalDuration,
				frequency = finalFrequency,
				options = options,
			})
		end
	end
end

-- Triggers screen shake with falloff based on distance from local camera
function ScreenShake.ShakeAtPosition(origin: Vector3, maxDistance: number?, intensity: number?, duration: number?, frequency: number?, options: ShakeOptions?)
	if not isClient then
		return
	end

	local camera = workspace.CurrentCamera
	if not camera then
		return
	end

	local maxDist = maxDistance or 120
	local dist = (camera.CFrame.Position - origin).Magnitude
	if dist > maxDist then
		return
	end

	-- Smooth quadratic falloff curve
	local factor = math.clamp(1 - (dist / maxDist), 0, 1)
	local falloffIntensity = (intensity or 1.5) * (factor * factor)

	if falloffIntensity > 0.05 then
		ScreenShake.Shake(falloffIntensity, duration, frequency, options)
	end
end

-- Convenience presets
function ScreenShake.Light(customOptions: ShakeOptions?)
	local p = PRESETS.Light
	ScreenShake.Shake(p.Intensity, p.Duration, p.Frequency, customOptions or p)
end

function ScreenShake.Medium(customOptions: ShakeOptions?)
	local p = PRESETS.Medium
	ScreenShake.Shake(p.Intensity, p.Duration, p.Frequency, customOptions or p)
end

function ScreenShake.Heavy(customOptions: ShakeOptions?)
	local p = PRESETS.Heavy
	ScreenShake.Shake(p.Intensity, p.Duration, p.Frequency, customOptions or p)
end

function ScreenShake.Explosion(customOptions: ShakeOptions?)
	local p = PRESETS.Explosion
	ScreenShake.Shake(p.Intensity, p.Duration, p.Frequency, customOptions or p)
end

function ScreenShake.Awakening(customOptions: ShakeOptions?)
	local p = PRESETS.Awakening
	ScreenShake.Shake(p.Intensity, p.Duration, p.Frequency, customOptions or p)
end

function ScreenShake.WallSplat(customOptions: ShakeOptions?)
	local p = PRESETS.WallSplat
	ScreenShake.Shake(p.Intensity, p.Duration, p.Frequency, customOptions or p)
end

function ScreenShake.GuardBreak(customOptions: ShakeOptions?)
	local p = PRESETS.GuardBreak
	ScreenShake.Shake(p.Intensity, p.Duration, p.Frequency, customOptions or p)
end

return ScreenShake
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">VFXHelper</string>
          <string name="Source"><![CDATA[--!strict
-- VFXHelper.luau
-- High-performance procedural visual effects engine for Roblox Battleground Arena
-- Features: Dash trails & ghost after-images, Punch impact sparks & shockwaves,
-- Ground Slam expanding shockwave rings & debris, Awakening flaming aura bursts,
-- Wall Splat impacts, and Flash Counter teleport flashes.
-- 100% Procedural: Zero dependency on external asset IDs.

local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")

local VFXHelper = {}

-- Folder container for temporary VFX to keep Workspace clean
local function getVFXContainer(): Folder
	local folder = workspace:FindFirstChild("VFX_Container") :: Folder?
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "VFX_Container"
		folder.Parent = workspace
	end
	return folder
end

--------------------------------------------------------------------------------
-- 1. DASH TRAILS & AFTER-IMAGES
--------------------------------------------------------------------------------

-- Spawns a series of fading "ghost" after-images of the character while dashing
function VFXHelper.DashTrail(character: Model, direction: Vector3, duration: number?, color: Color3?)
	local vfxFolder = getVFXContainer()
	local trailColor = color or Color3.fromRGB(150, 220, 255)
	local dur = duration or 0.25
	local startTime = os.clock()

	task.spawn(function()
		while os.clock() - startTime < dur do
			if not character or not character.Parent then break end

			for _, part in character:GetChildren() do
				if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
					local ghost = Instance.new("Part")
					ghost.Name = "DashGhost"
					ghost.Size = part.Size
					ghost.CFrame = part.CFrame
					ghost.Color = trailColor
					ghost.Material = Enum.Material.Neon
					ghost.Transparency = 0.55
					ghost.CanCollide = false
					ghost.CanTouch = false
					ghost.CanQuery = false
					ghost.CastShadow = false
					ghost.Anchored = true
					ghost.Parent = vfxFolder

					local fadeTween = TweenService:Create(
						ghost,
						TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
						{ Transparency = 1, Size = part.Size * 0.9 }
					)
					fadeTween:Play()
					fadeTween.Completed:Connect(function()
						ghost:Destroy()
					end)
				end
			end

			-- Spawn speed line streaks along dash direction
			local hrp = character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if hrp then
				local streak = Instance.new("Part")
				streak.Name = "SpeedStreak"
				streak.Size = Vector3.new(0.2, 0.2, 5 + math.random() * 4)
				local offset = Vector3.new((math.random() - 0.5) * 4, (math.random() - 0.5) * 3, (math.random() - 0.5) * 4)
				streak.CFrame = CFrame.lookAt(hrp.Position + offset, hrp.Position + offset + direction)
				streak.Color = Color3.fromRGB(240, 250, 255)
				streak.Material = Enum.Material.Neon
				streak.Transparency = 0.4
				streak.CanCollide = false
				streak.CanTouch = false
				streak.CanQuery = false
				streak.CastShadow = false
				streak.Anchored = true
				streak.Parent = vfxFolder

				local streakTween = TweenService:Create(
					streak,
					TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
					{ Transparency = 1, Size = Vector3.new(0.05, 0.05, 8) }
				)
				streakTween:Play()
				streakTween.Completed:Connect(function()
					streak:Destroy()
				end)
			end

			task.wait(0.04)
		end
	end)
end

--------------------------------------------------------------------------------
-- 2. PUNCH IMPACT SPARKS & SHOCKWAVES
--------------------------------------------------------------------------------

function VFXHelper.PunchImpact(position: Vector3, normal: Vector3?, isCrit: boolean?)
	local vfxFolder = getVFXContainer()
	local norm = (normal or Vector3.new(0, 1, 0)).Unit
	local mainColor = if isCrit then Color3.fromRGB(255, 180, 30) else Color3.fromRGB(255, 70, 70)
	local innerColor = Color3.fromRGB(255, 255, 255)

	-- 1. Central Hit Flash Sphere
	local flash = Instance.new("Part")
	flash.Shape = Enum.PartType.Ball
	flash.Size = if isCrit then Vector3.new(3.5, 3.5, 3.5) else Vector3.new(2.2, 2.2, 2.2)
	flash.CFrame = CFrame.new(position)
	flash.Color = innerColor
	flash.Material = Enum.Material.Neon
	flash.Transparency = 0.1
	flash.CanCollide = false
	flash.CanTouch = false
	flash.CanQuery = false
	flash.CastShadow = false
	flash.Anchored = true
	flash.Parent = vfxFolder

	-- PointLight for dramatic flash
	local light = Instance.new("PointLight")
	light.Color = mainColor
	light.Range = if isCrit then 16 else 10
	light.Brightness = 8
	light.Parent = flash

	local flashTween = TweenService:Create(
		flash,
		TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = flash.Size * 1.6, Transparency = 1 }
	)
	local lightTween = TweenService:Create(
		light,
		TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ Brightness = 0 }
	)
	flashTween:Play()
	lightTween:Play()
	flashTween.Completed:Connect(function()
		flash:Destroy()
	end)

	-- 2. Expanding Hit Ring Shockwave
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.2, 1.0, 1.0)
	-- Align cylinder along normal
	ring.CFrame = CFrame.lookAt(position, position + norm) * CFrame.Angles(0, math.rad(90), 0)
	ring.Color = mainColor
	ring.Material = Enum.Material.Neon
	ring.Transparency = 0.2
	ring.CanCollide = false
	ring.CanTouch = false
	ring.CanQuery = false
	ring.CastShadow = false
	ring.Anchored = true
	ring.Parent = vfxFolder

	local targetRingRadius = if isCrit then 9.0 else 5.5
	local ringTween = TweenService:Create(
		ring,
		TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{
			Size = Vector3.new(0.05, targetRingRadius, targetRingRadius),
			Transparency = 1,
		}
	)
	ringTween:Play()
	ringTween.Completed:Connect(function()
		ring:Destroy()
	end)

	-- 3. Sharp Hit Sparks / Star Bursts
	local sparkCount = if isCrit then 8 else 5
	for i = 1, sparkCount do
		local spark = Instance.new("Part")
		spark.Size = Vector3.new(0.15, 0.15, 1.8)
		spark.Color = if i % 2 == 0 then mainColor else innerColor
		spark.Material = Enum.Material.Neon
		spark.CanCollide = false
		spark.CanTouch = false
		spark.CanQuery = false
		spark.CastShadow = false
		spark.Anchored = true

		local randomDir = (norm + Vector3.new((math.random() - 0.5) * 1.8, (math.random() - 0.5) * 1.8, (math.random() - 0.5) * 1.8)).Unit
		spark.CFrame = CFrame.lookAt(position, position + randomDir)
		spark.Parent = vfxFolder

		local targetPos = position + (randomDir * (if isCrit then 6.5 else 4.0))
		local sparkTween = TweenService:Create(
			spark,
			TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{
				CFrame = CFrame.lookAt(targetPos, targetPos + randomDir),
				Size = Vector3.new(0.05, 0.05, 0.2),
				Transparency = 1,
			}
		)
		sparkTween:Play()
		sparkTween.Completed:Connect(function()
			spark:Destroy()
		end)
	end
end

--------------------------------------------------------------------------------
-- 3. GROUND SLAM SHOCKWAVES & DEBRIS
--------------------------------------------------------------------------------

function VFXHelper.GroundSlam(position: Vector3, radius: number?)
	local vfxFolder = getVFXContainer()
	local maxRadius = radius or 18.0
	local ringColor = Color3.fromRGB(255, 140, 40) -- Bright fiery orange
	local shockwaveColor = Color3.fromRGB(255, 230, 180)

	-- 1. Primary Flat Expanding Ring (Cylinder on ground)
	local groundRing = Instance.new("Part")
	groundRing.Shape = Enum.PartType.Cylinder
	groundRing.Size = Vector3.new(0.4, 2.0, 2.0)
	groundRing.CFrame = CFrame.new(position + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.rad(90))
	groundRing.Color = ringColor
	groundRing.Material = Enum.Material.Neon
	groundRing.Transparency = 0.1
	groundRing.CanCollide = false
	groundRing.CanTouch = false
	groundRing.CanQuery = false
	groundRing.CastShadow = false
	groundRing.Anchored = true
	groundRing.Parent = vfxFolder

	local ringTween = TweenService:Create(
		groundRing,
		TweenInfo.new(0.42, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{
			Size = Vector3.new(0.1, maxRadius * 2, maxRadius * 2),
			Transparency = 1,
		}
	)
	ringTween:Play()
	ringTween.Completed:Connect(function()
		groundRing:Destroy()
	end)

	-- 2. Secondary Expanding Dome Shockwave
	local dome = Instance.new("Part")
	dome.Shape = Enum.PartType.Ball
	dome.Size = Vector3.new(3, 3, 3)
	dome.CFrame = CFrame.new(position + Vector3.new(0, 1, 0))
	dome.Color = shockwaveColor
	dome.Material = Enum.Material.Neon
	dome.Transparency = 0.25
	dome.CanCollide = false
	dome.CanTouch = false
	dome.CanQuery = false
	dome.CastShadow = false
	dome.Anchored = true
	dome.Parent = vfxFolder

	local domeTween = TweenService:Create(
		dome,
		TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{
			Size = Vector3.new(maxRadius * 1.5, maxRadius * 1.2, maxRadius * 1.5),
			Transparency = 1,
		}
	)
	domeTween:Play()
	domeTween.Completed:Connect(function()
		dome:Destroy()
	end)

	-- 3. Flying Debris Rock Chunks
	local debrisCount = 14
	for i = 1, debrisCount do
		local angle = (i / debrisCount) * math.pi * 2 + (math.random() * 0.4)
		local dir = Vector3.new(math.cos(angle), 0, math.sin(angle)).Unit
		local rock = Instance.new("Part")
		local s = 0.8 + math.random() * 1.4
		rock.Size = Vector3.new(s, s * 0.8, s)
		rock.Color = Color3.fromRGB(110 + math.random(0, 30), 105 + math.random(0, 20), 100)
		rock.Material = Enum.Material.Slate
		rock.CanCollide = false
		rock.CanTouch = false
		rock.CanQuery = false
		rock.CastShadow = true
		rock.Anchored = true

		local startPos = position + (dir * (2 + math.random() * 3))
		local peakPos = startPos + (dir * (maxRadius * 0.65)) + Vector3.new(0, 6 + math.random() * 5, 0)
		local endPos = startPos + (dir * (maxRadius * 0.95)) + Vector3.new(0, 0.2, 0)

		rock.CFrame = CFrame.new(startPos) * CFrame.Angles(math.random(), math.random(), math.random())
		rock.Parent = vfxFolder

		-- Quadratic trajectory tween
		task.spawn(function()
			local flightTime = 0.45 + math.random() * 0.2
			local tStart = os.clock()
			while true do
				local elapsed = os.clock() - tStart
				local alpha = math.clamp(elapsed / flightTime, 0, 1)

				-- Bezier curve from startPos -> peakPos -> endPos
				local p1 = startPos:Lerp(peakPos, alpha)
				local p2 = peakPos:Lerp(endPos, alpha)
				local currentPos = p1:Lerp(p2, alpha)

				rock.CFrame = CFrame.new(currentPos) * CFrame.Angles(alpha * 6, alpha * 4, alpha * 2)

				if alpha >= 1 then break end
				task.wait()
			end

			-- Shrink into ground
			local shrinkTween = TweenService:Create(
				rock,
				TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
				{ Size = Vector3.zero, Transparency = 1 }
			)
			shrinkTween:Play()
			shrinkTween.Completed:Connect(function()
				rock:Destroy()
			end)
		end)
	end

	-- 4. Ground Flash Light
	local lightPart = Instance.new("Part")
	lightPart.Size = Vector3.new(1, 1, 1)
	lightPart.Transparency = 1
	lightPart.CFrame = CFrame.new(position + Vector3.new(0, 2, 0))
	lightPart.Anchored = true
	lightPart.CanCollide = false
	lightPart.Parent = vfxFolder

	local pLight = Instance.new("PointLight")
	pLight.Color = ringColor
	pLight.Range = maxRadius * 1.5
	pLight.Brightness = 12
	pLight.Parent = lightPart

	local lightTween = TweenService:Create(
		pLight,
		TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ Brightness = 0 }
	)
	lightTween:Play()
	lightTween.Completed:Connect(function()
		lightPart:Destroy()
	end)
end

--------------------------------------------------------------------------------
-- 4. AWAKENING TRANSFORMATION BURST & FLAMING AURA
--------------------------------------------------------------------------------

-- Massive transformation explosion
function VFXHelper.AwakeningBurst(character: Model)
	local vfxFolder = getVFXContainer()
	local hrp = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hrp then return end

	local center = hrp.Position
	local auraColor = Color3.fromRGB(190, 50, 255) -- Deep royal purple / magenta
	local flameColor = Color3.fromRGB(255, 90, 200)

	-- 1. Pillar of Light shot into sky
	local pillar = Instance.new("Part")
	pillar.Shape = Enum.PartType.Cylinder
	pillar.Size = Vector3.new(90, 6, 6)
	pillar.CFrame = CFrame.new(center + Vector3.new(0, 45, 0)) * CFrame.Angles(0, 0, math.rad(90))
	pillar.Color = Color3.fromRGB(255, 255, 255)
	pillar.Material = Enum.Material.Neon
	pillar.Transparency = 0.1
	pillar.CanCollide = false
	pillar.CanTouch = false
	pillar.CanQuery = false
	pillar.CastShadow = false
	pillar.Anchored = true
	pillar.Parent = vfxFolder

	local pillarTween = TweenService:Create(
		pillar,
		TweenInfo.new(0.65, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = Vector3.new(120, 18, 18), Transparency = 1 }
	)
	pillarTween:Play()
	pillarTween.Completed:Connect(function()
		pillar:Destroy()
	end)

	-- 2. Massive Spherical Energy Shockwave
	local sphere = Instance.new("Part")
	sphere.Shape = Enum.PartType.Ball
	sphere.Size = Vector3.new(4, 4, 4)
	sphere.CFrame = CFrame.new(center)
	sphere.Color = auraColor
	sphere.Material = Enum.Material.Neon
	sphere.Transparency = 0.15
	sphere.CanCollide = false
	sphere.CanTouch = false
	sphere.CanQuery = false
	sphere.CastShadow = false
	sphere.Anchored = true
	sphere.Parent = vfxFolder

	local sphereTween = TweenService:Create(
		sphere,
		TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = Vector3.new(38, 38, 38), Transparency = 1 }
	)
	sphereTween:Play()
	sphereTween.Completed:Connect(function()
		sphere:Destroy()
	end)

	-- 3. Concentric Ground Rings
	for i = 1, 3 do
		task.delay((i - 1) * 0.1, function()
			local r = Instance.new("Part")
			r.Shape = Enum.PartType.Cylinder
			r.Size = Vector3.new(0.5, 3.0, 3.0)
			r.CFrame = CFrame.new(center + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90))
			r.Color = if i % 2 == 1 then auraColor else flameColor
			r.Material = Enum.Material.Neon
			r.Transparency = 0.2
			r.CanCollide = false
			r.CanTouch = false
			r.CanQuery = false
			r.CastShadow = false
			r.Anchored = true
			r.Parent = vfxFolder

			local rTween = TweenService:Create(
				r,
				TweenInfo.new(0.48, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ Size = Vector3.new(0.1, 32, 32), Transparency = 1 }
			)
			rTween:Play()
			rTween.Completed:Connect(function()
				r:Destroy()
			end)
		end)
	end

	-- 4. Automatically activate persistent aura
	VFXHelper.SetAwakeningAura(character, true)
end

-- Persistent flaming aura on character limbs
function VFXHelper.SetAwakeningAura(character: Model, active: boolean)
	local auraFolder = character:FindFirstChild("AwakeningAuraFolder") :: Folder?

	if not active then
		if auraFolder then
			auraFolder:Destroy()
		end
		local hl = character:FindFirstChild("AwakeningHighlight")
		if hl then
			hl:Destroy()
		end
		return
	end

	-- Remove existing if present to avoid stacking
	if auraFolder then
		auraFolder:Destroy()
	end

	auraFolder = Instance.new("Folder")
	auraFolder.Name = "AwakeningAuraFolder"
	auraFolder.Parent = character

	-- Highlight effect on character
	local highlight = Instance.new("Highlight")
	highlight.Name = "AwakeningHighlight"
	highlight.FillColor = Color3.fromRGB(220, 60, 255)
	highlight.FillTransparency = 0.72
	highlight.OutlineColor = Color3.fromRGB(255, 180, 255)
	highlight.OutlineTransparency = 0.2
	highlight.Parent = character

	-- Attach particle flames to UpperTorso / Torso and Limbs
	local targetParts = { "UpperTorso", "Torso", "HumanoidRootPart", "RightHand", "LeftHand", "RightArm", "LeftArm" }
	for _, partName in targetParts do
		local part = character:FindFirstChild(partName) :: BasePart?
		if part then
			local emitter = Instance.new("ParticleEmitter")
			emitter.Name = "FlameParticle"
			emitter.Rate = 18
			emitter.Lifetime = NumberRange.new(0.35, 0.6)
			emitter.Speed = NumberRange.new(1.5, 4.0)
			emitter.SpreadAngle = Vector2.new(45, 45)
			emitter.Acceleration = Vector3.new(0, 7, 0)
			emitter.Size = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.7),
				NumberSequenceKeypoint.new(0.5, 1.3),
				NumberSequenceKeypoint.new(1, 0),
			})
			emitter.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.2),
				NumberSequenceKeypoint.new(0.6, 0.5),
				NumberSequenceKeypoint.new(1, 1),
			})
			emitter.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 230, 255)),
				ColorSequenceKeypoint.new(0.3, Color3.fromRGB(255, 90, 220)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(130, 20, 240)),
			})
			emitter.LightEmission = 0.95
			emitter.LightInfluence = 0
			emitter.Parent = part
			emitter.Parent = auraFolder -- Parenting to auraFolder ensures clean one-step teardown
			-- Parent attachment inside part to anchor emitter position
			local att = Instance.new("Attachment")
			att.Name = "AuraAttachment"
			att.Parent = part
			emitter.Parent = att
		end
	end
end

--------------------------------------------------------------------------------
-- 5. WALL SPLAT IMPACT
--------------------------------------------------------------------------------

function VFXHelper.WallSplatImpact(position: Vector3, wallNormal: Vector3)
	local vfxFolder = getVFXContainer()
	local norm = wallNormal.Unit
	local splatColor = Color3.fromRGB(255, 80, 180)

	-- 1. Wall Impact Ring
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.3, 1.5, 1.5)
	ring.CFrame = CFrame.lookAt(position, position + norm) * CFrame.Angles(0, math.rad(90), 0)
	ring.Color = splatColor
	ring.Material = Enum.Material.Neon
	ring.Transparency = 0.1
	ring.CanCollide = false
	ring.CanTouch = false
	ring.CanQuery = false
	ring.CastShadow = false
	ring.Anchored = true
	ring.Parent = vfxFolder

	local ringTween = TweenService:Create(
		ring,
		TweenInfo.new(0.32, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = Vector3.new(0.05, 11, 11), Transparency = 1 }
	)
	ringTween:Play()
	ringTween.Completed:Connect(function()
		ring:Destroy()
	end)

	-- 2. Rock Chips Flying from Wall
	for i = 1, 8 do
		local chip = Instance.new("Part")
		chip.Size = Vector3.new(0.4, 0.4, 0.4)
		chip.Color = Color3.fromRGB(130, 125, 120)
		chip.Material = Enum.Material.Slate
		chip.CanCollide = false
		chip.CanTouch = false
		chip.CanQuery = false
		chip.Anchored = true

		local sprayDir = (norm + Vector3.new((math.random() - 0.5) * 1.5, (math.random() - 0.5) * 1.5, (math.random() - 0.5) * 1.5)).Unit
		chip.CFrame = CFrame.new(position)
		chip.Parent = vfxFolder

		local targetPos = position + (sprayDir * (4 + math.random() * 4))
		local chipTween = TweenService:Create(
			chip,
			TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ CFrame = CFrame.new(targetPos), Size = Vector3.zero, Transparency = 1 }
		)
		chipTween:Play()
		chipTween.Completed:Connect(function()
			chip:Destroy()
		end)
	end
end

--------------------------------------------------------------------------------
-- 6. FLASH DASH / COUNTER FLASH
--------------------------------------------------------------------------------

function VFXHelper.FlashCounter(character: Model)
	local vfxFolder = getVFXContainer()
	local hrp = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hrp then return end

	-- Sharp electrical / neon flash
	local flash = Instance.new("Part")
	flash.Shape = Enum.PartType.Ball
	flash.Size = Vector3.new(5, 5, 5)
	flash.CFrame = hrp.CFrame
	flash.Color = Color3.fromRGB(120, 220, 255)
	flash.Material = Enum.Material.Neon
	flash.Transparency = 0.1
	flash.CanCollide = false
	flash.CanTouch = false
	flash.CanQuery = false
	flash.CastShadow = false
	flash.Anchored = true
	flash.Parent = vfxFolder

	local flashTween = TweenService:Create(
		flash,
		TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = Vector3.new(12, 12, 12), Transparency = 1 }
	)
	flashTween:Play()
	flashTween.Completed:Connect(function()
		flash:Destroy()
	end)

	-- Spawns rapid after-image
	VFXHelper.DashTrail(character, hrp.CFrame.LookVector, 0.2, Color3.fromRGB(100, 220, 255))
end

-- Auto-listener on client for Remotes
if RunService:IsClient() then
	task.spawn(function()
		local ReplicatedStorage = game:GetService("ReplicatedStorage")
		local remotes = ReplicatedStorage:WaitForChild("Remotes", 8) :: Folder?
		if not remotes then return end

		-- DashEvent hook
		local dashEvent = remotes:WaitForChild("DashEvent", 5) :: RemoteEvent?
		if dashEvent then
			dashEvent.OnClientEvent:Connect(function(targetChar: Model, direction: Vector3, isLocal: boolean)
				if targetChar and targetChar.Parent then
					VFXHelper.DashTrail(targetChar, direction, 0.25)
				end
			end)
		end

		-- CombatEvent hook
		local combatEvent = remotes:WaitForChild("CombatEvent", 5) :: RemoteEvent?
		if combatEvent then
			combatEvent.OnClientEvent:Connect(function(action: string, data: any)
				if typeof(data) ~= "table" then return end

				if action == "HitConfirm" and data.Target then
					local hrp = data.Target:FindFirstChild("HumanoidRootPart") :: BasePart?
					if hrp then
						local isCrit = data.Knockback or (data.Step and data.Step >= 4)
						local hitPos = hrp.Position + Vector3.new(0, 0.5, 0)
						local norm = if data.Attacker and data.Attacker:FindFirstChild("HumanoidRootPart")
							then (hrp.Position - data.Attacker.HumanoidRootPart.Position).Unit
							else Vector3.new(0, 1, 0)
						VFXHelper.PunchImpact(hitPos, norm, isCrit)
					end
				elseif action == "WallSplat" and data.Target then
					local hrp = data.Target:FindFirstChild("HumanoidRootPart") :: BasePart?
					if hrp then
						local norm = data.Normal or Vector3.new(0, 0, 1)
						VFXHelper.WallSplatImpact(hrp.Position, norm)
					end
				end
			end)
		end

		-- SkillEvent hook
		local skillEvent = remotes:WaitForChild("SkillEvent", 5) :: RemoteEvent?
		if skillEvent then
			skillEvent.OnClientEvent:Connect(function(action: string, data: any)
				if typeof(data) ~= "table" then return end

				if action == "SkillFired" then
					local skillId = data.SkillId
					local pos = data.Position
					if skillId == 3 and pos then -- Ground Slam
						VFXHelper.GroundSlam(pos, 18)
					elseif skillId == 4 and data.User then -- Flash Dash / Counter
						VFXHelper.FlashCounter(data.User)
					elseif (skillId == 1 or skillId == 2) and pos then
						VFXHelper.PunchImpact(pos, Vector3.new(0, 1, 0), skillId == 2)
					end
				elseif action == "AwakeningState" and data.User then
					if data.Active == true then
						VFXHelper.AwakeningBurst(data.User)
					else
						VFXHelper.SetAwakeningAura(data.User, false)
					end
				end
			end)
		end
	end)
end

return VFXHelper
]]></string>
        </Properties>
      </Item>
