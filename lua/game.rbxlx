    <Item class="StarterPlayerScripts" referent="85">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="86">
        <Properties>
          <string name="Name">CameraController</string>
          <string name="Source"><![CDATA[--!strict
-- CameraController.client.luau
-- Client-side camera management featuring dynamic 6DOF screen shake, trauma decay,
-- FOV kick impulses, and automated combat event listeners.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera or workspace:WaitForChild("Camera") :: Camera

-- Forward reference to ScreenShake module
local Modules = ReplicatedStorage:WaitForChild("Modules", 5) :: Folder?
local ScreenShake = if Modules and Modules:FindFirstChild("ScreenShake")
	then require(Modules:WaitForChild("ScreenShake"))
	else require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("ScreenShake"))

-- Active Shake State
type ShakeInstance = {
	Intensity: number,
	Duration: number,
	Frequency: number,
	StartTime: number,
	RotationalRatio: number,
	TraumaExponent: number,
	NoiseSeed: number,
}

local activeShakes: { ShakeInstance } = {}
local trauma = 0.0
local defaultFOV = Camera.FieldOfView
local targetFOVOffset = 0.0
local currentFOVOffset = 0.0

-- Ensure camera reference is kept fresh
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
	local newCam = workspace.CurrentCamera
	if newCam then
		Camera = newCam
		defaultFOV = Camera.FieldOfView
	end
end)

-- Adds an active shake instance
local function addShake(intensity: number, duration: number, frequency: number, options: any?)
	local rotRatio = if options and options.RotationalRatio then options.RotationalRatio else 1.0
	local exponent = if options and options.TraumaExponent then options.TraumaExponent else 2.0

	table.insert(activeShakes, {
		Intensity = intensity,
		Duration = duration,
		Frequency = frequency,
		StartTime = os.clock(),
		RotationalRatio = rotRatio,
		TraumaExponent = exponent,
		NoiseSeed = math.random() * 1000,
	})

	-- Add to generalized trauma
	local addedTrauma = math.clamp(intensity * 0.4, 0, 1)
	trauma = math.clamp(trauma + addedTrauma, 0, 1)
end

-- Hook into ScreenShake module
ScreenShake.SetHandler(addShake)

-- Dynamic FOV punch
local function kickFOV(amount: number, returnDuration: number?)
	if not Camera then return end
	local duration = returnDuration or 0.25
	local punchTween = TweenService:Create(
		Camera,
		TweenInfo.new(0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ FieldOfView = defaultFOV + amount }
	)
	local returnTween = TweenService:Create(
		Camera,
		TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ FieldOfView = defaultFOV }
	)

	punchTween:Play()
	punchTween.Completed:Connect(function()
		returnTween:Play()
	end)
end

-- 6DOF Camera Shake Calculation on RenderStepped
local function onCameraStep(dt: number)
	if not Camera then
		Camera = workspace.CurrentCamera
		if not Camera then return end
	end

	local now = os.clock()
	local totalPosOffset = Vector3.zero
	local totalRotPitch = 0.0
	local totalRotYaw = 0.0
	local totalRotRoll = 0.0

	-- Decay general trauma
	if trauma > 0 then
		trauma = math.max(0, trauma - (dt * 1.6))
	end

	local generalShake = trauma * trauma

	-- Process discrete shake instances
	local i = 1
	while i <= #activeShakes do
		local shake = activeShakes[i]
		local elapsed = now - shake.StartTime

		if elapsed >= shake.Duration then
			table.remove(activeShakes, i)
		else
			local progress = elapsed / shake.Duration
			-- Smooth decay envelope: (1 - progress)^exponent
			local decay = math.pow(1 - progress, shake.TraumaExponent)
			local currentAmp = shake.Intensity * decay

			local t = elapsed * shake.Frequency
			local seed = shake.NoiseSeed

			-- Translational offsets via smooth continuous Perlin noise
			local nx = math.noise(seed, t, 0)
			local ny = math.noise(seed + 10.5, t, 0)
			local nz = math.noise(seed + 20.5, t, 0)

			-- Rotational offsets (in radians)
			local rx = math.noise(seed + 30.5, t, 0) * 0.035 * shake.RotationalRatio
			local ry = math.noise(seed + 40.5, t, 0) * 0.035 * shake.RotationalRatio
			local rz = math.noise(seed + 50.5, t, 0) * 0.025 * shake.RotationalRatio

			totalPosOffset += Vector3.new(nx, ny, nz) * (currentAmp * 0.22)
			totalRotPitch += rx * currentAmp
			totalRotYaw += ry * currentAmp
			totalRotRoll += rz * currentAmp

			i += 1
		end
	end

	-- Add general trauma ambient noise if active
	if generalShake > 0.01 then
		local t = now * 25
		local gSeed = 99.1
		local gnx = math.noise(gSeed, t, 0) * 0.15 * generalShake
		local gny = math.noise(gSeed + 12.3, t, 0) * 0.15 * generalShake
		local gnz = math.noise(gSeed + 24.6, t, 0) * 0.15 * generalShake

		local grx = math.noise(gSeed + 36.9, t, 0) * 0.02 * generalShake
		local gry = math.noise(gSeed + 48.2, t, 0) * 0.02 * generalShake
		local grz = math.noise(gSeed + 60.5, t, 0) * 0.015 * generalShake

		totalPosOffset += Vector3.new(gnx, gny, gnz)
		totalRotPitch += grx
		totalRotYaw += gry
		totalRotRoll += grz
	end

	-- Apply CFrame offset to Camera
	if totalPosOffset.Magnitude > 0.0001 or math.abs(totalRotPitch) > 0.0001 or math.abs(totalRotYaw) > 0.0001 or math.abs(totalRotRoll) > 0.0001 then
		local offsetCFrame = CFrame.new(totalPosOffset) * CFrame.Angles(totalRotPitch, totalRotYaw, totalRotRoll)
		Camera.CFrame = Camera.CFrame * offsetCFrame
	end
end

-- Bind immediately after Roblox Camera update
RunService:BindToRenderStep("BattlegroundCameraShake", Enum.RenderPriority.Camera.Value + 1, onCameraStep)

-- Setup Remote Event Listeners for Automatic Camera Shake & Audio-visual Immersion
local function setupRemoteListeners()
	local Remotes = ReplicatedStorage:WaitForChild("Remotes", 8) :: Folder?
	if not Remotes then
		return
	end

	-- 1. CombatEvent (M1 hits, Knockbacks, Wall Splats)
	local combatEvent = Remotes:WaitForChild("CombatEvent", 5) :: RemoteEvent?
	if combatEvent then
		combatEvent.OnClientEvent:Connect(function(action: string, data: any)
			if typeof(data) ~= "table" then return end

			local myChar = LocalPlayer.Character
			local isMeAttacker = (data.Attacker == myChar)
			local isMeTarget = (data.Target == myChar)

			if action == "HitConfirm" then
				if isMeTarget then
					-- Local player took a hit
					if data.Knockback then
						ScreenShake.Heavy()
						kickFOV(-4, 0.3)
					elseif data.Blocked then
						ScreenShake.Light()
					else
						ScreenShake.Medium()
						kickFOV(-2, 0.15)
					end
				elseif isMeAttacker then
					-- Local player struck an opponent
					if data.Knockback then
						ScreenShake.Medium()
						kickFOV(-3, 0.25)
					else
						ScreenShake.Light()
					end
				else
					-- Distant combat hit
					if data.Target and data.Target:FindFirstChild("HumanoidRootPart") then
						local pos = data.Target.HumanoidRootPart.Position
						if data.Knockback then
							ScreenShake.ShakeAtPosition(pos, 90, 1.2, 0.35, 24)
						end
					end
				end
			elseif action == "WallSplat" then
				if isMeTarget then
					ScreenShake.WallSplat()
					kickFOV(-6, 0.4)
				elseif isMeAttacker then
					ScreenShake.Heavy()
					kickFOV(-3, 0.3)
				else
					if data.Target and data.Target:FindFirstChild("HumanoidRootPart") then
						ScreenShake.ShakeAtPosition(data.Target.HumanoidRootPart.Position, 100, 1.5, 0.4, 25)
					end
				end
			end
		end)
	end

	-- 2. SkillEvent (Skill casts, Awakening transformation)
	local skillEvent = Remotes:WaitForChild("SkillEvent", 5) :: RemoteEvent?
	if skillEvent then
		skillEvent.OnClientEvent:Connect(function(action: string, data: any)
			if typeof(data) ~= "table" then return end

			local myChar = LocalPlayer.Character
			local isMe = (data.User == myChar or data.Player == LocalPlayer)

			if action == "SkillFired" then
				local skillId = data.SkillId
				if isMe then
					if skillId == 1 then -- Consecutive Punches
						ScreenShake.Medium({ Duration = 0.3, Frequency = 34 })
					elseif skillId == 2 then -- Heavy Punch
						ScreenShake.Heavy()
						kickFOV(-5, 0.35)
					elseif skillId == 3 then -- Ground Slam
						ScreenShake.Explosion()
						kickFOV(-7, 0.4)
					elseif skillId == 4 then -- Flash Dash / Counter
						ScreenShake.Light()
						kickFOV(4, 0.2)
					end
				else
					if data.Position then
						ScreenShake.ShakeAtPosition(data.Position, 120, 1.8, 0.5, 22)
					end
				end
			elseif action == "AwakeningState" then
				if isMe and data.Active == true then
					ScreenShake.Awakening()
					kickFOV(-10, 0.8)
				elseif data.Active == true and data.Position then
					ScreenShake.ShakeAtPosition(data.Position, 150, 2.0, 1.0, 20)
				end
			end
		end)
	end

	-- 3. BlockEvent (Guard Break)
	local blockEvent = Remotes:WaitForChild("BlockEvent", 5) :: RemoteEvent?
	if blockEvent then
		blockEvent.OnClientEvent:Connect(function(targetChar: Model, isBlocking: boolean, guardBroken: boolean)
			if targetChar == LocalPlayer.Character and guardBroken then
				ScreenShake.GuardBreak()
				kickFOV(-8, 0.5)
			end
		end)
	end

	-- 4. DashEvent (Dash feel)
	local dashEvent = Remotes:WaitForChild("DashEvent", 5) :: RemoteEvent?
	if dashEvent then
		dashEvent.OnClientEvent:Connect(function(targetChar: Model, direction: Vector3, isLocal: boolean)
			if targetChar == LocalPlayer.Character then
				kickFOV(3, 0.2)
			end
		end)
	end
end

task.spawn(setupRemoteListeners)

print("[CameraController] Loaded and active.")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="87">
        <Properties>
          <string name="Name">ClientCombatCore</string>
          <string name="Source"><![CDATA[--!strict
-- ClientCombatCore.luau
-- Client controller for M1 Combo inputs, F Block stance, Q 4-directional Dash with i-frames,
-- and Dash Cancel combo extension mechanics.

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local Modules = ReplicatedStorage:WaitForChild("Modules")
local CombatConfig = require(Modules:WaitForChild("CombatConfig"))
local RagdollHelper = require(Modules:WaitForChild("RagdollHelper"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes", 5) :: Folder
local CombatEvent = Remotes:WaitForChild("CombatEvent") :: RemoteEvent
local BlockEvent = Remotes:WaitForChild("BlockEvent") :: RemoteEvent
local DashEvent = Remotes:WaitForChild("DashEvent") :: RemoteEvent

-- Local state
local comboStep = 1
local lastM1Time = 0
local lastDashTime = 0
local isBlocking = false
local isM1Cooldown = false

local AnimationManager = require(Modules:WaitForChild("AnimationManager"))

local function playProceduralM1(character: Model, step: number)
 AnimationManager.PlayAnimation(character, "M1_" .. tostring(step))
end
local function setBlockPose(character: Model, active: boolean)
 if active then AnimationManager.PlayAnimation(character, "Block")
 else AnimationManager.StopAnimation(character, "Block", 0.12) end
end

-- Screen shake trigger helper for heavy hits
local function triggerScreenShake(intensity: number)
	if not Camera then
		return
	end
	task.spawn(function()
		local duration = 0.2
		local startTime = os.clock()
		while os.clock() - startTime < duration do
			local offset = Vector3.new(
				(math.random() - 0.5) * intensity,
				(math.random() - 0.5) * intensity,
				(math.random() - 0.5) * intensity
			)
			Camera.CFrame = Camera.CFrame * CFrame.new(offset)
			task.wait()
		end
	end)
end

-- Checks if local player can perform actions
local function canAct(): boolean
	local character = LocalPlayer.Character
	if not character or not character.Parent then
		return false
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return false
	end
	if RagdollHelper.IsRagdolled(character) then
		return false
	end
	if character:GetAttribute("IsStunned") == true then
		return false
	end
	return true
end

-- Handle M1 Attack Click
local function performM1()
	if not canAct() or isBlocking or isM1Cooldown or (LocalPlayer.Character and LocalPlayer.Character:GetAttribute("IsAttacking") == true) then
		return
	end

	local character = LocalPlayer.Character
	if not character then
		return
	end

	local now = os.clock()
	if now - lastM1Time > CombatConfig.ComboResetTime then
		comboStep = 1
	end

	local currentStep = comboStep
	local stepConfig = CombatConfig.M1[currentStep]
	if not stepConfig then
		comboStep = 1
		stepConfig = CombatConfig.M1[1]
		currentStep = 1
	end

	isM1Cooldown = true
	lastM1Time = now

	-- Play client-side prediction visual and sound
	playProceduralM1(character, currentStep)

	-- Advance local combo step
	if currentStep >= CombatConfig.MaxComboSteps then
		comboStep = 1
	else
		comboStep = currentStep + 1
	end

	-- Fire attack to server
	CombatEvent:FireServer("M1", currentStep)

	-- Reset attack cooldown
	task.delay(stepConfig.Cooldown, function()
		isM1Cooldown = false
	end)
end

-- Determine 4-directional Dash Vector
local function getDashDirection(): (Vector3, string)
	local isW = UserInputService:IsKeyDown(Enum.KeyCode.W)
	local isS = UserInputService:IsKeyDown(Enum.KeyCode.S)
	local isA = UserInputService:IsKeyDown(Enum.KeyCode.A)
	local isD = UserInputService:IsKeyDown(Enum.KeyCode.D)

	local x = 0
	local z = 0

	if isW then z -= 1 end
	if isS then z += 1 end
	if isA then x -= 1 end
	if isD then x += 1 end

	local moveInput = Vector3.new(x, 0, z)
	local character = LocalPlayer.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?

	local dashType = "Front"
	if z > 0 then
		dashType = "Back"
	elseif x < 0 then
		dashType = "Left"
	elseif x > 0 then
		dashType = "Right"
	end

	if not hrp then
		return Vector3.new(0, 0, -1), dashType
	end

	if moveInput.Magnitude < 0.1 then
		-- Default to facing forward
		return hrp.CFrame.LookVector, "Front"
	end

	-- Transform local movement direction relative to camera/character orientation
	local cameraCFrame = Camera and Camera.CFrame or hrp.CFrame
	local flatLook = Vector3.new(cameraCFrame.LookVector.X, 0, cameraCFrame.LookVector.Z)
	local flatCameraLook = if flatLook.Magnitude > 0.01 then flatLook.Unit else (if hrp then hrp.CFrame.LookVector else Vector3.new(0, 0, -1))
	local flatRight = Vector3.new(cameraCFrame.RightVector.X, 0, cameraCFrame.RightVector.Z)
	local flatCameraRight = if flatRight.Magnitude > 0.01 then flatRight.Unit else Vector3.new(1, 0, 0)
	local rawDir = flatCameraRight * moveInput.X + flatCameraLook * (-moveInput.Z)
	local worldDir = if rawDir.Magnitude > 0.01 then rawDir.Unit else (if hrp then hrp.CFrame.LookVector else Vector3.new(0, 0, -1))
	return worldDir, dashType
end

-- Handle Dash (Q) and Dash Cancel
local function performDash()
	if not canAct() then
		return
	end

	local character = LocalPlayer.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hrp then
		return
	end

	local now = os.clock()
	local isDashCancel = (now - lastM1Time <= CombatConfig.DashCancelWindow)

	-- Cooldown validation
	if not isDashCancel and (now - lastDashTime < CombatConfig.DashCooldown) then
		return
	end

	lastDashTime = now

	-- If dash cancel was triggered, instantly cancel M1 lock
	if isDashCancel then
		isM1Cooldown = false
	end

	local dir, dashType = getDashDirection()

	-- Client prediction impulse
	hrp.AssemblyLinearVelocity = dir * CombatConfig.DashSpeed
	character:SetAttribute("iFrames", true)
	task.delay(CombatConfig.iFrameDuration, function()
		if character and character.Parent then
			character:SetAttribute("iFrames", false)
		end
	end)

	-- Send to server
	DashEvent:FireServer(dir, dashType)
end

-- Handle Block start and end (F key)
local function startBlock()
	if not canAct() or isBlocking then
		return
	end

	local character = LocalPlayer.Character
	if not character then
		return
	end

	isBlocking = true
	setBlockPose(character, true)
	BlockEvent:FireServer(true)
end

local function stopBlock()
	if not isBlocking then
		return
	end

	local character = LocalPlayer.Character
	if character then
		setBlockPose(character, false)
	end

	isBlocking = false
	BlockEvent:FireServer(false)
end

-- CombatController owns input dispatch, preventing duplicate action requests.

-- Server Event Listeners for VFX, Camera Shake, and Sounds
CombatEvent.OnClientEvent:Connect(function(action: string, data: any)
	if action == "HitConfirm" and typeof(data) == "table" then
		local shakeIntensity = 0.15
		if data.Knockback then
			shakeIntensity = 0.5
		end

		if data.Target == LocalPlayer.Character then
			-- Local player took damage
			triggerScreenShake(shakeIntensity)
		elseif data.Attacker == LocalPlayer.Character then
			-- Local player landed hit
			if data.Knockback then
				triggerScreenShake(0.25)
			end
		end
	elseif action == "WallSplat" and typeof(data) == "table" then
		if data.Target == LocalPlayer.Character then
			triggerScreenShake(0.7)
		else
			triggerScreenShake(0.3)
		end
	end
end)

BlockEvent.OnClientEvent:Connect(function(targetChar: Model, isTargetBlocking: boolean, guardBroken: boolean)
	if targetChar == LocalPlayer.Character then
		if guardBroken then
			stopBlock()
			triggerScreenShake(0.4)
		end
	end
end)

return {
	PerformM1 = performM1,
	PerformDash = performDash,
	StartBlock = startBlock,
	StopBlock = stopBlock,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="88">
        <Properties>
          <string name="Name">ClientSkillManager</string>
          <string name="Source"><![CDATA[--!strict
-- ClientSkillManager.luau
-- Client-side moveset controller for Saitama R15 Martial Arts character:
-- 1. Listens for PC skill inputs: Keys Z, X, C, V and G (Awakening / Ultimate).
-- 2. Client prediction: Instant animation playback via AnimationManager, camera shakes, and VFX triggers.
-- 3. Communicates with server via SkillEvent remote.
-- 4. Receives and renders remote VFX & ScreenShake events from other players and server authorities.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local ClientCombatCore = require(script.Parent:WaitForChild("ClientCombatCore"))

-- Safe references to shared modules
local Modules = ReplicatedStorage:WaitForChild("Modules", 5) :: Folder?
local MovesetData
if Modules and Modules:FindFirstChild("MovesetData") then
	MovesetData = require(Modules:WaitForChild("MovesetData"))
else
	MovesetData = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("MovesetData"))
end

local AnimationManager
if Modules and Modules:FindFirstChild("AnimationManager") then
	AnimationManager = require(Modules:WaitForChild("AnimationManager"))
else
	AnimationManager = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("AnimationManager"))
end

-- Optional UI & VFX modules with graceful fallback
local function getScreenShake()
	if Modules and Modules:FindFirstChild("ScreenShake") then
		local s, res = pcall(require, Modules.ScreenShake)
		if s then return res end
	end
	return nil
end

local function getVFXHelper()
	if Modules and Modules:FindFirstChild("VFXHelper") then
		local s, res = pcall(require, Modules.VFXHelper)
		if s then return res end
	end
	return nil
end

local ClientSkillManager = {}

-- State tracking
local isAwakenedState = false
local localCooldowns: { [number]: number } = {}
local isInitialized = false

-- Safe remote retrieval
local function getSkillEvent(): RemoteEvent?
	local remotes = ReplicatedStorage:FindFirstChild("Remotes") :: Folder?
	if not remotes then
		remotes = ReplicatedStorage:WaitForChild("Remotes", 5) :: Folder?
	end
	if not remotes then return nil end
	return remotes:FindFirstChild("SkillEvent") :: RemoteEvent?
end

--------------------------------------------------------------------------------
-- LOCAL QUERY HELPERS
--------------------------------------------------------------------------------

-- Checks if the local player is currently awakened
function ClientSkillManager.IsAwakened(): boolean
	local char = player.Character
	if char and char:GetAttribute("IsAwakened") ~= nil then
		return char:GetAttribute("IsAwakened") == true
	end
	return isAwakenedState
end

-- Gets remaining cooldown time in seconds for a skill slot (1-4)
function ClientSkillManager.GetRemainingCooldown(skillId: number): number
	local expiry = localCooldowns[skillId]
	if not expiry then return 0 end
	local remaining = expiry - os.clock()
	return math.max(0, remaining)
end

-- Goku Authentic SFX Asset IDs mined from open-source references
local GOKU_SFX = {
	RushBarrage = "rbxassetid://6968100828",
	KamehamehaCharge = "rbxassetid://1370232812",
	KamehamehaFire = "rbxassetid://5689578119",
	KaiokenAura = "rbxassetid://4595238902",
	InstantTransmission = "rbxassetid://4826619573",
	SuperSaiyanAwakening = "rbxassetid://275282542",
}

local function playGokuSound(soundId: string, parentInstance: Instance?, volume: number?)
	if not parentInstance or soundId == "" or soundId == "rbxassetid://0" then return end
	pcall(function()
		local snd = Instance.new("Sound")
		snd.SoundId = soundId
		snd.Volume = volume or 1.0
		snd.RollOffMaxDistance = 120
		snd.Parent = parentInstance
		snd:Play()
		task.delay(3.5, function()
			snd:Destroy()
		end)
	end)
end

-- Procedural VFX for Goku skills
local function spawnKamehamehaClientVFX(character: Model, isAwakened: boolean)
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then return end
	local vfxFolder = workspace:FindFirstChild("VFX_Container") or workspace

	-- Phase 1: Blue charging Ki sphere at hip
	local orb = Instance.new("Part")
	orb.Shape = Enum.PartType.Ball
	orb.Size = Vector3.new(1.0, 1.0, 1.0)
	orb.CFrame = root.CFrame * CFrame.new(0.7, 0.33, -1.05)
	local orbColor = Color3.fromRGB(80, 200, 255)
	if isAwakened then
		orbColor = Color3.fromRGB(255, 230, 80)
	end
	orb.Color = orbColor
	orb.Material = Enum.Material.Neon
	orb.CanCollide = false
 orb.CanQuery = false
 orb.CanTouch = false
	orb.Anchored = true
	orb.CanTouch = false
 orb.CanQuery = false
 orb.Parent = vfxFolder
 local chargeFollow = RunService.RenderStepped:Connect(function()
  if root.Parent and orb.Parent then
   orb.CFrame = root.CFrame * CFrame.new(0.7, 0.33, -1.05)
  end
 end)
 game:GetService("Debris"):AddItem(orb, 2)

	local light = Instance.new("PointLight")
	light.Color = orb.Color
	light.Range = 18
	light.Brightness = 4
	light.Parent = orb

	local chargeTween = game:GetService("TweenService"):Create(
		orb,
		TweenInfo.new(if isAwakened then 0.53 else 0.48, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = Vector3.new(1.8, 1.8, 1.8) }
	)
	chargeTween:Play()

	-- Phase 2: Beam release forward
	task.delay(if isAwakened then 0.55 else 0.50, function()
		chargeFollow:Disconnect()
		if not character.Parent or not root.Parent then
			orb:Destroy()
			return
		end
		orb:Destroy()

		local beamLen = 44.0
		local beamWidth = 7.5
		if isAwakened then
			beamLen = 50.0
			beamWidth = 10.0
		end

		-- Outer Energy Beam Cylinder
		local beam = Instance.new("Part")
		beam.Shape = Enum.PartType.Cylinder
		beam.Size = Vector3.new(beamLen, beamWidth, beamWidth)
		beam.CFrame = (root.CFrame * CFrame.new(0.2, 1.25, -beamLen / 2 - 1.5)) * CFrame.Angles(0, math.rad(90), 0)
		local beamColor = Color3.fromRGB(50, 160, 255)
		if isAwakened then
			beamColor = Color3.fromRGB(255, 220, 60)
		end
		beam.Color = beamColor
		beam.Material = Enum.Material.Neon
		beam.Transparency = 0.25
		beam.CanCollide = false
 beam.CanQuery = false
 beam.CanTouch = false
		beam.Anchored = true
		beam.Parent = vfxFolder

		-- Inner Core Cylinder
		local core = Instance.new("Part")
		core.Shape = Enum.PartType.Cylinder
		core.Size = Vector3.new(beamLen + 1, beamWidth * 0.5, beamWidth * 0.5)
		core.CFrame = beam.CFrame
		core.Color = Color3.fromRGB(255, 255, 255)
		core.Material = Enum.Material.Neon
		core.Transparency = 0.05
		core.CanCollide = false
 core.CanQuery = false
 core.CanTouch = false
		core.Anchored = true
		core.Parent = vfxFolder

		-- Fade and dissipate beam
		task.delay(0.40, function()
			local fade = game:GetService("TweenService"):Create(
				beam,
				TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
				{ Transparency = 1, Size = Vector3.new(beamLen, beamWidth * 1.5, beamWidth * 1.5) }
			)
			local coreFade = game:GetService("TweenService"):Create(
				core,
				TweenInfo.new(0.20, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
				{ Transparency = 1 }
			)
			fade:Play()
			coreFade:Play()
			task.delay(0.26, function()
				beam:Destroy()
				core:Destroy()
			end)
		end)
	end)
end

local function spawnKaiokenClientVFX(character: Model, isAwakened: boolean)
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then return end
	local vfxFolder = workspace:FindFirstChild("VFX_Container") or workspace

	-- Crimson Kaioken Aura burst sphere
	local burst = Instance.new("Part")
	burst.Shape = Enum.PartType.Ball
	burst.Size = Vector3.new(4, 4, 4)
	burst.CFrame = root.CFrame
	local burstColor = Color3.fromRGB(255, 25, 45)
	if isAwakened then
		burstColor = Color3.fromRGB(255, 70, 30)
	end
	burst.Color = burstColor
	burst.Material = Enum.Material.Neon
	burst.Transparency = 0.3
	burst.CanCollide = false
 burst.CanQuery = false
 burst.CanTouch = false
	burst.Anchored = true
	burst.Parent = vfxFolder

	local bLight = Instance.new("PointLight")
	bLight.Color = burst.Color
	bLight.Range = 25
	bLight.Brightness = 8
	bLight.Parent = burst

	local tw = game:GetService("TweenService"):Create(
		burst,
		TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = Vector3.new(16, 16, 16), Transparency = 1 }
	)
	tw:Play()
	tw.Completed:Connect(function()
		burst:Destroy()
	end)
end

local function spawnInstantTransmissionClientVFX(character: Model)
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then return end
	local vfxFolder = workspace:FindFirstChild("VFX_Container") or workspace

	-- Departure vertical streak flash
	local flash = Instance.new("Part")
	flash.Shape = Enum.PartType.Cylinder
	flash.Size = Vector3.new(14, 3, 3)
	flash.CFrame = root.CFrame * CFrame.Angles(0, 0, math.rad(90))
	flash.Color = Color3.fromRGB(150, 235, 255)
	flash.Material = Enum.Material.Neon
	flash.Transparency = 0.15
	flash.CanCollide = false
 flash.CanQuery = false
 flash.CanTouch = false
	flash.Anchored = true
	flash.Parent = vfxFolder

	local tw = game:GetService("TweenService"):Create(
		flash,
		TweenInfo.new(0.20, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = Vector3.new(24, 0.2, 0.2), Transparency = 1 }
	)
	tw:Play()
	tw.Completed:Connect(function()
		flash:Destroy()
	end)
end

local function spawnSpiritBombClientVFX(character: Model)
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then return end
	local vfxFolder = workspace:FindFirstChild("VFX_Container") or workspace

	-- Giant energy sphere above head
	local bomb = Instance.new("Part")
	bomb.Shape = Enum.PartType.Ball
	bomb.Size = Vector3.new(3, 3, 3)
	bomb.CFrame = root.CFrame * CFrame.new(0, 10, 0)
	bomb.Color = Color3.fromRGB(80, 220, 255)
	bomb.Material = Enum.Material.Neon
	bomb.Transparency = 0.2
	bomb.CanCollide = false
 bomb.CanQuery = false
 bomb.CanTouch = false
	bomb.Anchored = true
	bomb.CanTouch = false
 bomb.CanQuery = false
 bomb.Parent = vfxFolder
 local bombFollow = RunService.RenderStepped:Connect(function()
  if root.Parent and bomb.Parent then bomb.CFrame = root.CFrame * CFrame.new(0, 10, 0) end
 end)
 game:GetService("Debris"):AddItem(bomb, 3)

	local bLight = Instance.new("PointLight")
	bLight.Color = bomb.Color
	bLight.Range = 35
	bLight.Brightness = 10
	bLight.Parent = bomb

	local tw = game:GetService("TweenService"):Create(
		bomb,
		TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{ Size = Vector3.new(14, 14, 14) }
	)
	tw:Play()

	-- Launch forward and explode
	task.delay(0.55, function()
		bombFollow:Disconnect()
		if not character.Parent or not root.Parent then
			bomb:Destroy()
			return
		end
		local forwardPos = root.Position + (root.CFrame.LookVector * 28)
		local moveTw = game:GetService("TweenService"):Create(
			bomb,
			TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ Position = forwardPos }
		)
		moveTw:Play()
		moveTw.Completed:Connect(function()
			local blast = Instance.new("Part")
			blast.Shape = Enum.PartType.Ball
			blast.Size = Vector3.new(8, 8, 8)
			blast.CFrame = CFrame.new(forwardPos)
			blast.Color = Color3.fromRGB(150, 240, 255)
			blast.Material = Enum.Material.Neon
			blast.CanCollide = false
 blast.CanQuery = false
 blast.CanTouch = false
			blast.Anchored = true
			blast.Parent = vfxFolder

			bomb:Destroy()

			local blastTw = game:GetService("TweenService"):Create(
				blast,
				TweenInfo.new(0.40, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ Size = Vector3.new(32, 32, 32), Transparency = 1 }
			)
			blastTw:Play()
			blastTw.Completed:Connect(function()
				blast:Destroy()
			end)
		end)
	end)
end

-- Checks if local character can currently cast actions (not stunned or ragdolled)
local function canCastSkill(character: Model): boolean
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return false
	end

	-- Only hard stuns and active ragdoll prevent skill activation
	if character:GetAttribute("IsStunned") == true
		or character:GetAttribute("IsRagdolled") == true
		or character:GetAttribute("IsCountering") == true then
		return false
	end

	return true
end

--------------------------------------------------------------------------------
-- SKILL EXECUTION & CLIENT PREDICTION
--------------------------------------------------------------------------------

-- Triggers skill cast for given skill slot (1-4)
function ClientSkillManager.CastSkill(skillId: number)
	local character = player.Character
	if not character or not canCastSkill(character) then
		return
	end

	-- Check local cooldown
	if ClientSkillManager.GetRemainingCooldown(skillId) > 0 then
		return
	end

	local isAwakened = ClientSkillManager.IsAwakened()
	local skillConfig = MovesetData.GetSkill(skillId, isAwakened)
	if not skillConfig then return end
	local skillEvent = getSkillEvent()
	if not skillEvent then return end

	-- Release both the local block controller and its authoritative server state.
	ClientCombatCore.StopBlock()
	character:SetAttribute("IsBlocking", false)

	-- Optimistic local cooldown prediction
	local expectedCD = MovesetData.GetCooldown(skillId, isAwakened)
	localCooldowns[skillId] = os.clock() + expectedCD

	-- Send intent immediately; optional audio/VFX must never delay or prevent it.
	skillEvent:FireServer("CastSkill", skillId)

	-- 1. Client Prediction: Instant Animation Playback
	AnimationManager.PlayAnimation(character, skillConfig.AnimationName)

	-- 2. Client Prediction: Camera Shake & Local Audio/VFX
	local screenShake = getScreenShake()
	local vfxHelper = getVFXHelper()
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?

	if skillId == 1 then
		-- Rush Attack / Đấm liên hoàn: rapid rumble & punch impacts
		playGokuSound(GOKU_SFX.RushBarrage, root, 0.9)
		if screenShake and screenShake.Light then
			screenShake.Light()
		end
		if vfxHelper and vfxHelper.PunchImpact and root then
			vfxHelper.PunchImpact(root.Position + (root.CFrame.LookVector * 3.5), root.CFrame.LookVector, false)
		end
	elseif skillId == 2 then
		-- Kamehameha: charging stance at hip with blue Ki orb, then beam fire
		playGokuSound(GOKU_SFX.KamehamehaCharge, root, 1.0)
		task.delay(skillConfig.WindupTime, function()
			playGokuSound(GOKU_SFX.KamehamehaFire, root, 1.0)
		end)
  task.delay(skillConfig.WindupTime, function()
   if character.Parent and screenShake and screenShake.Heavy then screenShake.Heavy() end
  end)
		spawnKamehamehaClientVFX(character, isAwakened)
	elseif skillId == 3 then
		-- Kaioken / Cận chiến võ thuật: crimson aura burst & martial arts slam
		playGokuSound(GOKU_SFX.KaiokenAura, root, 1.0)
		if screenShake and screenShake.Medium then
			screenShake.Medium()
		end
		spawnKaiokenClientVFX(character, isAwakened)

	elseif skillId == 4 then
		-- Instant Transmission / Spirit Bomb
		if isAwakened then
			playGokuSound(GOKU_SFX.KamehamehaFire, root, 1.0)
			spawnSpiritBombClientVFX(character)
		else
			playGokuSound(GOKU_SFX.InstantTransmission, root, 1.0)
			if screenShake and screenShake.Medium then
				screenShake.Medium()
			end
			spawnInstantTransmissionClientVFX(character)
			if vfxHelper and vfxHelper.FlashCounter then
				vfxHelper.FlashCounter(character)
			end
		end
	end

end

-- Triggers Awakening / Ultimate transformation (Key G)
function ClientSkillManager.ActivateAwakening()
	local character = player.Character
	if not character or not canCastSkill(character) or character:GetAttribute("IsAttacking") == true then
		return
	end

	if ClientSkillManager.IsAwakened() then
		return
	end

	-- Check Rage meter requirement (100%)
	local currentRage = (character and character:GetAttribute("Rage")) or 0
	if currentRage < MovesetData.AwakeningConfig.RequiredRageMeter then
		return
	end

	-- Client Prediction: Super Saiyan Transformation Audio, Animation & Shake
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	playGokuSound(GOKU_SFX.SuperSaiyanAwakening, root, 1.0)
	AnimationManager.PlayAnimation(character, MovesetData.AwakeningConfig.AnimationName)

	local screenShake = getScreenShake()
	if screenShake and screenShake.Awakening then
		screenShake.Awakening()
	end

	local vfxHelper = getVFXHelper()
	if vfxHelper and vfxHelper.AwakeningBurst then
		vfxHelper.AwakeningBurst(character)
	end

	-- Send request to server
	local skillEvent = getSkillEvent()
	if skillEvent then
		skillEvent:FireServer("Awakening")
	end
end

--------------------------------------------------------------------------------
-- REMOTE EVENT HANDLING (SERVER SYNC & VFX REPLICATION)
--------------------------------------------------------------------------------

local function setupRemoteListeners()
	local skillEvent = getSkillEvent()
	if not skillEvent then
		task.delay(1, setupRemoteListeners)
		return
	end

	skillEvent.OnClientEvent:Connect(function(action: string, data: any)
		if typeof(data) ~= "table" then return end

		local screenShake = getScreenShake()
		local vfxHelper = getVFXHelper()

		if action == "SkillCooldown" then
			local slotId = data.SkillId or (data.ActionKey and tonumber(string.match(data.ActionKey, "(%d+)")))
			local duration = data.Duration :: number?
			if slotId and duration then
				localCooldowns[slotId] = os.clock() + duration
			end

		elseif action == "AwakeningState" then
			local isAwk = data.IsAwakened == true or data.Active == true
			isAwakenedState = isAwk

			local char = player.Character
			if char then
				char:SetAttribute("IsAwakened", isAwk)
			end

			if vfxHelper then
				if isAwk and char then
					vfxHelper.AwakeningBurst(char)
				elseif not isAwk and char then
					vfxHelper.SetAwakeningAura(char, false)
				end
			end

		elseif action == "SkillVFX" then
			local skillId = data.SkillId
			local vfxAction = data.Action
			local attacker = data.Attacker :: Model?
			local isAwakened = data.IsAwakened == true

   if attacker and attacker ~= player.Character then
    if vfxAction == "HeavyPunchWindup" then spawnKamehamehaClientVFX(attacker, isAwakened)
    elseif vfxAction == "SpiritBombStart" then spawnSpiritBombClientVFX(attacker)
    elseif vfxAction == "CounterStance" then spawnInstantTransmissionClientVFX(attacker) end
   end

			if vfxAction == "RushTick" then
				if attacker and screenShake and screenShake.Light then
					local hrp = attacker:FindFirstChild("HumanoidRootPart") :: BasePart?
					if hrp then
						screenShake.ShakeAtPosition(hrp.Position, 80, 0.4, 0.1, 30)
					end
				end

			elseif vfxAction == "RushFinisher" then
				if attacker and screenShake and screenShake.Medium then
					local hrp = attacker:FindFirstChild("HumanoidRootPart") :: BasePart?
					if hrp then
						screenShake.ShakeAtPosition(hrp.Position, 90, 1.2, 0.25, 25)
						if vfxHelper and vfxHelper.PunchImpact then
							vfxHelper.PunchImpact(hrp.Position + (hrp.CFrame.LookVector * 4), hrp.CFrame.LookVector, true)
						end
					end
				end

			elseif vfxAction == "KamehamehaBeam" or vfxAction == "HeavyPunchImpact" then
				local impactCFrame = data.ImpactCFrame :: CFrame?
				local impactPos = Vector3.zero
				if impactCFrame then
					impactPos = impactCFrame.Position
				elseif attacker and attacker:FindFirstChild("HumanoidRootPart") then
					impactPos = attacker.HumanoidRootPart.Position
				end

				if screenShake then
					if isAwakened and screenShake.Explosion then
						screenShake.Explosion()
					elseif screenShake.Heavy then
						screenShake.Heavy()
					end
				end

				if vfxHelper and vfxHelper.PunchImpact then
					vfxHelper.PunchImpact(impactPos, Vector3.new(0, 1, 0), true)
				end

			elseif vfxAction == "KaiokenBurst" or vfxAction == "GroundSlamImpact" then
				local impactPos = data.ImpactPosition :: Vector3?
				local radius = data.Radius :: number? or 18.0
				if impactPos then
					if vfxHelper and vfxHelper.GroundSlam then
						vfxHelper.GroundSlam(impactPos, radius)
					end
					if screenShake and screenShake.Explosion then
						screenShake.ShakeAtPosition(impactPos, 120, 2.2, 0.45, 22)
					end
				end

			elseif vfxAction == "CounterTriggered" or vfxAction == "InstantTransmissionFlash" then
				if attacker and vfxHelper and vfxHelper.FlashCounter then
					vfxHelper.FlashCounter(attacker)
				end
				if screenShake and screenShake.Medium then
					screenShake.Medium()
				end

			elseif vfxAction == "FlashDash" then
				local startPos = data.StartPos :: Vector3?
				local endPos = data.EndPos :: Vector3?
				if attacker and vfxHelper and vfxHelper.DashTrail and startPos and endPos then
					vfxHelper.DashTrail(attacker, (endPos - startPos).Unit, 0.22, Color3.fromRGB(120, 230, 255))
				end

			elseif vfxAction == "AwakeningTransform" then
				if attacker and vfxHelper and vfxHelper.AwakeningBurst then
					vfxHelper.AwakeningBurst(attacker)
				end
				if screenShake and screenShake.Awakening then
					screenShake.Awakening()
				end

			elseif vfxAction == "AwakeningEnd" then
				if attacker and vfxHelper and vfxHelper.SetAwakeningAura then
					vfxHelper.SetAwakeningAura(attacker, false)
				end
			end
		end
	end)
end

--------------------------------------------------------------------------------
-- INPUT LISTENER & INITIALIZATION
--------------------------------------------------------------------------------

function ClientSkillManager.Init()
	if isInitialized then return end
	isInitialized = true

	setupRemoteListeners()

	-- Keyboard dispatch lives in CombatController.

	-- Sync awakening state when character respawns
	player.CharacterAdded:Connect(function(char)
		isAwakenedState = false
		table.clear(localCooldowns)
	end)
end

-- Auto-initialize if running on client
if RunService:IsClient() then
	ClientSkillManager.Init()
end

return ClientSkillManager
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="89">
        <Properties>
          <string name="Name">CombatController</string>
          <string name="Source"><![CDATA[--!strict
-- CombatController.client.luau
-- Main PC Input Coordinator for Roblox Battleground Arena
-- Centralizes PC keybinds (M1, Q+WASD, F, Z/X/C/V, G, Space), input buffering,
-- and interfaces with ClientCombatCore, ClientSkillManager, HUDController, and CameraController.

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local StarterGui = game:GetService("StarterGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

-- Disable Roblox default Backpack toolbar for the custom combat HUD
task.spawn(function()
	local tries = 0
	while tries < 15 do
		local success = pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
		end)
		if success then
			break
		end
		task.wait(0.2)
		tries += 1
	end
end)

-- Remotes
local RemotesFolder = ReplicatedStorage:WaitForChild("Remotes", 5) :: Folder?
local RemotesInit = if RemotesFolder and RemotesFolder:FindFirstChild("RemotesInit")
	then require(RemotesFolder:WaitForChild("RemotesInit"))
	else require(ReplicatedStorage.Remotes.RemotesInit)

local CombatEvent = RemotesInit.GetCombatEvent()
local SkillEvent = RemotesInit.GetSkillEvent()
local BlockEvent = RemotesInit.GetBlockEvent()
local DashEvent = RemotesInit.GetDashEvent()

-- Safe access to sibling client managers
local PlayerScripts = LocalPlayer:WaitForChild("PlayerScripts") :: PlayerScripts

local function safeRequire(parent: Instance?, childName: string)
	if not parent then
		return nil
	end
	local child = parent:FindFirstChild(childName)
	if child and child:IsA("ModuleScript") then
		local success, result = pcall(require, child)
		if success then
			return result
		else
			warn(string.format("[CombatController] Failed to load %s: %s", childName, tostring(result)))
		end
	end
	return nil
end

-- A yielding require must not prevent keyboard listeners from being connected.
local ClientCombatCore
local ClientSkillManager
task.spawn(function()
	ClientCombatCore = safeRequire(PlayerScripts, "ClientCombatCore")
end)
task.spawn(function()
	ClientSkillManager = safeRequire(PlayerScripts, "ClientSkillManager")
end)

local function getClientSkillManager()
	return ClientSkillManager
end

local function getClientCombatCore()
	return ClientCombatCore
end

-- Shared modules
local Modules = ReplicatedStorage:WaitForChild("Modules", 5) :: Folder?
local RagdollHelper
local DamagePopup
task.spawn(function()
	RagdollHelper = safeRequire(Modules, "RagdollHelper")
end)
task.spawn(function()
	DamagePopup = safeRequire(Modules, "DamagePopup")
end)
task.spawn(function()
	safeRequire(Modules, "VFXHelper")
end)

-- Input debounces and buffering
local lastSpacePress = 0
local SPACE_RECOVERY_DEBOUNCE = 0.25

-- Checks if local player's character is eligible to perform actions
local function isCharacterAbleToAct(): (boolean, Model?, Humanoid?)
	local character = LocalPlayer.Character
	if not character or not character.Parent then
		return false, nil, nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return false, character, humanoid
	end

	if character:GetAttribute("IsRagdolled") == true then
		return false, character, humanoid
	end

	if character:GetAttribute("IsStunned") == true then
		return false, character, humanoid
	end

	return true, character, humanoid
end

-- Key & Action Handlers

local function handleM1Attack()
	local core = getClientCombatCore()
	if core and core.PerformM1 then
		core.PerformM1()
	else
		-- Direct fallback
		local canAct, character, _ = isCharacterAbleToAct()
		if canAct and character and not character:GetAttribute("IsBlocking") then
			CombatEvent:FireServer("M1", 1)
		end
	end
end

local function handleDash()
	local core = getClientCombatCore()
	if core and core.PerformDash then
		core.PerformDash()
	else
		-- Direct fallback
		local canAct, character, _ = isCharacterAbleToAct()
		if canAct and character then
			local hrp = character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local dir = if hrp then hrp.CFrame.LookVector else Vector3.new(0, 0, -1)
			DashEvent:FireServer(dir, "Front")
		end
	end
end

local function handleBlockStart()
	local core = getClientCombatCore()
	if core and core.StartBlock then
		core.StartBlock()
	else
		local canAct, character, _ = isCharacterAbleToAct()
		if canAct and character then
			character:SetAttribute("IsBlocking", true)
			BlockEvent:FireServer(true)
		end
	end
end

local function handleBlockStop()
	local character = LocalPlayer.Character
	if character then
		character:SetAttribute("IsBlocking", false)
	end

	local core = getClientCombatCore()
	if core and core.StopBlock then
		core.StopBlock()
	else
		BlockEvent:FireServer(false)
	end
end

-- UIS and CAS can report the same physical press. Deduplicate the InputObject,
-- rather than delaying a new press (including a retry after a rejected cast).
local lastSkillInputs: { [number]: InputObject } = {}
local SKILL_KEYS = {
	[Enum.KeyCode.Z] = 1,
	[Enum.KeyCode.X] = 2,
	[Enum.KeyCode.C] = 3,
	[Enum.KeyCode.V] = 4,
}
local function handleSkillKey(skillId: number, input: InputObject)
	if lastSkillInputs[skillId] == input then
		return
	end
	lastSkillInputs[skillId] = input

	local csm = getClientSkillManager()
	if csm and csm.CastSkill then
		csm.CastSkill(skillId)
	else
		-- Direct fallback
		local canAct, _, _ = isCharacterAbleToAct()
		if canAct then
			SkillEvent:FireServer("CastSkill", skillId)
		end
	end
end

local lastAwakeningPress = 0
local function handleAwakening()
	local now = os.clock()
	if now - lastAwakeningPress < 0.5 then
		return
	end
	lastAwakeningPress = now

	local csm = getClientSkillManager()
	if csm and csm.ActivateAwakening then
		csm.ActivateAwakening()
	else
		-- Direct fallback
		local character = LocalPlayer.Character
		if character then
			local rage = character:GetAttribute("Rage") or 0
			if rage >= 100 then
				SkillEvent:FireServer("Awakening")
			end
		end
	end
end

local function handleRagdollRecovery()
	local character = LocalPlayer.Character
	if not character or not character.Parent then
		return
	end

	local now = os.clock()
	if now - lastSpacePress < SPACE_RECOVERY_DEBOUNCE then
		return
	end
	lastSpacePress = now

	-- Check if player is currently in ragdoll state and touching ground
	if character:GetAttribute("IsRagdolled") == true then
		local isGrounded = false
		if RagdollHelper and RagdollHelper.IsGrounded then
			isGrounded = RagdollHelper.IsGrounded(character)
		else
			-- Fallback raycast
			local hrp = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("LowerTorso")
			if hrp and hrp:IsA("BasePart") then
				local ray = workspace:Raycast(hrp.Position, Vector3.new(0, -4.0, 0))
				isGrounded = (ray ~= nil)
			end
		end

		if isGrounded then
			CombatEvent:FireServer("RagdollRecovery")
		end
	end
end

-- Primary User Input Connections
UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
	-- If user is typing in a TextBox (e.g. Chat or custom GUI), do not trigger combat inputs
	if UserInputService:GetFocusedTextBox() ~= nil then
		return
	end

	-- Keys Z, X, C, V and G: NEVER drop or sink due to CoreGui or gameProcessed
	local skillId = SKILL_KEYS[input.KeyCode]
	if skillId then
		handleSkillKey(skillId, input)
		return
	elseif input.KeyCode == Enum.KeyCode.G then
		handleAwakening()
		return
	end

	-- For regular combat inputs (M1, Dash, Block, Space), respect gameProcessed
	if gameProcessed then
		return
	end

	-- Left Mouse Button (M1 Attack)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		handleM1Attack()

	-- Dash (Q)
	elseif input.KeyCode == Enum.KeyCode.Q then
		handleDash()

	-- Block (F - Hold)
	elseif input.KeyCode == Enum.KeyCode.F then
		handleBlockStart()

	-- Space (Ragdoll Recovery on Ground)
	elseif input.KeyCode == Enum.KeyCode.Space then
		handleRagdollRecovery()
	end
end)

UserInputService.InputEnded:Connect(function(input: InputObject)
	local skillId = SKILL_KEYS[input.KeyCode]
	if skillId then
		lastSkillInputs[skillId] = nil
	end
	-- Release Block (F)
	if input.KeyCode == Enum.KeyCode.F then
		handleBlockStop()
	end
end)

-- Window Focus Failsafe: Reset blocking and input state when window focus changes
-- (Prevents permanent block/combo freeze when clicking Studio Explorer or pressing F in Studio)
local function resetAllInputStates()
	table.clear(lastSkillInputs)
	handleBlockStop()
	local character = LocalPlayer.Character
	if character then
		character:SetAttribute("IsBlocking", false)
	end
end

UserInputService.WindowFocusReleased:Connect(resetAllInputStates)
UserInputService.WindowFocused:Connect(resetAllInputStates)

-- High-Priority ContextActionService Binding as Failsafe
local function onSkillAction(actionName: string, inputState: Enum.UserInputState, inputObject: InputObject)
	if inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel then
		local skillNum = SKILL_KEYS[inputObject.KeyCode]
		if skillNum then lastSkillInputs[skillNum] = nil end
		return Enum.ContextActionResult.Pass
	end
	if inputState == Enum.UserInputState.Begin then
		if UserInputService:GetFocusedTextBox() ~= nil then
			return Enum.ContextActionResult.Pass
		end
		local skillNum = tonumber(string.match(actionName, "(%d+)"))
		if skillNum then
			handleSkillKey(skillNum, inputObject)
			return Enum.ContextActionResult.Sink
		end
	end
	return Enum.ContextActionResult.Pass
end

for keyCode, skillId in SKILL_KEYS do
	ContextActionService:BindActionAtPriority("SkillKey_" .. skillId, onSkillAction, false, Enum.ContextActionPriority.High.Value + 100, keyCode)
end

-- Remote Event Listeners for UI / Damage popups
CombatEvent.OnClientEvent:Connect(function(action: string, data: any)
	if typeof(data) ~= "table" then
		return
	end

	if action == "HitConfirm" then
		local target = data.Target :: Model?
		local damage = data.Damage or 0
		local isCrit = data.Knockback == true
		local isBlocked = data.Blocked == true

		if target and damage > 0 and DamagePopup and DamagePopup.Spawn then
			local hrp = target:FindFirstChild("HumanoidRootPart") :: BasePart?
			if hrp then
				local color = if isBlocked
					then Color3.fromRGB(180, 180, 180)
					elseif isCrit then Color3.fromRGB(255, 170, 0)
					else Color3.fromRGB(255, 50, 50)
				local text = if isBlocked then string.format("-%d (Block)", math.floor(damage)) else string.format("-%d", math.floor(damage))
				pcall(function()
					DamagePopup.Spawn(hrp.Position, text, color)
				end)
			end
		end
	end
end)

print("[CombatController] Z/X/C/V input ready (skill-input-fix-2).")
