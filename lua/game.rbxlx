        <string name="Name">CombatServer</string>
      </Properties>
      <Item class="Script" referent="28">
        <Properties>
          <string name="Name">CombatInit</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- CombatInit.server.luau
-- Main Server Entry Script for Roblox Battleground Arena
-- Orchestrates Remotes, Player Lifecycle, HitboxManager, SkillServer,
-- RagdollServer, DestructibleManager, CooldownManager, and anti-cheat validation.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

-- Require core shared modules
local RemotesFolder = ReplicatedStorage:WaitForChild("Remotes", 5) :: Folder?
local RemotesInit = if RemotesFolder and RemotesFolder:FindFirstChild("RemotesInit") then require(RemotesFolder:WaitForChild("RemotesInit")) else require(ReplicatedStorage.Remotes.RemotesInit)

-- Initialize Remotes
RemotesInit.InitServer()
local CombatEvent = RemotesInit.GetCombatEvent()
local SkillEvent = RemotesInit.GetSkillEvent()
local BlockEvent = RemotesInit.GetBlockEvent()
local DashEvent = RemotesInit.GetDashEvent()

-- Require Server modules
local CooldownManager = require(ServerScriptService:WaitForChild("CooldownManager"))
local CharacterSetup = require(ServerScriptService:WaitForChild("CharacterSetup"))
local CombatServerFolder = ServerScriptService:WaitForChild("CombatServer") :: Folder
local HitboxManager = require(CombatServerFolder:WaitForChild("HitboxManager"))
local RagdollServer = require(CombatServerFolder:WaitForChild("RagdollServer"))

-- Safely require optional/concurrent modules with fallbacks
local ModulesFolder = ReplicatedStorage:WaitForChild("Modules", 5) :: Folder?

local function safeRequire(parent: Instance?, childName: string)
	if not parent then
		return nil
	end
	local child = parent:FindFirstChild(childName)
	if child and child:IsA("ModuleScript") then
		local success, result = pcall(require, child)
		if success then
			return result
		else
			warn(string.format("[CombatInit] Failed to load %s: %s", childName, tostring(result)))
		end
	end
	return nil
end

local MovesetData = safeRequire(ModulesFolder, "MovesetData")
local RagdollHelper = safeRequire(ModulesFolder, "RagdollHelper")
local SkillServer = safeRequire(CombatServerFolder, "SkillServer")
local DestructibleManager = safeRequire(CombatServerFolder, "DestructibleManager")

-- Anti-cheat sanity checks
local MAX_SKILL_REACH = 40.0 -- Maximum reasonable distance for non-aoe interactions

local function isCharacterAliveAndActive(character: Model?): (boolean, Humanoid?)
	if not character or not character.Parent then
		return false, nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return false, nil
	end
	if character:GetAttribute("IsRagdolled") == true then
		return false, humanoid
	end
	if character:GetAttribute("IsStunned") == true then
		return false, humanoid
	end
	return true, humanoid
end

-- Setup player character initialization
local function onCharacterAdded(player: Player, character: Instance)
	local targetModel: Model? = nil
	if CharacterSetup and CharacterSetup.RepairBrokenCharacter then
		local success, repaired = pcall(function()
			return CharacterSetup.RepairBrokenCharacter(player, character)
		end)
		if success and repaired and repaired:IsA("Model") then
			targetModel = repaired
		end
	end

	if not targetModel and character and character:IsA("Model") then
		targetModel = character
	end

	if not targetModel then
		warn("[CombatInit] Character could not be resolved as a valid Model for " .. player.Name)
		return
	end

	local humanoid = targetModel:WaitForChild("Humanoid", 10) :: Humanoid?
	local hrp = targetModel:WaitForChild("HumanoidRootPart", 10) :: BasePart?

	if not humanoid or not hrp then
		return
	end

	-- Apply Goku character appearance, rig validation, and skin
	if CharacterSetup and CharacterSetup.SetupGoku then
		pcall(function()
			CharacterSetup.SetupGoku(targetModel)
		end)
	end

	-- Configure default combat attributes
	targetModel:SetAttribute("Rage", 0)
	targetModel:SetAttribute("IsBlocking", false)
	targetModel:SetAttribute("IsStunned", false)
	targetModel:SetAttribute("IsRagdolled", false)
	targetModel:SetAttribute("iFrames", false)
	targetModel:SetAttribute("OriginalWalkSpeed", humanoid.WalkSpeed)

	-- Pre-initialize ragdoll constraints if helper available
	if RagdollHelper and RagdollHelper.SetupRig then
		pcall(function()
			RagdollHelper.SetupRig(targetModel)
		end)
	end

	-- Cleanup on humanoid death
	humanoid.Died:Connect(function()
		targetModel:SetAttribute("IsBlocking", false)
		targetModel:SetAttribute("IsStunned", false)
		targetModel:SetAttribute("iFrames", false)
		CooldownManager.ResetAll(player)
	end)
end

local function onPlayerAdded(player: Player)
	if player.Character then
		task.spawn(onCharacterAdded, player, player.Character)
	end
	player.CharacterAdded:Connect(function(char)
		onCharacterAdded(player, char)
	end)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	CooldownManager.OnPlayerRemoving(player)
end)

-- Execute Awakening Transformation Sequence
local function handleAwakening(player: Player)
	local character = player.Character
	local canAct, humanoid = isCharacterAliveAndActive(character)
	if not canAct or not character or not humanoid then
		return
	end

	-- Check Rage requirement
	local currentRage = character:GetAttribute("Rage") or 0
	if currentRage < 100 then
		return -- Not enough rage
	end

	-- Check Awakening cooldown
	if CooldownManager.IsOnCooldown(player, "Awakening") then
		return
	end

	-- If SkillServer provides custom Awakening logic, delegate to it
	if SkillServer and SkillServer.ExecuteAwakening then
		local success, handled = pcall(function()
			return SkillServer.ExecuteAwakening(player)
		end)
		if success and handled then
			return
		end
	end

	-- Default authoritative Awakening execution:
	character:SetAttribute("IsAwakened", true)
	character:SetAttribute("Rage", 0)
	CooldownManager.SetAwakening(player, true, 0.30)

	local origSpeed = character:GetAttribute("OriginalWalkSpeed") or 16
	humanoid.WalkSpeed = 24.0 -- Speed buff in Awakening

	-- Notify all clients
	SkillEvent:FireAllClients("AwakeningState", {
		Player = player,
		Character = character,
		Active = true,
		Duration = 30.0,
	})

	-- Awakening duration timer (30 seconds)
	task.delay(30.0, function()
		if player and player.Parent and character and character.Parent then
			character:SetAttribute("IsAwakened", false)
			CooldownManager.SetAwakening(player, false)
			local currentHumanoid = character:FindFirstChildOfClass("Humanoid")
			if currentHumanoid and currentHumanoid.Health > 0 and not character:GetAttribute("IsStunned") then
				currentHumanoid.WalkSpeed = origSpeed
			end

			-- Set 60s cooldown on re-awakening
			CooldownManager.SetCooldown(player, "Awakening", 60.0)

			SkillEvent:FireAllClients("AwakeningState", {
				Player = player,
				Character = character,
				Active = false,
			})
		end
	end)
end

-- Handle Skill Cast Request
local function handleSkillCast(player: Player, skillId: number)
	if typeof(skillId) ~= "number" or skillId < 1 or skillId > 4 then
		return
	end

	local character = player.Character
	local canAct, _ = isCharacterAliveAndActive(character)
	if not canAct or not character then
		return
	end

	local skillKey = "Skill_" .. tostring(skillId)
	if CooldownManager.IsOnCooldown(player, skillKey) then
		return
	end

	-- Delegate to SkillServer if available
	if SkillServer and SkillServer.ExecuteSkill then
		local success, handled = pcall(function()
			return SkillServer.ExecuteSkill(player, skillId)
		end)
		if success and handled then
			return
		end
	end

	-- Fallback server skill handler using MovesetData
	if MovesetData then
		local isAwakened = CooldownManager.IsAwakened(player)
		local skillConfig = MovesetData.GetSkill(skillId, isAwakened)
		if skillConfig then
			-- Apply cooldown
			local cd = CooldownManager.SetCooldown(player, skillKey, skillConfig.Cooldown)

			-- Notify clients for cooldown HUD and VFX
			SkillEvent:FireAllClients("SkillFired", {
				Player = player,
				Character = character,
				SkillId = skillId,
				SkillName = skillConfig.Name,
				Cooldown = cd,
				IsAwakened = isAwakened,
			})

			-- Destructible integration on AOE skills
			if skillConfig.DestroysEnvironment and DestructibleManager and DestructibleManager.ExplodeGround then
				local hrp = character:FindFirstChild("HumanoidRootPart") :: BasePart?
				if hrp then
					pcall(function()
						DestructibleManager.ExplodeGround(hrp.Position, skillConfig.AoeRadius or 18, 50)
					end)
				end
			end
		end
	end
end

-- Initialize CharacterSetup
if CharacterSetup and CharacterSetup.Init then
	pcall(function()
		CharacterSetup.Init()
	end)
end

-- SkillServer is the authoritative handler for SkillEvent (CastSkill and Awakening).
-- Ensure SkillServer is initialized if not already running.
if SkillServer and SkillServer.Init then
	pcall(function()
		SkillServer.Init()
	end)
end

-- Destructible Manager initialization if applicable
if DestructibleManager and DestructibleManager.Init then
	pcall(function()
		DestructibleManager.Init()
	end)
end

print("[CombatInit] Server combat architecture initialized successfully.")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">DestructibleManager</string>
          <string name="Source"><![CDATA[--!strict
-- DestructibleManager.luau
-- Server-side Destructible Environment Engine for Roblox Battleground Arena
-- ("The Strongest Battlegrounds" style)
--
-- Features:
-- - BreakPillar / BreakObstacle: Fractures structures into physical unanchored debris parts
--   with randomized angular and linear velocity impulses and dust/shatter VFX.
-- - ExplodeGround: Procedurally fractures ground around impact point, launching stone shards into the air.
-- - BreakInRadius: AOE destruction for Skill 3 Ground Slam, Awakening Serious Punch, and heavy impacts.
-- - DamageDestructible: Health/durability system on destructibles with chipping feedback.
-- - Ragdoll Impact detection: Characters colliding with obstacles at high speed shatter them.
-- - Auto-Cleanup: Smoothly fades out debris shards after lifetime (8-10 seconds).
-- - Continuous Arena Respawn: Automatically restores destroyed structures after timer (15-25 seconds).

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

type DestructibleRecord = {
	Instance: BasePart,
	OriginalCFrame: CFrame,
	OriginalSize: Vector3,
	OriginalMaterial: Enum.Material,
	OriginalColor: Color3,
	OriginalTransparency: number,
	OriginalCanCollide: boolean,
	OriginalParent: Instance,
	MaxHealth: number,
	RespawnTime: number,
	RespawnAt: number,
	IsDestroyed: boolean,
}

local DestructibleManager = {}

-- Engine Configuration
DestructibleManager.Config = {
	DefaultDebrisLifetime = 8.0, -- seconds before debris fades out and is destroyed
	DefaultRespawnTime = 20.0, -- seconds before destroyed obstacle respawns
	DefaultDebrisCount = 12, -- number of physical fragments per fractured pillar
	DebrisFadeDuration = 1.2, -- fade-out tween duration
	MinCutDimension = 1.8, -- minimum stud size for a debris shard
	GroundShardCount = 10, -- number of rock shards generated by ExplodeGround
	GroundShardLifetime = 5.5,
	DefaultImpactForce = 55.0,
}

local registeredDestructibles: { [BasePart]: DestructibleRecord } = {}
local respawnQueue: { DestructibleRecord } = {}
local debrisFolder: Folder? = nil
local isInitialized = false

-- Ensures a dedicated Debris folder exists in Workspace
local function getDebrisFolder(): Folder
	if debrisFolder and debrisFolder.Parent then
		return debrisFolder
	end

	local existing = workspace:FindFirstChild("BattlegroundDebris")
	if existing and existing:IsA("Folder") then
		debrisFolder = existing
		return existing
	end

	local newFolder = Instance.new("Folder")
	newFolder.Name = "BattlegroundDebris"
	newFolder.Parent = workspace
	debrisFolder = newFolder
	return newFolder
end

-- Creates anime dust puff particle emitter at a world position
local function spawnDustEffect(position: Vector3, particleCount: number?, tintColor: Color3?)
	local count = particleCount or 25
	local color = tintColor or Color3.fromRGB(190, 185, 175)

	local attachment = Instance.new("Attachment")
	attachment.WorldPosition = position
	attachment.Parent = workspace.Terrain

	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "DestructibleDust"
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 0.1
	emitter.LightInfluence = 0.8
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1.2),
		NumberSequenceKeypoint.new(0.5, 4.0),
		NumberSequenceKeypoint.new(1.0, 6.5),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.35),
		NumberSequenceKeypoint.new(0.7, 0.65),
		NumberSequenceKeypoint.new(1.0, 1.0),
	})
	emitter.Lifetime = NumberRange.new(0.6, 1.2)
	emitter.Rate = 0
	emitter.Speed = NumberRange.new(10, 24)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Drag = 3.5
	emitter.VelocityInheritance = 0.2
	emitter.Parent = attachment

	-- Emit burst immediately
	emitter:Emit(count)

	-- Auto-cleanup attachment after particles expire
	task.delay(1.5, function()
		attachment:Destroy()
	end)
end

-- Creates an expanding ground shockwave ring
local function spawnGroundShockwave(center: Vector3, radius: number)
	local shockwave = Instance.new("Part")
	shockwave.Name = "GroundShockwave"
	shockwave.Shape = Enum.PartType.Cylinder
	shockwave.Size = Vector3.new(0.4, 2.0, 2.0)
	-- Orient cylinder flat on the ground (Cylinder height aligns along X axis)
	shockwave.CFrame = CFrame.new(center.X, center.Y + 0.2, center.Z) * CFrame.Angles(0, 0, math.rad(90))
	shockwave.Material = Enum.Material.Neon
	shockwave.Color = Color3.fromRGB(220, 210, 195)
	shockwave.Transparency = 0.3
	shockwave.Anchored = true
	shockwave.CanCollide = false
	shockwave.CastShadow = false
	shockwave.Parent = getDebrisFolder()

	local targetSize = Vector3.new(0.2, radius * 2.2, radius * 2.2)
	local tweenInfo = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local tween = TweenService:Create(shockwave, tweenInfo, {
		Size = targetSize,
		Transparency = 1.0,
	})
	tween:Play()
	tween.Completed:Connect(function()
		shockwave:Destroy()
	end)
end

-- Plays rock crumble / shatter sound at position
local function playShatterSound(position: Vector3)
	local soundPart = Instance.new("Part")
	soundPart.Name = "ShatterAudioEmitter"
	soundPart.Size = Vector3.new(0.5, 0.5, 0.5)
	soundPart.CFrame = CFrame.new(position)
	soundPart.Anchored = true
	soundPart.CanCollide = false
	soundPart.Transparency = 1
	soundPart.Parent = getDebrisFolder()

	local sound = Instance.new("Sound")
	sound.SoundId = "rbxassetid://138090596" -- Heavy stone impact / shatter SFX
	sound.Volume = 1.2
	sound.PlaybackSpeed = math.random(85, 115) / 100
	sound.RollOffMaxDistance = 150
	sound.Parent = soundPart
	sound:Play()

	sound.Ended:Connect(function()
		soundPart:Destroy()
	end)

	-- Fallback timeout
	task.delay(3.0, function()
		if soundPart and soundPart.Parent then
			soundPart:Destroy()
		end
	end)
end

-- Registers a destructible part and caches its baseline transform
local function registerPart(part: BasePart): DestructibleRecord
	local existing = registeredDestructibles[part]
	if existing then
		return existing
	end

	local maxHealth = part:GetAttribute("MaxHealth")
	if not maxHealth or typeof(maxHealth) ~= "number" then
		maxHealth = 100
		part:SetAttribute("MaxHealth", maxHealth)
	end

	local currentHealth = part:GetAttribute("CurrentHealth")
	if not currentHealth or typeof(currentHealth) ~= "number" then
		currentHealth = maxHealth
		part:SetAttribute("CurrentHealth", currentHealth)
	end

	local respawnTime = part:GetAttribute("RespawnTime")
	if not respawnTime or typeof(respawnTime) ~= "number" then
		respawnTime = DestructibleManager.Config.DefaultRespawnTime
		part:SetAttribute("RespawnTime", respawnTime)
	end

	local record: DestructibleRecord = {
		Instance = part,
		OriginalCFrame = part.CFrame,
		OriginalSize = part.Size,
		OriginalMaterial = part.Material,
		OriginalColor = part.Color,
		OriginalTransparency = part.Transparency,
		OriginalCanCollide = part.CanCollide,
		OriginalParent = part.Parent or workspace,
		MaxHealth = maxHealth,
		RespawnTime = respawnTime,
		RespawnAt = 0,
		IsDestroyed = false,
	}

	registeredDestructibles[part] = record
	return record
end

-- Finds the root BasePart for a destructible (handles direct part or Model)
local function resolveDestructiblePart(instance: Instance): BasePart?
	if instance:IsA("BasePart") then
		if CollectionService:HasTag(instance, "Destructible") or registeredDestructibles[instance] then
			return instance
		end
		-- Check parent model
		if instance.Parent and CollectionService:HasTag(instance.Parent, "Destructible") then
			-- If parent model is tagged, use the hit part or primary part
			return instance
		end
	elseif instance:IsA("Model") then
		local primary = instance.PrimaryPart or instance:FindFirstChildWhichIsA("BasePart")
		return primary
	end
	return nil
end

-- Subdivides a BasePart into multiple unanchored physical debris shards with impulses
local function fracturePartIntoDebris(part: BasePart, impactPos: Vector3, impactForce: number)
	local container = getDebrisFolder()
	local partSize = part.Size
	local partCFrame = part.CFrame

	-- Determine subdivision grid (e.g. 2 x 3 x 2 = 12 shards)
	local cutsX = math.max(1, math.floor(partSize.X / 3.0))
	local cutsY = math.max(1, math.floor(partSize.Y / 3.5))
	local cutsZ = math.max(1, math.floor(partSize.Z / 3.0))

	-- Clamp total shards between 6 and 18 for high physics fidelity without lag
	cutsX = math.clamp(cutsX, 2, 3)
	cutsY = math.clamp(cutsY, 2, 4)
	cutsZ = math.clamp(cutsZ, 2, 3)

	local shardSizeX = partSize.X / cutsX
	local shardSizeY = partSize.Y / cutsY
	local shardSizeZ = partSize.Z / cutsZ

	local debrisList: { BasePart } = {}

	for ix = 1, cutsX do
		for iy = 1, cutsY do
			for iz = 1, cutsZ do
				-- Calculate local offset with slight organic jitter (+-15%)
				local jitterX = (math.random(-15, 15) / 100) * shardSizeX
				local jitterY = (math.random(-15, 15) / 100) * shardSizeY
				local jitterZ = (math.random(-15, 15) / 100) * shardSizeZ

				local localOffset = Vector3.new(
					-partSize.X / 2 + shardSizeX * (ix - 0.5) + jitterX,
					-partSize.Y / 2 + shardSizeY * (iy - 0.5) + jitterY,
					-partSize.Z / 2 + shardSizeZ * (iz - 0.5) + jitterZ
				)

				local worldPos = partCFrame:PointToWorldSpace(localOffset)

				-- Build shard part
				local shard = Instance.new("Part")
				shard.Name = "DebrisShard"
				shard.Size = Vector3.new(
					math.max(DestructibleManager.Config.MinCutDimension, shardSizeX * (math.random(85, 115) / 100)),
					math.max(DestructibleManager.Config.MinCutDimension, shardSizeY * (math.random(85, 115) / 100)),
					math.max(DestructibleManager.Config.MinCutDimension, shardSizeZ * (math.random(85, 115) / 100))
				)
				shard.CFrame = CFrame.new(worldPos) * CFrame.Angles(
					math.rad(math.random(-25, 25)),
					math.rad(math.random(-180, 180)),
					math.rad(math.random(-25, 25))
				)
				shard.Material = part.Material
				shard.Color = part.Color
				shard.Anchored = false
				shard.CanCollide = true
				shard.Massless = false
				shard.CastShadow = true
				shard.Parent = container

				-- Compute outward explosive impulse direction
				local burstDir = (worldPos - impactPos)
				if burstDir.Magnitude < 0.1 then
					burstDir = Vector3.new(math.random(-10, 10), math.random(5, 15), math.random(-10, 10)).Unit
				else
					burstDir = burstDir.Unit
				end

				-- Upward lift & radial velocity
				local lift = math.random(18, 42)
				local radialSpeed = math.random(25, 60) * (impactForce / 50.0)
				local velocity = (burstDir * radialSpeed) + Vector3.new(0, lift, 0)
				local angularVelocity = Vector3.new(
					math.random(-15, 15),
					math.random(-15, 15),
					math.random(-15, 15)
				)

				shard.AssemblyLinearVelocity = velocity
				shard.AssemblyAngularVelocity = angularVelocity

				-- Apply impulse directly to physics engine if supported
				pcall(function()
					shard:ApplyImpulse(velocity * shard:GetMass() * 0.5)
				end)

				table.insert(debrisList, shard)
			end
		end
	end

	-- Schedule smooth fade-out and destruction for all debris shards
	local lifetime = DestructibleManager.Config.DefaultDebrisLifetime
	task.delay(lifetime, function()
		for _, shard in ipairs(debrisList) do
			if shard and shard.Parent then
				local fadeTween = TweenService:Create(
					shard,
					TweenInfo.new(DestructibleManager.Config.DebrisFadeDuration, Enum.EasingStyle.Linear),
					{ Transparency = 1.0 }
				)
				fadeTween:Play()
				fadeTween.Completed:Connect(function()
					shard:Destroy()
				end)
			end
		end
	end)
end

-- =========================================================================
-- PUBLIC API METHODS
-- =========================================================================

-- Slices or breaks the structure into multiple smaller physical debris parts
-- Applies radial/angular impulses, dust particles, and manages respawn queue
function DestructibleManager.BreakPillar(modelOrPart: Instance, impactPoint: Vector3?, impactForce: number?)
	local part = resolveDestructiblePart(modelOrPart)
	if not part then
		return
	end

	local record = registeredDestructibles[part] or registerPart(part)
	if record.IsDestroyed then
		return -- Already broken, awaiting respawn
	end

	record.IsDestroyed = true
	record.RespawnAt = os.clock() + record.RespawnTime
	table.insert(respawnQueue, record)

	local center = part.Position
	local hitPos = impactPoint or center
	local force = impactForce or DestructibleManager.Config.DefaultImpactForce

	-- 1. Fracture into physics debris shards
	fracturePartIntoDebris(part, hitPos, force)

	-- 2. Spawn Dust & Sound VFX
	spawnDustEffect(hitPos, 30, part.Color)
	playShatterSound(hitPos)

	-- 3. Hide intact obstacle (prevent collision and interaction while awaiting respawn)
	part.Transparency = 1.0
	part.CanCollide = false

	-- If part is inside a Model with other parts/decals, hide children as well
	if part.Parent and part.Parent:IsA("Model") and part.Parent.Name ~= "Workspace" then
		for _, child in ipairs(part.Parent:GetDescendants()) do
			if child:IsA("BasePart") then
				child.Transparency = 1.0
				child.CanCollide = false
			elseif child:IsA("Decal") or child:IsA("Texture") then
				child.Transparency = 1.0
			end
		end
	end
end

-- Fractures ground around centerPos (Skill 3 Ground Slam, Heavy Punch impact)
-- Spawns unanchored flying stone shards into the air
function DestructibleManager.ExplodeGround(centerPos: Vector3, radius: number?, force: number?)
	local rad = radius or 16.0
	local blastForce = force or DestructibleManager.Config.DefaultImpactForce
	local container = getDebrisFolder()

	-- 1. Visual shockwave & dust burst
	spawnGroundShockwave(centerPos, rad)
	spawnDustEffect(centerPos, 35, Color3.fromRGB(160, 155, 145))
	playShatterSound(centerPos)

	-- 2. Procedural flying rock shards
	local shardCount = DestructibleManager.Config.GroundShardCount
	local groundShards: { BasePart } = {}

	for i = 1, shardCount do
		local angle = (i / shardCount) * (2 * math.pi) + math.random(-15, 15) / 100
		local dist = math.random(30, math.floor(rad * 85)) / 100
		local offset = Vector3.new(math.cos(angle) * dist, 0.2, math.sin(angle) * dist)
		local spawnPos = centerPos + offset

		local rock = Instance.new("Part")
		rock.Name = "GroundRockShard"
		rock.Size = Vector3.new(
			math.random(15, 32) / 10,
			math.random(15, 25) / 10,
			math.random(15, 32) / 10
		)
		rock.CFrame = CFrame.new(spawnPos) * CFrame.Angles(
			math.rad(math.random(-180, 180)),
			math.rad(math.random(-180, 180)),
			math.rad(math.random(-180, 180))
		)
		rock.Material = Enum.Material.Slate
		rock.Color = Color3.fromRGB(85, 90, 100)
		rock.Anchored = false
		rock.CanCollide = true
		rock.Massless = false
		rock.Parent = container

		-- Radial explosion impulse away from center + strong upward lift
		local radialDir = Vector3.new(offset.X, 0, offset.Z).Unit
		if radialDir.Magnitude < 0.1 then
			radialDir = Vector3.new(math.random(-10, 10), 0, math.random(-10, 10)).Unit
		end

		local horizontalSpeed = math.random(20, 50) * (blastForce / 50.0)
		local upwardSpeed = math.random(32, 65) * (blastForce / 50.0)
		local velocity = (radialDir * horizontalSpeed) + Vector3.new(0, upwardSpeed, 0)
		local angularVelocity = Vector3.new(
			math.random(-25, 25),
			math.random(-25, 25),
			math.random(-25, 25)
		)

		rock.AssemblyLinearVelocity = velocity
		rock.AssemblyAngularVelocity = angularVelocity

		table.insert(groundShards, rock)
	end

	-- Auto-cleanup ground rock shards
	task.delay(DestructibleManager.Config.GroundShardLifetime, function()
		for _, rock in ipairs(groundShards) do
			if rock and rock.Parent then
				local fadeTween = TweenService:Create(
					rock,
					TweenInfo.new(1.0, Enum.EasingStyle.Linear),
					{ Transparency = 1.0 }
				)
				fadeTween:Play()
				fadeTween.Completed:Connect(function()
					rock:Destroy()
				end)
			end
		end
	end)
end

-- Interoperability contract method required by PROJECT.md & HitboxManager.luau
-- Handles BreakObstacle(hitPart, impactVelocity, aoeRadius)
function DestructibleManager.BreakObstacle(hitPart: Instance, impactVelocity: any, aoeRadius: number?)
	local force = DestructibleManager.Config.DefaultImpactForce
	local hitPoint: Vector3? = nil

	if typeof(impactVelocity) == "Vector3" then
		force = math.clamp(impactVelocity.Magnitude, 30, 120)
	elseif typeof(impactVelocity) == "number" then
		force = impactVelocity
	end

	if hitPart:IsA("BasePart") then
		hitPoint = hitPart.Position
	end

	-- 1. Break the hit obstacle if destructible
	local part = resolveDestructiblePart(hitPart)
	if part then
		DestructibleManager.BreakPillar(part, hitPoint, force)
	end

	-- 2. If AOE radius is specified, break nearby obstacles and fracture ground
	if aoeRadius and aoeRadius > 0 and hitPoint then
		DestructibleManager.BreakInRadius(hitPoint, aoeRadius, force)
	end
end

-- Destroys all destructibles within a spatial radius around centerPos
function DestructibleManager.BreakInRadius(centerPos: Vector3, radius: number, force: number?)
	local blastForce = force or DestructibleManager.Config.DefaultImpactForce

	-- 1. Trigger ground explosion visual & shards
	DestructibleManager.ExplodeGround(centerPos, radius, blastForce)

	-- 2. Search for registered and tagged destructibles within distance
	for _, part in ipairs(CollectionService:GetTagged("Destructible")) do
		if part:IsA("BasePart") then
			local dist = (part.Position - centerPos).Magnitude
			if dist <= radius then
				DestructibleManager.BreakPillar(part, centerPos, blastForce)
			end
		elseif part:IsA("Model") then
			local primary = part.PrimaryPart or part:FindFirstChildWhichIsA("BasePart")
			if primary and (primary.Position - centerPos).Magnitude <= radius then
				DestructibleManager.BreakPillar(part, centerPos, blastForce)
			end
		end
	end
end

-- Breaks all destructibles within an oriented bounding box corridor (e.g. Heavy Punch, Kamehameha blast)
function DestructibleManager.BreakObstaclesInBox(boxCFrame: CFrame, boxSize: Vector3, impulse: Vector3?)
	local blastForce = impulse and impulse.Magnitude or DestructibleManager.Config.DefaultImpactForce
	local halfX = boxSize.X / 2
	local halfY = boxSize.Y / 2
	local halfZ = boxSize.Z / 2
	local centerPos = boxCFrame.Position

	-- 1. Explode ground shockwave along the blast corridor
	DestructibleManager.ExplodeGround(centerPos, math.max(boxSize.X, boxSize.Z) * 0.5, blastForce)

	-- 2. Precise 3D OBB intersection test for all registered & tagged destructibles
	for _, inst in ipairs(CollectionService:GetTagged("Destructible")) do
		local part: BasePart? = nil
		if inst:IsA("BasePart") then
			part = inst
		elseif inst:IsA("Model") then
			part = inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart")
		end

		if part then
			local rel = boxCFrame:PointToObjectSpace(part.Position)
			local marginX = part.Size.X / 2
			local marginY = part.Size.Y / 2
			local marginZ = part.Size.Z / 2

			if math.abs(rel.X) <= (halfX + marginX)
				and math.abs(rel.Y) <= (halfY + marginY)
				and math.abs(rel.Z) <= (halfZ + marginZ) then
				DestructibleManager.BreakPillar(part, part.Position, blastForce)
			end
		end
	end
end

-- Decrements health on a destructible, triggering break if depleted
function DestructibleManager.DamageDestructible(
	target: Instance,
	damage: number,
	impactPoint: Vector3?,
	impactVelocity: Vector3?
): boolean
	local part = resolveDestructiblePart(target)
	if not part then
		return false
	end

	local record = registeredDestructibles[part] or registerPart(part)
	if record.IsDestroyed then
		return false
	end

	local currentHealth = part:GetAttribute("CurrentHealth") or record.MaxHealth
	local newHealth = math.max(0, currentHealth - damage)
	part:SetAttribute("CurrentHealth", newHealth)

	local hitPos = impactPoint or part.Position
	local force = impactVelocity and impactVelocity.Magnitude or DestructibleManager.Config.DefaultImpactForce

	if newHealth <= 0 then
		DestructibleManager.BreakPillar(part, hitPos, force)
		return true
	else
		-- Chipping feedback: spawn minor dust and small rock chips
		spawnDustEffect(hitPos, 8, part.Color)
		return false
	end
end

-- Checks whether a ragdolled or knocked-back character has collided with a destructible
function DestructibleManager.CheckRagdollImpact(character: Model, hitPart: BasePart, hitVelocity: Vector3)
	if not hitPart or not hitPart.Parent then
		return
	end

	local speed = hitVelocity.Magnitude
	if speed < 35.0 then
		return -- Below wall splat / destructible fracture threshold
	end

	local isDestructible = CollectionService:HasTag(hitPart, "Destructible")
		or (hitPart.Parent and CollectionService:HasTag(hitPart.Parent, "Destructible"))
		or registeredDestructibles[hitPart] ~= nil

	if isDestructible then
		-- Heavy impact shatters the destructible
		local impactDamage = math.floor(speed * 1.5)
		DestructibleManager.DamageDestructible(hitPart, impactDamage, hitPart.Position, hitVelocity)
	end
end

-- Respawns a previously destroyed structure back to pristine condition
local function respawnRecord(record: DestructibleRecord)
	local part = record.Instance
	if not part or not part.Parent then
		return
	end

	record.IsDestroyed = false
	part.CFrame = record.OriginalCFrame
	part.Size = record.OriginalSize
	part.Material = record.OriginalMaterial
	part.Color = record.OriginalColor
	part.Transparency = record.OriginalTransparency
	part.CanCollide = record.OriginalCanCollide
	part:SetAttribute("CurrentHealth", record.MaxHealth)

	-- If model, restore child parts
	if part.Parent and part.Parent:IsA("Model") and part.Parent.Name ~= "Workspace" then
		for _, child in ipairs(part.Parent:GetDescendants()) do
			if child:IsA("BasePart") then
				child.Transparency = record.OriginalTransparency
				child.CanCollide = record.OriginalCanCollide
			elseif child:IsA("Decal") or child:IsA("Texture") then
				child.Transparency = 0
			end
		end
	end

	-- Rebuild dust puff effect
	spawnDustEffect(part.Position, 20, record.OriginalColor)
end

-- Resets all destructibles immediately (useful for testing or match restarts)
function DestructibleManager.ResetAll()
	for _, record in pairs(registeredDestructibles) do
		respawnRecord(record)
	end
	table.clear(respawnQueue)

	local folder = debrisFolder or workspace:FindFirstChild("BattlegroundDebris")
	if folder then
		folder:ClearAllChildren()
	end
end

-- Initializes DestructibleManager listeners and the continuous respawn cycle
function DestructibleManager.Init()
	if isInitialized then
		return
	end
	isInitialized = true

	getDebrisFolder()

	-- Index existing destructibles tagged in Workspace
	for _, inst in ipairs(CollectionService:GetTagged("Destructible")) do
		if inst:IsA("BasePart") then
			registerPart(inst)
		elseif inst:IsA("Model") then
			for _, child in ipairs(inst:GetDescendants()) do
				if child:IsA("BasePart") then
					registerPart(child)
				end
			end
		end
	end

	-- Listen for dynamically added destructibles
	CollectionService:GetInstanceAddedSignal("Destructible"):Connect(function(inst: Instance)
		if inst:IsA("BasePart") then
			registerPart(inst)
		elseif inst:IsA("Model") then
			for _, child in ipairs(inst:GetDescendants()) do
				if child:IsA("BasePart") then
					registerPart(child)
				end
			end
		end
	end)

	-- Start continuous respawn check loop (checks every 0.5s)
	task.spawn(function()
		while true do
			task.wait(0.5)
			local now = os.clock()
			local i = 1
			while i <= #respawnQueue do
				local record = respawnQueue[i]
				if now >= record.RespawnAt then
					respawnRecord(record)
					table.remove(respawnQueue, i)
				else
					i = i + 1
				end
			end
		end
	end)
end

return DestructibleManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">HitboxManager</string>
          <string name="Source"><![CDATA[--!strict
-- HitboxManager.luau
-- Server authority for spatial hitbox verification, M1 combo progression,
-- Block & Guard Break evaluation, Ragdoll knockdown, and Wall Splat mechanics.

local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local CombatConfig = require(Modules:WaitForChild("CombatConfig"))
local AnimationManager = require(Modules:WaitForChild("AnimationManager"))
local RagdollHelper = require(Modules:WaitForChild("RagdollHelper"))
local RagdollServer = require(script.Parent.RagdollServer)

type PlayerCombatState = {
	ComboStep: number,
	LastAttackTime: number,
	LastDashTime: number,
	IsAttacking: boolean,
	DashCancelActive: boolean,
}

local HitboxManager = {}
local combatStates: { [Player]: PlayerCombatState } = {}

-- Ensure Remotes folder and events exist
local function ensureRemotes(): Folder
	local remotes = ReplicatedStorage:FindFirstChild("Remotes") :: Folder?
	if not remotes then
		remotes = Instance.new("Folder")
		remotes.Name = "Remotes"
		remotes.Parent = ReplicatedStorage
	end

	local neededEvents = { "CombatEvent", "BlockEvent", "DashEvent", "SkillEvent" }
	for _, eventName in neededEvents do
		if not remotes:FindFirstChild(eventName) then
			local event = Instance.new("RemoteEvent")
			event.Name = eventName
			event.Parent = remotes
		end
	end

	return remotes
end

local Remotes = ensureRemotes()
local CombatEvent = Remotes:WaitForChild("CombatEvent") :: RemoteEvent
local BlockEvent = Remotes:WaitForChild("BlockEvent") :: RemoteEvent
local DashEvent = Remotes:WaitForChild("DashEvent") :: RemoteEvent

-- Safely retrieves DestructibleManager if initialized by Agent 4
local function getDestructibleManager()
	local combatServerFolder = ServerScriptService:FindFirstChild("CombatServer")
	if combatServerFolder then
		local destModule = combatServerFolder:FindFirstChild("DestructibleManager")
		if destModule and destModule:IsA("ModuleScript") then
			local success, res = pcall(require, destModule)
			if success then
				return res
			end
		end
	end
	return nil
end

-- Retrieves or initializes player combat state
local function getState(player: Player): PlayerCombatState
	local state = combatStates[player]
	if not state then
		state = {
			ComboStep = 1,
			LastAttackTime = 0,
			LastDashTime = 0,
			IsAttacking = false,
			DashCancelActive = false,
		}
		combatStates[player] = state
	end
	return state
end

-- Checks if a character is under crowd control (hitstun, ragdoll, etc.)
function HitboxManager.IsDisabled(character: Model): boolean
	if not character or not character.Parent then
		return true
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return true
	end
	if character:GetAttribute("IsRagdolled") == true then
		return true
	end
	if character:GetAttribute("IsStunned") == true then
		return true
	end
	return false
end

-- Applies hitstun to a character for a duration
function HitboxManager.ApplyHitstun(targetChar: Model, duration: number)
	local humanoid = targetChar:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return
	end

	targetChar:SetAttribute("IsStunned", true)
	local origWalkSpeed = targetChar:GetAttribute("OriginalWalkSpeed")
	if not origWalkSpeed then
		targetChar:SetAttribute("OriginalWalkSpeed", humanoid.WalkSpeed)
	end

	humanoid.WalkSpeed = 0
	humanoid.JumpPower = 0

	task.delay(duration, function()
		if targetChar and targetChar.Parent and not RagdollHelper.IsRagdolled(targetChar) then
			targetChar:SetAttribute("IsStunned", false)
			local restoredSpeed = targetChar:GetAttribute("OriginalWalkSpeed") or 16
			humanoid.WalkSpeed = restoredSpeed
			humanoid.JumpPower = 50
		end
	end)
end

-- Applies damage and updates Ultimate / Rage meter
function HitboxManager.ApplyDamage(attackerChar: Model, targetChar: Model, damage: number)
	local humanoid = targetChar:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return
	end

	humanoid:TakeDamage(damage)

	-- Rage building
	local attackerRage = attackerChar:GetAttribute("Rage") or 0
	attackerChar:SetAttribute("Rage", math.clamp(attackerRage + CombatConfig.RageGainOnHit, 0, 100))

	local targetRage = targetChar:GetAttribute("Rage") or 0
	targetChar:SetAttribute("Rage", math.clamp(targetRage + CombatConfig.RageGainOnDamageTaken, 0, 100))
end

-- Evaluates whether a target is blocking an incoming attack (angle & guard break)
function HitboxManager.EvaluateBlock(attackerChar: Model, targetChar: Model, isGuardBreakAttack: boolean): (boolean, boolean)
	local isBlocking = targetChar:GetAttribute("IsBlocking") == true
	if not isBlocking then
		return false, false -- Not blocking
	end

	local attackerHRP = attackerChar:FindFirstChild("HumanoidRootPart") :: BasePart?
	local targetHRP = targetChar:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not attackerHRP or not targetHRP then
		return false, false
	end

	-- Angle calculation between target's front and attacker direction
	local targetLook = targetHRP.CFrame.LookVector
	local toAttacker = (attackerHRP.Position - targetHRP.Position)
	local flatToAttacker = Vector3.new(toAttacker.X, 0, toAttacker.Z)
	if flatToAttacker.Magnitude < 0.1 then
		return true, isGuardBreakAttack
	end
	flatToAttacker = flatToAttacker.Unit

	local dot = targetLook:Dot(flatToAttacker)
	local angle = math.acos(math.clamp(dot, -1, 1))

	if angle > CombatConfig.MaxBlockAngle then
		-- Back hit! Block bypassed
		return false, false
	end

	-- Frontal block succeeded
	if isGuardBreakAttack then
		-- Guard Broken!
		targetChar:SetAttribute("IsBlocking", false)
		HitboxManager.ApplyHitstun(targetChar, CombatConfig.GuardBreakStun)
		BlockEvent:FireAllClients(targetChar, false, true)
		return true, true -- wasBlocking = true, guardBroken = true
	end

	return true, false -- wasBlocking = true, guardBroken = false
end

-- Checks for wall splat along knockback path
function HitboxManager.CheckWallSplat(targetChar: Model, knockbackVelocity: Vector3)
	local targetHRP = targetChar:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not targetHRP then
		return
	end

	local flatVel = Vector3.new(knockbackVelocity.X, 0, knockbackVelocity.Z)
	if flatVel.Magnitude < CombatConfig.WallSplatThresholdVelocity then
		return
	end

	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	raycastParams.FilterDescendantsInstances = { targetChar }
	raycastParams.IgnoreWater = true

	local dir = flatVel.Unit * CombatConfig.WallSplatRaycastDistance

	-- Perform check over a short duration during knockback flight
	task.spawn(function()
		local startTime = os.clock()
		while os.clock() - startTime < 0.6 do
			if not targetHRP or not targetHRP.Parent then
				break
			end

			local rayResult = Workspace:Raycast(targetHRP.Position, dir, raycastParams)
			if rayResult and rayResult.Instance then
				local normal = rayResult.Normal
				-- Check if surface is vertical (wall)
				if math.abs(normal.Y) <= CombatConfig.WallSplatMaxVerticalAngle then
					-- Wall Splat confirmed!
					targetHRP.AssemblyLinearVelocity = Vector3.zero
					targetHRP.AssemblyAngularVelocity = Vector3.zero
					targetHRP.CFrame = CFrame.lookAt(rayResult.Position + normal * 1.5, rayResult.Position + normal * 5.0)

					-- Deal wall splat impact damage & stun
					local humanoid = targetChar:FindFirstChildOfClass("Humanoid")
					if humanoid then
						humanoid:TakeDamage(CombatConfig.WallSplatDamage)
					end
					HitboxManager.ApplyHitstun(targetChar, CombatConfig.WallSplatStunDuration)

					-- Splat VFX event
					CombatEvent:FireAllClients("WallSplat", {
						Target = targetChar,
						Position = rayResult.Position,
						Normal = normal,
					})

					-- Destructible integration
					local destructibleManager = getDestructibleManager()
					if destructibleManager and destructibleManager.BreakObstacle then
						pcall(function()
							destructibleManager.BreakObstacle(rayResult.Instance, flatVel, 6)
						end)
					end

					break
				end
			end
			task.wait(0.05)
		end
	end)
end

-- Executes server-side M1 attack logic
function HitboxManager.ProcessM1(player: Player, requestedStep: number)
	local character = player.Character
	if not character or HitboxManager.IsDisabled(character) or character:GetAttribute("IsAttacking") == true then
		return
	end

	local hrp = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hrp then
		return
	end

	local state = getState(player)
	local now = os.clock()

	-- Combo reset logic if player waited too long
	if now - state.LastAttackTime > CombatConfig.ComboResetTime then
		state.ComboStep = 1
	end

	local currentStep = state.ComboStep
	local stepConfig = CombatConfig.M1[currentStep]
	if not stepConfig then
		state.ComboStep = 1
		stepConfig = CombatConfig.M1[1]
		currentStep = 1
	end

	-- Cooldown check
	if now - state.LastAttackTime < stepConfig.Cooldown * 0.75 then
		return -- Attacking faster than allowed
	end

	AnimationManager.PlayAnimation(character, "M1_" .. tostring(currentStep))
	state.LastAttackTime = now
	state.IsAttacking = true
	state.DashCancelActive = true

	-- Dash cancel window closes after DashCancelWindow
	task.delay(CombatConfig.DashCancelWindow, function()
		if state.LastAttackTime == now then
			state.DashCancelActive = false
		end
	end)

	-- Advance next combo step
	if currentStep >= CombatConfig.MaxComboSteps then
		state.ComboStep = 1
	else
		state.ComboStep = currentStep + 1
	end

	-- Spatial Hitbox Query
	local hitboxCFrame = hrp.CFrame * CFrame.new(stepConfig.HitboxOffset)
	local overlapParams = OverlapParams.new()
	overlapParams.FilterType = Enum.RaycastFilterType.Exclude
	overlapParams.FilterDescendantsInstances = { character }
	overlapParams.MaxParts = 20

	local partsInBox = Workspace:GetPartBoundsInBox(hitboxCFrame, stepConfig.HitboxSize, overlapParams)
	local hitCharacters: { [Model]: boolean } = {}

	for _, part in partsInBox do
		local hitModel = part:FindFirstAncestorOfClass("Model")
		if hitModel and hitModel ~= character and not hitCharacters[hitModel] then
			local targetHumanoid = hitModel:FindFirstChildOfClass("Humanoid")
			local targetHRP = hitModel:FindFirstChild("HumanoidRootPart") :: BasePart?

			if targetHumanoid and targetHumanoid.Health > 0 and targetHRP then
				hitCharacters[hitModel] = true

				-- Distance & Reach anti-cheat validation
				local dist = (targetHRP.Position - hrp.Position).Magnitude
				if dist > CombatConfig.MaxAllowedHitDistance then
					continue
				end

				-- Check target invincibility frames
				if hitModel:GetAttribute("iFrames") == true then
					continue
				end

				-- Evaluate Block & Guard Break
				local wasBlocked, guardBroken = HitboxManager.EvaluateBlock(character, hitModel, false)

				if wasBlocked and not guardBroken then
					-- Blocked successfully: deal reduced damage, no hitstun
					local reducedDamage = stepConfig.Damage * (1 - CombatConfig.BlockDamageReduction)
					HitboxManager.ApplyDamage(character, hitModel, reducedDamage)

					CombatEvent:FireAllClients("HitConfirm", {
						Attacker = character,
						Target = hitModel,
						Step = currentStep,
						Blocked = true,
						Damage = reducedDamage,
					})
				else
					-- Unblocked or Guard Broken hit
					HitboxManager.ApplyDamage(character, hitModel, stepConfig.Damage)

					if currentStep < CombatConfig.MaxComboSteps then
						-- Hits 1-3: Hitstun applied
						HitboxManager.ApplyHitstun(hitModel, stepConfig.Hitstun)

						CombatEvent:FireAllClients("HitConfirm", {
							Attacker = character,
							Target = hitModel,
							Step = currentStep,
							Blocked = false,
							Damage = stepConfig.Damage,
						})
					else
						-- Hit 4: Knockback & Ragdoll Knockdown
						local look = hrp.CFrame.LookVector
						local knockbackVel = (look * stepConfig.KnockbackForce) + Vector3.new(0, stepConfig.KnockbackLift, 0)
						targetHRP.AssemblyLinearVelocity = knockbackVel

						RagdollServer.RagdollCharacter(hitModel, CombatConfig.KnockdownDuration)

						CombatEvent:FireAllClients("HitConfirm", {
							Attacker = character,
							Target = hitModel,
							Step = currentStep,
							Blocked = false,
							Knockback = true,
							Damage = stepConfig.Damage,
						})

						-- Detect Wall Splat on knockback
						HitboxManager.CheckWallSplat(hitModel, knockbackVel)
					end
				end
			end
		end
	end
end

-- Executes Dash and Dash Cancel
function HitboxManager.ProcessDash(player: Player, direction: Vector3, dashType: string)
	local character = player.Character
	if not character or HitboxManager.IsDisabled(character) then
		return
	end

	local hrp = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hrp then
		return
	end

	local state = getState(player)
	local now = os.clock()

	-- Check dash cooldown unless cancelling an M1
	local isDashCancel = state.DashCancelActive and (now - state.LastAttackTime <= CombatConfig.DashCancelWindow)
	if not isDashCancel and (now - state.LastDashTime < CombatConfig.DashCooldown) then
		return
	end

	state.LastDashTime = now
	if isDashCancel then
		-- Dash Cancel executed: reset attack lock to allow rapid combo continuation
		state.IsAttacking = false
		state.DashCancelActive = false
	end

	-- Apply server-side i-frames
	character:SetAttribute("iFrames", true)
	task.delay(CombatConfig.iFrameDuration, function()
		if character and character.Parent then
			character:SetAttribute("iFrames", false)
		end
	end)

	-- Normalize direction or fallback to look vector
	local dashDir = direction
	if dashDir.Magnitude < 0.1 then
		dashDir = hrp.CFrame.LookVector
	else
		dashDir = dashDir.Unit
	end

	-- Apply impulse velocity
	hrp.AssemblyLinearVelocity = dashDir * CombatConfig.DashSpeed

	-- Notify clients for dash trails/VFX
	DashEvent:FireAllClients(character, dashDir, true)
end

-- Handles Blocking state update
function HitboxManager.ProcessBlock(player: Player, isBlocking: boolean)
	local character = player.Character
	if not character or HitboxManager.IsDisabled(character) then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if isBlocking then
		character:SetAttribute("IsBlocking", true)
		AnimationManager.PlayAnimation(character, "Block")
		if humanoid then
			humanoid.WalkSpeed = 16 * CombatConfig.BlockWalkSpeedMultiplier
		end
	else
		character:SetAttribute("IsBlocking", false)
		AnimationManager.StopAnimation(character, "Block")
		if humanoid and not character:GetAttribute("IsStunned") then
			humanoid.WalkSpeed = character:GetAttribute("OriginalWalkSpeed") or 16
		end
	end

	BlockEvent:FireAllClients(character, isBlocking, false)
end

-- Initialize remote event connections
function HitboxManager.Init()
	CombatEvent.OnServerEvent:Connect(function(player: Player, action: any, param1: any, ...)
		if action == "M1" then
			local requestedStep = typeof(param1) == "number" and param1 or 1
			HitboxManager.ProcessM1(player, requestedStep)
		elseif action == "RagdollRecovery" then
			RagdollServer.AttemptRecovery(player)
		end
	end)

	BlockEvent.OnServerEvent:Connect(function(player: Player, isBlocking: any)
		if typeof(isBlocking) == "boolean" then
			HitboxManager.ProcessBlock(player, isBlocking)
		end
	end)

	DashEvent.OnServerEvent:Connect(function(player: Player, direction: any, dashType: any)
		local dir = typeof(direction) == "Vector3" and direction or Vector3.zero
		local dType = typeof(dashType) == "string" and dashType or "Front"
		HitboxManager.ProcessDash(player, dir, dType)
	end)

	Players.PlayerRemoving:Connect(function(player)
		combatStates[player] = nil
	end)
end

-- Automatically initialize on require
HitboxManager.Init()

return HitboxManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">RagdollServer</string>
          <string name="Source"><![CDATA[--!strict
-- RagdollServer.luau
-- Server authority for R15 ragdoll activation, knockdown handling, and Space recovery requests.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local CombatConfig = require(Modules:WaitForChild("CombatConfig"))
local RagdollHelper = require(Modules:WaitForChild("RagdollHelper"))

type RagdollState = {
	Character: Model,
	StartTime: number,
	EndTime: number,
	RecoveryAllowedTime: number,
}

local RagdollServer = {}
local activeRagdolls: { [Model]: RagdollState } = {}

-- Safely retrieves or waits for CombatEvent remote
local function getCombatRemote(): RemoteEvent?
	local remotes = ReplicatedStorage:FindFirstChild("Remotes") :: Folder?
	if not remotes then
		return nil
	end
	return remotes:FindFirstChild("CombatEvent") :: RemoteEvent?
end

-- Server entry point for activating ragdoll on a character
function RagdollServer.RagdollCharacter(character: Model, duration: number?)
	local dur = duration or CombatConfig.KnockdownDuration
	local now = os.clock()

	activeRagdolls[character] = {
		Character = character,
		StartTime = now,
		EndTime = now + dur,
		RecoveryAllowedTime = now + CombatConfig.RagdollMinRecoveryTime,
	}

	RagdollHelper.Ragdoll(character)

	local combatEvent = getCombatRemote()
	if combatEvent then
		combatEvent:FireAllClients("RagdollActive", {
			Target = character,
			Duration = dur,
		})
	end
end

-- Checks if a character is currently managed in ragdoll state
function RagdollServer.IsRagdolled(character: Model): boolean
	return activeRagdolls[character] ~= nil or RagdollHelper.IsRagdolled(character)
end

-- Force unragdolls character immediately
function RagdollServer.UnragdollCharacter(character: Model)
	activeRagdolls[character] = nil
	RagdollHelper.Unragdoll(character)

	local combatEvent = getCombatRemote()
	if combatEvent then
		combatEvent:FireAllClients("RagdollEnded", {
			Target = character,
		})
	end
end

-- Handles space-bar ground recovery request from client
function RagdollServer.AttemptRecovery(player: Player): boolean
	local character = player.Character
	if not character or not RagdollServer.IsRagdolled(character) then
		return false
	end

	local state = activeRagdolls[character]
	local now = os.clock()
	if state and now < state.RecoveryAllowedTime then
		-- Recovery lock is still active (cannot instant-cancel before touching ground)
		return false
	end

	-- Ground raycast verification
	if not RagdollHelper.IsGrounded(character) then
		return false
	end

	-- Successfully grounded: cancel ragdoll
	activeRagdolls[character] = nil
	RagdollHelper.Unragdoll(character)

	-- Apply recovery invulnerability window
	character:SetAttribute("iFrames", true)
	task.delay(CombatConfig.RecoveryiFrames, function()
		if character and character.Parent then
			character:SetAttribute("iFrames", false)
		end
	end)

	-- Notify clients for recovery roll animation/sound
	local combatEvent = getCombatRemote()
	if combatEvent then
		combatEvent:FireAllClients("RagdollRecovery", {
			Target = character,
		})
	end

	return true
end

-- Periodic heartbeat check for expired ragdoll timers
RunService.Heartbeat:Connect(function()
	local now = os.clock()
	for character, state in pairs(activeRagdolls) do
		if not character.Parent then
			activeRagdolls[character] = nil
		elseif now >= state.EndTime then
			-- Timer expired: if grounded, stand up; if in midair, wait until touching ground
			if RagdollHelper.IsGrounded(character) or (now - state.EndTime > 2.0) then
				RagdollServer.UnragdollCharacter(character)
			end
		end
	end
end)

-- Character cleanup on removal
Players.PlayerRemoving:Connect(function(player)
	if player.Character and activeRagdolls[player.Character] then
		activeRagdolls[player.Character] = nil
	end
end)

return RagdollServer
]]></string>
        </Properties>
