          <string name="Name">SkillInit</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Start skill handling independently of character setup and M1/dash modules.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local RemotesInit = require(remotes:WaitForChild("RemotesInit"))
RemotesInit.InitServer()

local SkillServer = require(script.Parent:WaitForChild("SkillServer"))
SkillServer.Init()
print("[SkillInit] Z/X/C/V skill server ready.")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">SkillServer</string>
          <string name="Source"><![CDATA[--!strict
-- SkillServer.luau
-- Authoritative server execution for Saitama R15 martial arts moveset:
-- Skill 1: Consecutive Punches / Rush Attack (12 rapid punches, hitstuns, finisher knockback)
-- Skill 2: Heavy Punch (Windup punch, Guard Break property, massive knockback & ragdoll)
-- Skill 3: Ground Slam (Jump & ground slam, 18-stud AOE knockup stun, triggers environment destruction)
-- Skill 4: Counter / Flash Dash (0.8s counter stance; counter punish if attacked, flash dash if untouched)
-- Awakening (Key G): Serious Mode, 2s transformation, speed buff, 30% CDR, 1.5x dmg, upgrades skills

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

-- Dynamic references with fallback
local Modules = ReplicatedStorage:WaitForChild("Modules", 5) :: Folder?
local MovesetData
if Modules and Modules:FindFirstChild("MovesetData") then
	MovesetData = require(Modules:WaitForChild("MovesetData"))
else
	MovesetData = require(script.Parent.Parent.Parent.ReplicatedStorage.Modules.MovesetData)
end

local AnimationManager
if Modules and Modules:FindFirstChild("AnimationManager") then
	AnimationManager = require(Modules:WaitForChild("AnimationManager"))
else
	AnimationManager = require(script.Parent.Parent.Parent.ReplicatedStorage.Modules.AnimationManager)
end

local CombatConfig
if Modules and Modules:FindFirstChild("CombatConfig") then
	CombatConfig = require(Modules:WaitForChild("CombatConfig"))
else
	CombatConfig = require(script.Parent.Parent.Parent.ReplicatedStorage.Modules.CombatConfig)
end

-- Optional Server Module requirements with safe pcall/fallback
local function getRagdollServer()
	local combatServerFolder = script.Parent
	local rServer = combatServerFolder:FindFirstChild("RagdollServer")
	if rServer and rServer:IsA("ModuleScript") then
		local s, res = pcall(require, rServer)
		if s then return res end
	end
	return nil
end

local function getHitboxManager()
	local combatServerFolder = script.Parent
	local hb = combatServerFolder:FindFirstChild("HitboxManager")
	if hb and hb:IsA("ModuleScript") then
		local s, res = pcall(require, hb)
		if s then return res end
	end
	return nil
end

local function getDestructibleManager()
	local combatServerFolder = script.Parent
	local dm = combatServerFolder:FindFirstChild("DestructibleManager")
	if dm and dm:IsA("ModuleScript") then
		local s, res = pcall(require, dm)
		if s then return res end
	end
	return nil
end

local function getCooldownManager()
	local sss = script.Parent.Parent
	local cm = sss:FindFirstChild("CooldownManager")
	if cm and cm:IsA("ModuleScript") then
		local s, res = pcall(require, cm)
		if s then return res end
	end
	return nil
end

-- Fallback internal cooldown tracking
local internalCooldowns: { [Player]: { [string]: number } } = {}

-- Awakening active timers tracking
local awakenedPlayers: { [Player]: { EndTime: number, CleanUp: () -> () } } = {}

-- Active counter stances tracking: [VictimModel] = { Player = Player, Expiry = number, Punish = () -> () }
local activeCounters: { [Model]: { Player: Player, Expiry: number, Punish: (attackerChar: Model) -> () } } = {}

local SkillServer = {}

--------------------------------------------------------------------------------
-- REMOTE EVENT HELPERS
--------------------------------------------------------------------------------

local function getRemotesFolder(): Folder
	local remotes = ReplicatedStorage:FindFirstChild("Remotes") :: Folder?
	if not remotes then
		remotes = Instance.new("Folder")
		remotes.Name = "Remotes"
		remotes.Parent = ReplicatedStorage
	end
	return remotes
end

local function getSkillEvent(): RemoteEvent
	local folder = getRemotesFolder()
	local event = folder:FindFirstChild("SkillEvent") :: RemoteEvent?
	if not event then
		event = Instance.new("RemoteEvent")
		event.Name = "SkillEvent"
		event.Parent = folder
	end
	return event
end

local function getCombatEvent(): RemoteEvent?
	local folder = getRemotesFolder()
	return folder:FindFirstChild("CombatEvent") :: RemoteEvent?
end

local function getBlockEvent(): RemoteEvent?
	local folder = getRemotesFolder()
	return folder:FindFirstChild("BlockEvent") :: RemoteEvent?
end

--------------------------------------------------------------------------------
-- COOLDOWN HELPERS
--------------------------------------------------------------------------------

local function isPlayerOnCooldown(player: Player, actionKey: string): boolean
	local cm = getCooldownManager()
	if cm and cm.IsOnCooldown then
		return cm.IsOnCooldown(player, actionKey)
	end

	local pTable = internalCooldowns[player]
	if not pTable then return false end
	local expiry = pTable[actionKey]
	return expiry ~= nil and os.clock() < expiry
end

local function setPlayerCooldown(player: Player, actionKey: string, duration: number, skillId: number?)
	local cm = getCooldownManager()
	local appliedDuration = duration

	local parsedId = skillId or tonumber(string.match(actionKey, "%d+"))
	local skillConfig = parsedId and MovesetData.GetSkill(parsedId, false)
	local baseDuration = (skillConfig and skillConfig.Cooldown) or duration

	if cm and cm.SetCooldown then
		appliedDuration = cm.SetCooldown(player, actionKey, baseDuration)
	else
		if not internalCooldowns[player] then
			internalCooldowns[player] = {}
		end
		internalCooldowns[player][actionKey] = os.clock() + duration
	end

	-- Notify client HUD of cooldown
	local skillEvent = getSkillEvent()
	skillEvent:FireClient(player, "SkillCooldown", {
		SkillId = parsedId,
		ActionKey = actionKey,
		Duration = appliedDuration,
	})
end

--------------------------------------------------------------------------------
-- HITBOX & SPATIAL QUERY HELPERS
--------------------------------------------------------------------------------

-- Finds all eligible enemy Character models within an Oriented Bounding Box
local function queryBoxTargets(originCFrame: CFrame, boxSize: Vector3, ignoreModel: Model): { Model }
	local hm = getHitboxManager()
	if hm and hm.GetTargetsInBox then
		local s, res = pcall(hm.GetTargetsInBox, originCFrame, boxSize, ignoreModel)
		if s and type(res) == "table" then
			return res
		end
	end

	-- Native Roblox Spatial Query Fallback
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances = { ignoreModel }
	overlap.CollisionGroup = "Default"

	local parts = Workspace:GetPartBoundsInBox(originCFrame, boxSize, overlap)
	local hitModels: { [Model]: boolean } = {}
	local results: { Model } = {}

	for _, part in ipairs(parts) do
		local char = part:FindFirstAncestorOfClass("Model")
		if char and not hitModels[char] then
			local hum = char:FindFirstChildOfClass("Humanoid")
			local root = char:FindFirstChild("HumanoidRootPart")
			if hum and hum.Health > 0 and root and char ~= ignoreModel then
				hitModels[char] = true
				table.insert(results, char)
			end
		end
	end

	return results
end

-- Finds all eligible enemy Character models within a spherical radius
local function queryRadiusTargets(centerPosition: Vector3, radius: number, ignoreModel: Model): { Model }
	local hm = getHitboxManager()
	if hm and hm.GetTargetsInRadius then
		local s, res = pcall(hm.GetTargetsInRadius, centerPosition, radius, ignoreModel)
		if s and type(res) == "table" then
			return res
		end
	end

	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances = { ignoreModel }

	local parts = Workspace:GetPartBoundsInRadius(centerPosition, radius, overlap)
	local hitModels: { [Model]: boolean } = {}
	local results: { Model } = {}

	for _, part in ipairs(parts) do
		local char = part:FindFirstAncestorOfClass("Model")
		if char and not hitModels[char] then
			local hum = char:FindFirstChildOfClass("Humanoid")
			local root = char:FindFirstChild("HumanoidRootPart")
			if hum and hum.Health > 0 and char ~= ignoreModel then
				hitModels[char] = true
				table.insert(results, char)
			end
		end
	end

	return results
end

--------------------------------------------------------------------------------
-- DAMAGE, KNOCKBACK & STATE APPLICATION
--------------------------------------------------------------------------------

local function applyDamage(attackerPlayer: Player?, victimChar: Model, rawDamage: number, isGuardBreak: boolean?): (number, boolean)
	local humanoid = victimChar:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return 0, false
	end

	-- Check invulnerability / i-frames
	if victimChar:GetAttribute("iFrames") == true then
		return 0, false
	end

	-- Check active Counter stance
	if SkillServer.CheckCounter(victimChar, attackerPlayer and attackerPlayer.Character) then
		return 0, false
	end

	local isBlocking = victimChar:GetAttribute("IsBlocking") == true
	local finalDamage = rawDamage
	local guardBroken = false

	if isBlocking then
		if isGuardBreak then
			-- Heavy attacks shatter block (Guard Break)
			guardBroken = true
			victimChar:SetAttribute("IsBlocking", false)
			victimChar:SetAttribute("GuardBroken", true)
			victimChar:SetAttribute("IsStunned", true)

			-- Notify client block broken
			local blockEvent = getBlockEvent()
			if blockEvent then
				blockEvent:FireAllClients(victimChar, false, true)
			end

			-- Reset stun after posture break duration
			task.delay(CombatConfig.GuardBreakStun, function()
				if victimChar and victimChar.Parent then
					victimChar:SetAttribute("GuardBroken", false)
					victimChar:SetAttribute("IsStunned", false)
				end
			end)
		else
			-- Normal block reduction
			finalDamage = rawDamage * (1 - CombatConfig.BlockDamageReduction)
		end
	end

	humanoid:TakeDamage(finalDamage)

	-- Rage / Ultimate Meter Building
	if attackerPlayer and attackerPlayer.Character then
		local currentRage = attackerPlayer.Character:GetAttribute("Rage") or 0
		local gain = CombatConfig.RageGainOnHit * (rawDamage / 10)
		attackerPlayer.Character:SetAttribute("Rage", math.clamp(currentRage + gain, 0, 100))
	end

	local victimPlayer = Players:GetPlayerFromCharacter(victimChar)
	if victimPlayer and victimChar then
		local currentRage = victimChar:GetAttribute("Rage") or 0
		local gain = CombatConfig.RageGainOnDamageTaken * (finalDamage / 10)
		victimChar:SetAttribute("Rage", math.clamp(currentRage + gain, 0, 100))
	end

	-- Notify clients for floating damage pop-up billboard
	local combatEvent = getCombatEvent()
	if combatEvent then
		combatEvent:FireAllClients("DamageDealt", {
			Target = victimChar,
			Damage = math.round(finalDamage),
			IsGuardBreak = guardBroken,
			IsCritical = guardBroken or rawDamage >= 30,
		})
	end

	return finalDamage, guardBroken
end

local function applyKnockback(targetChar: Model, directionVelocity: Vector3, ragdollDuration: number?)
	local root = targetChar:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then return end

	-- Apply physical velocity impulse
	local attachment = Instance.new("Attachment")
	attachment.Parent = root

	local linearVelocity = Instance.new("LinearVelocity")
	linearVelocity.MaxForce = math.huge
	linearVelocity.VectorVelocity = directionVelocity
	linearVelocity.Attachment0 = attachment
	linearVelocity.Parent = root

	Debris:AddItem(linearVelocity, 0.18)
	Debris:AddItem(attachment, 0.18)

	-- Activate ragdoll if duration specified
	if ragdollDuration and ragdollDuration > 0 then
		local rs = getRagdollServer()
		if rs and rs.RagdollCharacter then
			rs.RagdollCharacter(targetChar, ragdollDuration)
		else
			-- Fallback ragdoll attribute
			targetChar:SetAttribute("IsRagdolled", true)
			task.delay(ragdollDuration, function()
				if targetChar and targetChar.Parent then
					targetChar:SetAttribute("IsRagdolled", false)
				end
			end)
		end
	end
end

--------------------------------------------------------------------------------
-- SKILL 1: CONSECUTIVE PUNCHES / RUSH ATTACK
--------------------------------------------------------------------------------

local function executeRushAttack(player: Player, character: Model, isAwakened: boolean)
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid then return end

	local skillConfig = MovesetData.GetSkill(1, isAwakened)
	if not skillConfig then return end

	local hitCount = skillConfig.HitCount or 12
	local hitInterval = skillConfig.HitInterval or 0.11
	local damagePerHit = skillConfig.Damage
	local finisherDamage = skillConfig.FinisherDamage or 8.0
	local finisherKnockback = skillConfig.FinisherKnockback or 38.0
	local finisherLift = skillConfig.FinisherLift or 6.0

	-- Slightly slow attacker during rush flurry
	local originalSpeed = humanoid.WalkSpeed
	humanoid.WalkSpeed = 6.0
	character:SetAttribute("IsAttacking", true)

	-- Broadcast animation and initial SFX
	local skillEvent = getSkillEvent()
	skillEvent:FireAllClients("SkillVFX", {
		SkillId = 1,
		Action = "RushStart",
		Attacker = character,
		IsAwakened = isAwakened,
	})

	AnimationManager.PlayAnimation(character, skillConfig.AnimationName)

	task.spawn(function()
		local hitVictims: { [Model]: boolean } = {}

		for tickIndex = 1, hitCount do
			if not character.Parent or humanoid.Health <= 0 then
				break
			end

			local hitboxCFrame = root.CFrame * CFrame.new(skillConfig.HitboxOffset)
			local targets = queryBoxTargets(hitboxCFrame, skillConfig.HitboxSize, character)

			for _, target in ipairs(targets) do
				hitVictims[target] = true
				applyDamage(player, target, damagePerHit, false)

				-- Pull and hold target in front of attacker during flurry
				local targetRoot = target:FindFirstChild("HumanoidRootPart") :: BasePart?
				if targetRoot then
					local holdPos = root.Position + (root.CFrame.LookVector * 4.0)
					targetRoot.CFrame = CFrame.lookAt(Vector3.new(holdPos.X, targetRoot.Position.Y, holdPos.Z), root.Position)
				end

				target:SetAttribute("IsStunned", true)
				task.delay(skillConfig.HitstunDuration, function()
					if target and target.Parent then
						target:SetAttribute("IsStunned", false)
					end
				end)
			end

			skillEvent:FireAllClients("SkillVFX", {
				SkillId = 1,
				Action = "RushTick",
				Attacker = character,
				TickIndex = tickIndex,
				IsAwakened = isAwakened,
			})

			task.wait(hitInterval)
		end

		-- Finisher Punch
		if character.Parent and humanoid.Health > 0 then
			local finisherCFrame = root.CFrame * CFrame.new(skillConfig.HitboxOffset)
			local finalTargets = queryBoxTargets(finisherCFrame, skillConfig.HitboxSize, character)

			for _, target in ipairs(finalTargets) do
				applyDamage(player, target, finisherDamage, false)

				local launchDir = (root.CFrame.LookVector * finisherKnockback) + Vector3.new(0, finisherLift, 0)
				applyKnockback(target, launchDir, isAwakened and 1.5 or 0.8)
			end

			skillEvent:FireAllClients("SkillVFX", {
				SkillId = 1,
				Action = "RushFinisher",
				Attacker = character,
				IsAwakened = isAwakened,
			})
		end

		-- Reset movement
		if humanoid and humanoid.Parent then
			if isAwakened then
				humanoid.WalkSpeed = MovesetData.AwakeningConfig.WalkSpeedBuff
			else
				humanoid.WalkSpeed = 16.0
			end
		end
		character:SetAttribute("IsAttacking", false)
	end)
end

--------------------------------------------------------------------------------
-- SKILL 2: KAMEHAMEHA / HEAVY PUNCH (BEAM BLAST, GUARD BREAK & WALL SPLAT)
--------------------------------------------------------------------------------

local function executeHeavyPunch(player: Player, character: Model, isAwakened: boolean)
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid then return end

	local skillConfig = MovesetData.GetSkill(2, isAwakened)
	if not skillConfig then return end

	character:SetAttribute("IsAttacking", true)
	local originalSpeed = humanoid.WalkSpeed
	humanoid.WalkSpeed = 2.0

	local skillEvent = getSkillEvent()
	skillEvent:FireAllClients("SkillVFX", {
		SkillId = 2,
		Action = "HeavyPunchWindup",
		Attacker = character,
		IsAwakened = isAwakened,
	})

	AnimationManager.PlayAnimation(character, skillConfig.AnimationName)

	-- Windup delay (charging Ki orb at hip)
	task.delay(skillConfig.WindupTime, function()
		if not character.Parent or humanoid.Health <= 0 then
			character:SetAttribute("IsAttacking", false)
			return
		end

		local punchCFrame = root.CFrame * CFrame.new(skillConfig.HitboxOffset)
		local targets = queryBoxTargets(punchCFrame, skillConfig.HitboxSize, character)

		for _, target in ipairs(targets) do
			local dmg, guardBroken = applyDamage(player, target, skillConfig.Damage, skillConfig.GuardBreak)

			local knockVelocity = (root.CFrame.LookVector * skillConfig.KnockbackForce) + Vector3.new(0, skillConfig.KnockbackLift, 0)
			local ragdollDur = 1.8
			if isAwakened then
				ragdollDur = 2.2
			end
			applyKnockback(target, knockVelocity, ragdollDur)
		end

		-- Trigger Destructible Environment along beam corridor
		if skillConfig.DestroysEnvironment then
			local dm = getDestructibleManager()
			if dm then
				if dm.BreakInRadius then
					local beamCenter = root.Position + (root.CFrame.LookVector * 24.0)
					dm.BreakInRadius(beamCenter, 16.0, skillConfig.KnockbackForce)
				end
				if dm.BreakObstaclesInBox then
					dm.BreakObstaclesInBox(punchCFrame, skillConfig.HitboxSize, root.CFrame.LookVector * skillConfig.KnockbackForce)
				end
			end
		end

		-- Broadcast Kamehameha beam & impact visual effects
		skillEvent:FireAllClients("SkillVFX", {
			SkillId = 2,
			Action = "KamehamehaBeam",
			Attacker = character,
			IsAwakened = isAwakened,
			ImpactCFrame = punchCFrame,
		})

		skillEvent:FireAllClients("SkillVFX", {
			SkillId = 2,
			Action = "HeavyPunchImpact",
			Attacker = character,
			IsAwakened = isAwakened,
			ImpactCFrame = punchCFrame,
		})

		task.wait(0.35)
		if humanoid and humanoid.Parent then
			if isAwakened then
				humanoid.WalkSpeed = MovesetData.AwakeningConfig.WalkSpeedBuff
			else
				humanoid.WalkSpeed = 16.0
			end
		end
		character:SetAttribute("IsAttacking", false)
	end)
end

--------------------------------------------------------------------------------
-- SKILL 3: KAIOKEN / GROUND SLAM (AOE KNOCKUP & DESTRUCTION)
--------------------------------------------------------------------------------

local function executeGroundSlam(player: Player, character: Model, isAwakened: boolean)
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid then return end

	local skillConfig = MovesetData.GetSkill(3, isAwakened)
	if not skillConfig then return end

	character:SetAttribute("IsAttacking", true)
	humanoid.WalkSpeed = 0

	local restored = false
	local function restoreSpeed()
		if restored then return end
		restored = true

		if humanoid and humanoid.Parent and humanoid.Health > 0 then
			if isAwakened or character:GetAttribute("IsAwakened") == true then
				humanoid.WalkSpeed = MovesetData.AwakeningConfig.WalkSpeedBuff
			else
				humanoid.WalkSpeed = 16.0
			end
		end
		if character and character.Parent then
			character:SetAttribute("IsAttacking", false)
		end
	end

	-- Watchdog Timer: Guarantees WalkSpeed is restored and IsAttacking cleared after at most 1.5s even on error
	task.delay(1.5, restoreSpeed)

	local skillEvent = getSkillEvent()
	if skillEvent then
		skillEvent:FireAllClients("SkillVFX", {
			SkillId = 3,
			Action = "KaiokenBurst",
			Attacker = character,
			IsAwakened = isAwakened,
		})

		skillEvent:FireAllClients("SkillVFX", {
			SkillId = 3,
			Action = "GroundSlamLeap",
			Attacker = character,
			IsAwakened = isAwakened,
		})
	end

	pcall(function()
		AnimationManager.PlayAnimation(character, skillConfig.AnimationName)
	end)

	-- Jump upward impulse
	root.AssemblyLinearVelocity = Vector3.new(0, 32, 0)

	task.delay(skillConfig.WindupTime, function()
		if not character.Parent or humanoid.Health <= 0 then
			restoreSpeed()
			return
		end

		-- Slam downward violently
		root.AssemblyLinearVelocity = Vector3.new(0, -60, 0)
		task.wait(0.12)

		local impactPosition = root.Position - Vector3.new(0, 2.8, 0)
		local aoeRadius = skillConfig.AoeRadius or 18.0
		local targets = queryRadiusTargets(impactPosition, aoeRadius, character)

		for _, target in ipairs(targets) do
			applyDamage(player, target, skillConfig.Damage, false)

			local targetRoot = target:FindFirstChild("HumanoidRootPart") :: BasePart?
			if targetRoot then
				local radialDir = (targetRoot.Position - impactPosition).Unit
				if radialDir.Magnitude == 0 or radialDir ~= radialDir then
					radialDir = root.CFrame.LookVector
				end
				local knockVelocity = (radialDir * skillConfig.KnockbackForce) + Vector3.new(0, skillConfig.KnockbackLift, 0)
				applyKnockback(target, knockVelocity, 1.5)
			end
		end

		-- Destructible Environment fracture wrapped in pcall
		pcall(function()
			local dm = getDestructibleManager()
			if dm then
				if dm.ExplodeGround then
					pcall(dm.ExplodeGround, impactPosition, aoeRadius)
				elseif dm.BreakInRadius then
					pcall(dm.BreakInRadius, impactPosition, aoeRadius, skillConfig.KnockbackForce)
				end
			end
		end)

		if skillEvent then
			skillEvent:FireAllClients("SkillVFX", {
				SkillId = 3,
				Action = "GroundSlamImpact",
				Attacker = character,
				ImpactPosition = impactPosition,
				Radius = aoeRadius,
				IsAwakened = isAwakened,
			})
		end

		task.wait(0.35)
		restoreSpeed()
	end)
end

--------------------------------------------------------------------------------
-- SKILL 4: INSTANT TRANSMISSION / SPIRIT BOMB (COUNTER / FLASH DASH)
--------------------------------------------------------------------------------

local function executeCounter(player: Player, character: Model, isAwakened: boolean)
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid then return end

	local skillConfig = MovesetData.GetSkill(4, isAwakened)
	if not skillConfig then return end

	character:SetAttribute("IsAttacking", true)

	local skillEvent = getSkillEvent()

	-- Awakening Variant: Spirit Bomb (Massive AOE Gathering & Throw)
	if isAwakened then
		humanoid.WalkSpeed = 0
		root.AssemblyLinearVelocity = Vector3.new(0, 20, 0)

		skillEvent:FireAllClients("SkillVFX", {
			SkillId = 4,
			Action = "SpiritBombStart",
			Attacker = character,
			IsAwakened = true,
		})

		AnimationManager.PlayAnimation(character, "SpiritBomb")

		-- Watchdog Timer: Guarantees WalkSpeed restored and IsAttacking cleared after at most 1.5s
		task.delay(1.5, function()
			if character and character.Parent then
				character:SetAttribute("IsAttacking", false)
				if humanoid and humanoid.Parent and humanoid.Health > 0 and humanoid.WalkSpeed == 0 then
					humanoid.WalkSpeed = MovesetData.AwakeningConfig.WalkSpeedBuff
				end
			end
		end)

		task.delay(0.55, function()
			if not character.Parent or humanoid.Health <= 0 then
				character:SetAttribute("IsAttacking", false)
				return
			end

			local bombTargetPos = root.Position + (root.CFrame.LookVector * 28.0)
			local bombRadius = 26.0
   -- Charge ends at .55; the visible projectile takes .35 to arrive.
   task.wait(0.35)
   if not character.Parent or humanoid.Health <= 0 or character:GetAttribute("IsRagdolled") then return end
			local targets = queryRadiusTargets(bombTargetPos, bombRadius, character)

			for _, target in ipairs(targets) do
				applyDamage(player, target, skillConfig.Damage, true)

				local targetRoot = target:FindFirstChild("HumanoidRootPart") :: BasePart?
				if targetRoot then
					local knockDir = (targetRoot.Position - bombTargetPos).Unit
					if knockDir.Magnitude == 0 or knockDir ~= knockDir then
						knockDir = root.CFrame.LookVector
					end
					local knockVel = (knockDir * skillConfig.KnockbackForce) + Vector3.new(0, skillConfig.KnockbackLift, 0)
					applyKnockback(target, knockVel, 2.0)
				end
			end

			pcall(function()
				local dm = getDestructibleManager()
				if dm then
					if dm.ExplodeGround then
						pcall(dm.ExplodeGround, bombTargetPos, bombRadius)
					elseif dm.BreakInRadius then
						pcall(dm.BreakInRadius, bombTargetPos, bombRadius, skillConfig.KnockbackForce)
					end
				end
			end)

			skillEvent:FireAllClients("SkillVFX", {
				SkillId = 4,
				Action = "GroundSlamImpact",
				Attacker = character,
				ImpactPosition = bombTargetPos,
				Radius = bombRadius,
				IsAwakened = true,
			})

			task.wait(0.35)
			if humanoid and humanoid.Parent then
				humanoid.WalkSpeed = MovesetData.AwakeningConfig.WalkSpeedBuff
			end
			character:SetAttribute("IsAttacking", false)
		end)
		return
	end

	-- Base Variant: Instant Transmission (Teleport behind target + Heavy strike)
	character:SetAttribute("IsCountering", true)
	humanoid.WalkSpeed = 4.0

	local counterWindow = skillConfig.CounterWindow or 0.8
	local wasAttacked = false

	skillEvent:FireAllClients("SkillVFX", {
		SkillId = 4,
		Action = "CounterStance",
		Attacker = character,
		IsAwakened = isAwakened,
	})

	AnimationManager.PlayAnimation(character, skillConfig.AnimationName)

	-- Find closest enemy in front/nearby for Instant Transmission teleport
	local closestEnemy: Model? = nil
	local closestDist = 45.0
	for _, otherPlayer in ipairs(Players:GetPlayers()) do
		if otherPlayer ~= player and otherPlayer.Character then
			local eChar = otherPlayer.Character
			local eHum = eChar:FindFirstChildOfClass("Humanoid")
			local eRoot = eChar:FindFirstChild("HumanoidRootPart") :: BasePart?
			if eHum and eHum.Health > 0 and eRoot then
				local dist = (eRoot.Position - root.Position).Magnitude
				if dist < closestDist then
					closestDist = dist
					closestEnemy = eChar
				end
			end
		end
	end

	-- Register counter punish callback
	local counterEntry = {
		Player = player,
		Expiry = os.clock() + counterWindow,
		Punish = function(attackerChar: Model)
			if wasAttacked then return end
			wasAttacked = true

			character:SetAttribute("IsCountering", false)
			activeCounters[character] = nil

			-- Teleport behind attacker
			local attackerRoot = attackerChar:FindFirstChild("HumanoidRootPart") :: BasePart?
			if attackerRoot and root then
				local behindPos = attackerRoot.Position - (attackerRoot.CFrame.LookVector * 3.5)
				root.CFrame = CFrame.lookAt(behindPos, attackerRoot.Position)
			end

			-- Counter Punish Strike
			AnimationManager.PlayAnimation(character, "CounterPunish")
			local punishDmg = skillConfig.CounterPunishDamage or 35.0
			applyDamage(player, attackerChar, punishDmg, true)

			local knockVelocity = (root.CFrame.LookVector * skillConfig.KnockbackForce) + Vector3.new(0, skillConfig.KnockbackLift, 0)
			applyKnockback(attackerChar, knockVelocity, 1.4)

			skillEvent:FireAllClients("SkillVFX", {
				SkillId = 4,
				Action = "CounterTriggered",
				Attacker = character,
				Victim = attackerChar,
				IsAwakened = isAwakened,
			})

			humanoid.WalkSpeed = 16.0
			character:SetAttribute("IsAttacking", false)
		end,
	}

	activeCounters[character] = counterEntry

	-- Counter stance watchdog failsafe: ensures IsCountering, IsAttacking and WalkSpeed are safely reset even on error/interruption
	task.delay(counterWindow + 0.4, function()
		if activeCounters[character] == counterEntry then
			activeCounters[character] = nil
		end
		if character and character.Parent then
			if character:GetAttribute("IsCountering") == true then
				character:SetAttribute("IsCountering", false)
			end
			if character:GetAttribute("IsAttacking") == true and not wasAttacked then
				character:SetAttribute("IsAttacking", false)
				if humanoid and humanoid.Parent and humanoid.Health > 0 then
					humanoid.WalkSpeed = 16.0
				end
			end
		end
	end)

	-- If an enemy is in range, execute instant transmission teleport strike after brief vanish
	task.delay(0.18, function()
		if wasAttacked or not character.Parent or humanoid.Health <= 0 then
			character:SetAttribute("IsCountering", false)
			activeCounters[character] = nil
			return
		end

		if closestEnemy and closestEnemy.Parent then
			local eRoot = closestEnemy:FindFirstChild("HumanoidRootPart") :: BasePart?
			if eRoot then
				wasAttacked = true
				character:SetAttribute("IsCountering", false)
				activeCounters[character] = nil

				-- Teleport behind target
				local behindPos = eRoot.Position - (eRoot.CFrame.LookVector * 3.5)
				root.CFrame = CFrame.lookAt(behindPos, eRoot.Position)

				AnimationManager.PlayAnimation(character, "CounterPunish")
				applyDamage(player, closestEnemy, skillConfig.Damage, true)

				local knockVel = (root.CFrame.LookVector * skillConfig.KnockbackForce) + Vector3.new(0, skillConfig.KnockbackLift, 0)
				applyKnockback(closestEnemy, knockVel, 1.4)

				skillEvent:FireAllClients("SkillVFX", {
					SkillId = 4,
					Action = "InstantTransmissionFlash",
					Attacker = character,
					Victim = closestEnemy,
					IsAwakened = false,
				})

				task.wait(0.25)
				humanoid.WalkSpeed = 16.0
				character:SetAttribute("IsAttacking", false)
				return
			end
		end

		-- If no enemy, execute Flash Dash forward after counter window
		task.delay(counterWindow - 0.18, function()
			if wasAttacked or not character.Parent or humanoid.Health <= 0 then
				character:SetAttribute("IsCountering", false)
				activeCounters[character] = nil
				character:SetAttribute("IsAttacking", false)
				return
			end

			character:SetAttribute("IsCountering", false)
			activeCounters[character] = nil

			local dashDist = skillConfig.FlashDashDistance or 35.0
			local dashDuration = skillConfig.FlashDashDuration or 0.20

			local rayParams = RaycastParams.new()
			rayParams.FilterType = Enum.RaycastFilterType.Exclude
			rayParams.FilterDescendantsInstances = { character }

			local rayResult = Workspace:Raycast(root.Position, root.CFrame.LookVector * dashDist, rayParams)
			local targetPos = root.Position + (root.CFrame.LookVector * dashDist)
			if rayResult then
				targetPos = rayResult.Position - (root.CFrame.LookVector * 2.0)
			end

			character:SetAttribute("iFrames", true)
			AnimationManager.PlayAnimation(character, "FlashDash")

			local tweenInfo = TweenInfo.new(dashDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			local tween = game:GetService("TweenService"):Create(root, tweenInfo, { CFrame = CFrame.lookAt(targetPos, targetPos + root.CFrame.LookVector) })
			tween:Play()

			skillEvent:FireAllClients("SkillVFX", {
				SkillId = 4,
				Action = "FlashDash",
				Attacker = character,
				StartPos = root.Position,
				EndPos = targetPos,
				IsAwakened = isAwakened,
			})

			task.wait(dashDuration)
			character:SetAttribute("iFrames", false)
			if humanoid and humanoid.Parent then
				humanoid.WalkSpeed = 16.0
			end
			character:SetAttribute("IsAttacking", false)
		end)
	end)
end

--------------------------------------------------------------------------------
-- AWAKENING / ULTIMATE (KEY G)
--------------------------------------------------------------------------------

function SkillServer.ActivateAwakening(player: Player): boolean
	local character = player.Character
	if not character then return false end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or humanoid.Health <= 0 then return false end

	-- Check if already awakened
	if character:GetAttribute("IsAwakened") == true then
		return false
	end

	-- Check Rage meter requirement (100%)
	local currentRage = (character and character:GetAttribute("Rage")) or 0
	if currentRage < MovesetData.AwakeningConfig.RequiredRageMeter then
		return false
	end

	-- Consume Rage meter
	if character then
		character:SetAttribute("Rage", 0)
	end

	local config = MovesetData.AwakeningConfig

	-- Configure CooldownManager CDR modifier
	local cm = getCooldownManager()
	if cm and cm.SetAwakening then
		cm.SetAwakening(player, true, config.CooldownReduction)
	end

	-- Cinematic 2.0s transformation lock + i-frames
	character:SetAttribute("IsAwakened", true)
	character:SetAttribute("iFrames", true)
	character:SetAttribute("IsAttacking", true)
	humanoid.WalkSpeed = 0

	local skillEvent = getSkillEvent()
	skillEvent:FireAllClients("SkillVFX", {
		Action = "AwakeningTransform",
		Attacker = character,
		Duration = config.TransformationDuration,
		AuraColor = config.AuraColor,
	})

	AnimationManager.PlayAnimation(character, config.AnimationName)

	-- Apply Awakening state after transformation completes
	task.delay(config.TransformationDuration, function()
		if not character.Parent or humanoid.Health <= 0 then
			return
		end

		character:SetAttribute("iFrames", false)
		character:SetAttribute("IsAttacking", false)
		humanoid.WalkSpeed = config.WalkSpeedBuff

		-- Notify client HUD of Awakening active state
		skillEvent:FireAllClients("AwakeningState", {
			Player = player,
			User = character,
			Character = character,
			Active = true,
			IsAwakened = true,
			Duration = config.Duration,
		})

		-- Awakening Expiration Timer
		local cleanupToken = false
		local function revertAwakening()
			if cleanupToken then return end
			cleanupToken = true

			if cm and cm.SetAwakening then
				cm.SetAwakening(player, false)
			end

			awakenedPlayers[player] = nil
			if character and character.Parent then
				character:SetAttribute("IsAwakened", false)
				if humanoid and humanoid.Parent and humanoid.Health > 0 then
					humanoid.WalkSpeed = 16.0
				end
			end

			skillEvent:FireAllClients("AwakeningState", {
				Player = player,
				User = character,
				Character = character,
				Active = false,
				IsAwakened = false,
				Duration = 0,
			})

			skillEvent:FireAllClients("SkillVFX", {
				Action = "AwakeningEnd",
				Attacker = character,
			})
		end

		awakenedPlayers[player] = {
			EndTime = os.clock() + config.Duration,
			CleanUp = revertAwakening,
		}

		task.delay(config.Duration, revertAwakening)
	end)

	return true
end

-- Authoritative alias for CombatInit delegation
function SkillServer.ExecuteAwakening(player: Player): boolean
	return SkillServer.ActivateAwakening(player)
end

-- Adds Rage to a player's character
function SkillServer.AddPlayerRage(player: Player, amount: number): number
	local char = player.Character
	if not char then return 0 end
	local currentRage = char:GetAttribute("Rage") or 0
	local newRage = math.clamp(currentRage + amount, 0, 100)
	char:SetAttribute("Rage", newRage)
	return newRage
end

--------------------------------------------------------------------------------
-- PUBLIC API & REMOTE CONNECTIONS
--------------------------------------------------------------------------------

-- Checks and triggers counter if victim is in active counter stance
function SkillServer.CheckCounter(victimChar: Model, attackerChar: Model?): boolean
	local counter = activeCounters[victimChar]
	if counter and os.clock() <= counter.Expiry then
		if attackerChar then
			counter.Punish(attackerChar)
		end
		return true
	end
	return false
end

-- Checks if a character is currently in Awakening mode
function SkillServer.IsAwakened(character: Model): boolean
	return character:GetAttribute("IsAwakened") == true
end

-- Main entry point to cast a skill (1-4)
function SkillServer.ExecuteSkill(player: Player, skillId: number): boolean
	if skillId % 1 ~= 0 or skillId < 1 or skillId > 4 then return false end
	local character = player.Character
	if not character then return false end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return false end

	-- Check character state locks (Stun, Ragdoll, Countering)
	-- Note: IsAttacking is intentionally omitted here to allow skills to chain/cancel normal attacks
	if character:GetAttribute("IsStunned") == true
		or character:GetAttribute("IsRagdolled") == true
		or character:GetAttribute("IsCountering") == true then
		return false
	end

	local isAwakened = character:GetAttribute("IsAwakened") == true
	local actionKey = "Skill_" .. skillId

	-- Check Cooldown
	if isPlayerOnCooldown(player, actionKey) then
		return false
	end

	local cd = MovesetData.GetCooldown(skillId, isAwakened)
	character:SetAttribute("IsBlocking", false)
	setPlayerCooldown(player, actionKey, cd, skillId)

	-- Dispatch corresponding skill
	if skillId == 1 then
		executeRushAttack(player, character, isAwakened)
	elseif skillId == 2 then
		executeHeavyPunch(player, character, isAwakened)
	elseif skillId == 3 then
		executeGroundSlam(player, character, isAwakened)
	elseif skillId == 4 then
		executeCounter(player, character, isAwakened)
	else
		return false
	end

	return true
end

local isInitialized = false

-- Initializes SkillServer and binds Remote listeners
function SkillServer.Init()
	if isInitialized then
		return
	end
	isInitialized = true

	local skillEvent = getSkillEvent()

	skillEvent.OnServerEvent:Connect(function(player, action, ...)
		if action == "CastSkill" then
			local rawId = ...
			local skillId = tonumber(rawId)
			if skillId and skillId >= 1 and skillId <= 4 then
				SkillServer.ExecuteSkill(player, math.floor(skillId))
			end
		elseif action == "Awakening" or action == "ActivateAwakening" then
			SkillServer.ActivateAwakening(player)
		end
	end)

	-- Clean up on player leaving or dying
	Players.PlayerRemoving:Connect(function(player)
		internalCooldowns[player] = nil
		if player.Character then
			activeCounters[player.Character] = nil
		end
		if awakenedPlayers[player] then
			awakenedPlayers[player].CleanUp()
		end
	end)

	local function onCharacterAdded(character: Model)
		local humanoid = character:WaitForChild("Humanoid", 5) :: Humanoid?
		if humanoid then
			humanoid.Died:Connect(function()
				activeCounters[character] = nil
				character:SetAttribute("IsCountering", false)
				character:SetAttribute("IsAttacking", false)
			end)
		end
	end

	local function onPlayerAdded(player: Player)
		if player.Character then
			onCharacterAdded(player.Character)
		end
		player.CharacterAdded:Connect(onCharacterAdded)
	end

	for _, player in ipairs(Players:GetPlayers()) do
		onPlayerAdded(player)
	end
	Players.PlayerAdded:Connect(onPlayerAdded)
end

-- Auto-initialize if running in Roblox Server environment
if RunService:IsServer() then
	SkillServer.Init()
end

return SkillServer
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="ModuleScript" referent="34">
      <Properties>
        <string name="Name">CooldownManager</string>
        <string name="Source"><![CDATA[--!strict
-- CooldownManager.luau
-- Server-authoritative cooldown management for skills, combat actions, and dash
-- Supports Awakening cooldown reduction modifiers (CDR) and automatic player lifecycle cleanup.

local Players = game:GetService("Players")

export type AwakeningData = {
	IsAwakened: boolean,
	ReductionMultiplier: number, -- e.g. 0.30 for 30% reduction
}

local CooldownManager = {}

-- Table structure: [Player] -> { [actionKey: string]: number (expireTimestamp) }
local playerCooldowns: { [Player]: { [string]: number } } = {}

-- Table structure: [Player] -> AwakeningData
local playerAwakening: { [Player]: AwakeningData } = {}

-- Gets or creates cooldown map for a player
local function getCooldownMap(player: Player): { [string]: number }
	local map = playerCooldowns[player]
	if not map then
		map = {}
		playerCooldowns[player] = map
	end
	return map
end

-- Sets an action cooldown for a player, applying Awakening reduction if active.
-- Returns the actual applied duration.
function CooldownManager.SetCooldown(player: Player, actionKey: string, baseDuration: number): number
	if not player or not player.Parent then
		return 0
	end

	local duration = math.max(0, baseDuration)
	local awakening = playerAwakening[player]

	if awakening and awakening.IsAwakened then
		local reduction = math.clamp(awakening.ReductionMultiplier, 0, 0.9)
		duration = duration * (1 - reduction)
	end

	local map = getCooldownMap(player)
	map[actionKey] = os.clock() + duration

	return duration
end

-- Checks if a player's action is currently on cooldown
function CooldownManager.IsOnCooldown(player: Player, actionKey: string): boolean
	local map = playerCooldowns[player]
	if not map then
		return false
	end

	local expireTime = map[actionKey]
	if not expireTime then
		return false
	end

	return os.clock() < expireTime
end

-- Returns the remaining cooldown in seconds (or 0 if ready)
function CooldownManager.GetRemainingCooldown(player: Player, actionKey: string): number
	local map = playerCooldowns[player]
	if not map then
		return 0
	end

	local expireTime = map[actionKey]
	if not expireTime then
		return 0
	end

	local remaining = expireTime - os.clock()
	return if remaining > 0 then remaining else 0
end

-- Resets a specific action cooldown for a player
function CooldownManager.ResetCooldown(player: Player, actionKey: string)
	local map = playerCooldowns[player]
	if map then
		map[actionKey] = nil
	end
end

-- Resets all cooldowns for a player
function CooldownManager.ResetAll(player: Player)
	playerCooldowns[player] = nil
end

-- Configures Awakening state and cooldown reduction fraction (e.g. 0.30 for 30% reduction)
function CooldownManager.SetAwakening(player: Player, isAwakened: boolean, reductionMultiplier: number?)
	if not player then
		return
	end

	if isAwakened then
		playerAwakening[player] = {
			IsAwakened = true,
			ReductionMultiplier = reductionMultiplier or 0.30,
		}
	else
		playerAwakening[player] = nil
	end
end

-- Returns whether player is currently awakened
function CooldownManager.IsAwakened(player: Player): boolean
	local data = playerAwakening[player]
	return data ~= nil and data.IsAwakened == true
end

-- Returns awakening CDR fraction for a player (0.0 if not awakened)
function CooldownManager.GetAwakeningDiscount(player: Player): number
	local data = playerAwakening[player]
	if data and data.IsAwakened then
		return data.ReductionMultiplier
	end
	return 0
end

-- Cleans up memory when a player leaves
function CooldownManager.OnPlayerRemoving(player: Player)
	playerCooldowns[player] = nil
	playerAwakening[player] = nil
end

-- Automatic lifecycle connection
Players.PlayerRemoving:Connect(CooldownManager.OnPlayerRemoving)

return CooldownManager
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterGui" referent="35">
    <Properties>
      <string name="Name">StarterGui</string>
    </Properties>
    <Item class="ScreenGui" referent="36">
      <Properties>
        <string name="Name">CombatHUD</string>
        <bool name="ResetOnSpawn">false</bool>
      </Properties>
      <Item class="LocalScript" referent="37">
        <Properties>
          <string name="Name">HUDController</string>
          <string name="Source"><![CDATA[--!strict
-- HUDController.client.luau
-- Client controller for the Anime Battleground Combat HUD.
-- Orchestrates real-time HealthBar tweening with damage ghost fill,
-- Ultimate / Awakening meter filling and ready glow pulse,
-- and accurate Skill Slot cooldown countdown sweeps and ready bounce animations.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui") :: PlayerGui

local HUDLayout = require(script.Parent:WaitForChild("HUDLayout"))

-- Initialize HUD
local screenGui, elements = HUDLayout.CreateHUD(PlayerGui)

-- Skill Name Mapping for Goku Base vs Super Saiyan Awakening Modes
local SKILL_NAMES = {
	Base = {
		[1] = "Rush Attack",
		[2] = "Kamehameha",
		[3] = "Kaioken",
		[4] = "Instant Transmission",
	},
	Awakening = {
		[1] = "Super Rush",
		[2] = "Super Kamehameha",
		[3] = "Kaioken x20",
		[4] = "Spirit Bomb",
	},
}

-- Initialize on-screen clickable buttons for skill slots 1 to 4
for i = 1, 4 do
	local slot = elements.SkillSlots[i]
	if slot and slot.Frame then
		if SKILL_NAMES.Base[i] then
			slot.NameLabel.Text = SKILL_NAMES.Base[i]
		end

		local clickBtn = Instance.new("TextButton")
		clickBtn.Name = "SlotClickButton"
		clickBtn.Size = UDim2.new(1, 0, 1, 0)
		clickBtn.Position = UDim2.new(0, 0, 0, 0)
		clickBtn.BackgroundTransparency = 1
		clickBtn.Text = ""
		clickBtn.ZIndex = 20
		clickBtn.Parent = slot.Frame

		local slotId = i
		clickBtn.Activated:Connect(function()
			local playerScripts = LocalPlayer:FindFirstChild("PlayerScripts")
			local csmModule = playerScripts and playerScripts:FindFirstChild("ClientSkillManager")
			if csmModule and csmModule:IsA("ModuleScript") then
				local s, csm = pcall(require, csmModule)
				if s and csm and csm.CastSkill then
					csm.CastSkill(slotId)
					return
				end
			end
			-- Fallback to remote event
			local remotes = ReplicatedStorage:FindFirstChild("Remotes")
			local skillEvent = remotes and remotes:FindFirstChild("SkillEvent") :: RemoteEvent?
			if skillEvent then
				skillEvent:FireServer("CastSkill", slotId)
			end
		end)
	end
end

-- Make Awakening Banner clickable as well
if elements.AwakeningBanner then
	local awkBtn = Instance.new("TextButton")
	awkBtn.Name = "AwakeningClickButton"
	awkBtn.Size = UDim2.new(1, 0, 1, 0)
	awkBtn.BackgroundTransparency = 1
	awkBtn.Text = ""
	awkBtn.ZIndex = 25
	awkBtn.Parent = elements.AwakeningBanner
	awkBtn.Activated:Connect(function()
		local playerScripts = LocalPlayer:FindFirstChild("PlayerScripts")
		local csmModule = playerScripts and playerScripts:FindFirstChild("ClientSkillManager")
		if csmModule and csmModule:IsA("ModuleScript") then
			local s, csm = pcall(require, csmModule)
			if s and csm and csm.ActivateAwakening then
				csm.ActivateAwakening()
				return
			end
		end
		local remotes = ReplicatedStorage:FindFirstChild("Remotes")
		local skillEvent = remotes and remotes:FindFirstChild("SkillEvent") :: RemoteEvent?
		if skillEvent then
			skillEvent:FireServer("Awakening")
		end
	end)
end

-- State variables
local currentHealth = 100
local maxHealth = 100
local currentUltimate = 0
local isAwakened = false
local awakeningEndTime = 0
local awakeningDuration = 30

-- Active Cooldowns: [slotIndex] = { EndTime, TotalDuration, Thread }
type CooldownData = {
	EndTime: number,
	TotalDuration: number,
	Connection: RBXScriptConnection?,
}
local activeCooldowns: { [number]: CooldownData } = {}

--------------------------------------------------------------------------------
-- 1. RESPONSIVE HUD SCALING
--------------------------------------------------------------------------------
local function updateViewportScale()
	local camera = workspace.CurrentCamera
	if not camera then return end
	local viewportSize = camera.ViewportSize
	local baseWidth = 1920
	local baseHeight = 1080

	local scaleX = viewportSize.X / baseWidth
	local scaleY = viewportSize.Y / baseHeight
	local finalScale = math.clamp(math.min(scaleX, scaleY) * 1.15, 0.65, 1.35)

	local hudScale = elements.MainContainer:FindFirstChild("HUDScale") :: UIScale?
	if hudScale then
		hudScale.Scale = finalScale
	end
end

if workspace.CurrentCamera then
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateViewportScale)
end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateViewportScale)
		updateViewportScale()
	end
end)
updateViewportScale()

--------------------------------------------------------------------------------
-- 2. HEALTH BAR LOGIC (SMOOTH TWEEN & DAMAGE GHOST TRAIL)
--------------------------------------------------------------------------------
local ghostTween: Tween? = nil
local healthFillTween: Tween? = nil
local lowHealthPulsing = false

local function updateHealth(newHealth: number, newMaxHealth: number)
	currentHealth = math.clamp(newHealth, 0, newMaxHealth)
	maxHealth = math.max(newMaxHealth, 1)

	local healthRatio = math.clamp(currentHealth / maxHealth, 0, 1)

	-- Update Health Text
	elements.HealthText.Text = string.format("%d / %d", math.floor(currentHealth), math.floor(maxHealth))

	-- Cancel active fill tween
	if healthFillTween then
		healthFillTween:Cancel()
	end

	-- Rapid tween for primary health fill
	healthFillTween = TweenService:Create(
		elements.HealthBarFill,
		TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = UDim2.new(healthRatio, 0, 1, 0) }
	)
	healthFillTween:Play()

	-- Delayed catchup for Ghost Fill (damage trail)
	if ghostTween then
		ghostTween:Cancel()
	end

	task.delay(0.32, function()
		if elements.HealthGhostFill and elements.HealthGhostFill.Parent then
			ghostTween = TweenService:Create(
				elements.HealthGhostFill,
				TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ Size = UDim2.new(healthRatio, 0, 1, 0) }
			)
			ghostTween:Play()
		end
	end)

	-- Low Health Warning Flash (when HP <= 25%)
	if healthRatio <= 0.25 and not lowHealthPulsing then
		lowHealthPulsing = true
		task.spawn(function()
			while lowHealthPulsing and currentHealth / maxHealth <= 0.25 do
				local flashRed = TweenService:Create(
					elements.HealthStroke,
					TweenInfo.new(0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
					{ Color = Color3.fromRGB(255, 30, 30), Thickness = 3.0 }
				)
				flashRed:Play()
				task.wait(0.4)
				local restore = TweenService:Create(
					elements.HealthStroke,
					TweenInfo.new(0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
					{ Color = Color3.fromRGB(80, 20, 20), Thickness = 1.8 }
				)
				restore:Play()
				task.wait(0.4)
			end
			elements.HealthStroke.Color = Color3.fromRGB(60, 65, 75)
			elements.HealthStroke.Thickness = 1.8
			lowHealthPulsing = false
		end)
	elseif healthRatio > 0.25 then
		lowHealthPulsing = false
		elements.HealthStroke.Color = Color3.fromRGB(60, 65, 75)
		elements.HealthStroke.Thickness = 1.8
	end
end

--------------------------------------------------------------------------------
-- 3. ULTIMATE / AWAKENING METER LOGIC
--------------------------------------------------------------------------------
local ultFillTween: Tween? = nil
local ultGlowPulsing = false

local function setUltimate(value: number)
	currentUltimate = math.clamp(value, 0, 100)

	if isAwakened then
		-- In awakening mode, meter display is handled by the countdown loop
		return
	end

	local ratio = currentUltimate / 100

	if ultFillTween then
		ultFillTween:Cancel()
	end

	ultFillTween = TweenService:Create(
		elements.UltBarFill,
		TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = UDim2.new(ratio, 0, 1, 0) }
	)
	ultFillTween:Play()

	elements.UltText.Text = string.format("ULTIMATE: %d%%", math.floor(currentUltimate))

	-- Ready State when 100%
	if currentUltimate >= 100 and not isAwakened then
		elements.AwakeningBanner.Visible = true
		elements.AwakeningText.Text = "🔥 AWAKENING READY [G] 🔥"

		if not ultGlowPulsing then
			ultGlowPulsing = true
			task.spawn(function()
				while ultGlowPulsing and currentUltimate >= 100 and not isAwakened do
					local glowOn = TweenService:Create(
						elements.UltGlowStroke,
						TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
						{ Color = Color3.fromRGB(255, 200, 40), Thickness = 3.0 }
					)
					glowOn:Play()
					task.wait(0.5)
					local glowOff = TweenService:Create(
						elements.UltGlowStroke,
						TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
						{ Color = Color3.fromRGB(150, 40, 220), Thickness = 1.5 }
					)
					glowOff:Play()
					task.wait(0.5)
				end
				ultGlowPulsing = false
				elements.UltGlowStroke.Color = Color3.fromRGB(90, 50, 140)
				elements.UltGlowStroke.Thickness = 1.5
			end)
		end
	else
		if not isAwakened then
			elements.AwakeningBanner.Visible = false
			ultGlowPulsing = false
			elements.UltGlowStroke.Color = Color3.fromRGB(90, 50, 140)
			elements.UltGlowStroke.Thickness = 1.5
		end
	end
end

local function setAwakeningState(active: boolean, duration: number?)
	isAwakened = active
	local dur = duration or awakeningDuration
	awakeningDuration = dur

	if active then
		awakeningEndTime = os.clock() + dur
		elements.AwakeningBanner.Visible = true

		-- Update Skill Names to Awakening variants
		for i = 1, 4 do
			local slot = elements.SkillSlots[i]
			if slot and SKILL_NAMES.Awakening[i] then
				slot.NameLabel.Text = SKILL_NAMES.Awakening[i]
				slot.NameLabel.TextColor3 = Color3.fromRGB(255, 215, 80)
			end
		end

		-- Flash golden aura on skill slots
		for _, slot in elements.SkillSlots do
			slot.UIStroke.Color = Color3.fromRGB(255, 180, 40)
		end

		-- Awakening Countdown Loop
		task.spawn(function()
			while isAwakened do
				local remaining = math.max(0, awakeningEndTime - os.clock())
				local fraction = remaining / dur

				elements.UltBarFill.Size = UDim2.new(fraction, 0, 1, 0)
				elements.UltText.Text = string.format("AWAKENED: %.1fs", remaining)
				elements.AwakeningText.Text = string.format("⚡ AWAKENED (%.1fs) ⚡", remaining)

				if remaining <= 0 then
					break
				end
				task.wait(0.05)
			end

			if isAwakened then
				setAwakeningState(false)
			end
		end)
	else
		-- Revert to Normal Mode
		elements.AwakeningBanner.Visible = false
		elements.UltBarFill.Size = UDim2.new(0, 0, 1, 0)
		elements.UltText.Text = "ULTIMATE: 0%"
		currentUltimate = 0

		-- Revert Skill Names
		for i = 1, 4 do
			local slot = elements.SkillSlots[i]
			if slot and SKILL_NAMES.Base[i] then
				slot.NameLabel.Text = SKILL_NAMES.Base[i]
				slot.NameLabel.TextColor3 = Color3.fromRGB(220, 225, 235)
				slot.UIStroke.Color = Color3.fromRGB(55, 60, 75)
			end
		end
	end
end

--------------------------------------------------------------------------------
-- 4. SKILL COOLDOWN SYSTEM (SWEEP OVERLAY, COUNTDOWN, POP BOUNCE)
--------------------------------------------------------------------------------
local function startSkillCooldown(slotIndex: number, duration: number)
	local slot = elements.SkillSlots[slotIndex]
	if not slot or duration <= 0 then return end

	-- Clean up prior cooldown connection if active
	if activeCooldowns[slotIndex] and activeCooldowns[slotIndex].Connection then
		activeCooldowns[slotIndex].Connection:Disconnect()
	end

	local endTime = os.clock() + duration
	slot.CooldownOverlay.Visible = true

	local conn: RBXScriptConnection? = nil
	conn = RunService.Heartbeat:Connect(function()
		local remaining = endTime - os.clock()
		if remaining <= 0 then
			-- Cooldown Complete
			if conn then
				conn:Disconnect()
			end
			activeCooldowns[slotIndex] = nil
			slot.CooldownOverlay.Visible = false
			slot.CooldownOverlay.Size = UDim2.new(1, 0, 0, 0)
			slot.TimerLabel.Text = ""

			-- Pop Bounce animation to indicate readiness
			local popTween = TweenService:Create(
				slot.UIScale,
				TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
				{ Scale = 1.15 }
			)
			local settleTween = TweenService:Create(
				slot.UIScale,
				TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ Scale = 1.0 }
			)

			-- Flash stroke green/gold momentarily
			slot.UIStroke.Color = Color3.fromRGB(80, 255, 140)
			popTween:Play()
			popTween.Completed:Connect(function()
				settleTween:Play()
				task.delay(0.2, function()
					if isAwakened then
						slot.UIStroke.Color = Color3.fromRGB(255, 180, 40)
					else
						slot.UIStroke.Color = Color3.fromRGB(55, 60, 75)
					end
				end)
			end)
		else
			-- Sweep overlay from top to bottom
			local progress = remaining / duration
			slot.CooldownOverlay.Size = UDim2.new(1, 0, progress, 0)

			-- Format timer string
			if remaining >= 10 then
				slot.TimerLabel.Text = string.format("%ds", math.ceil(remaining))
			else
				slot.TimerLabel.Text = string.format("%.1fs", remaining)
			end
		end
	end)

	activeCooldowns[slotIndex] = {
		EndTime = endTime,
		TotalDuration = duration,
		Connection = conn,
	}
end

--------------------------------------------------------------------------------
-- 5. CHARACTER CONNECTION & ATTRIBUTE LISTENERS
--------------------------------------------------------------------------------
local function connectCharacter(character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	if not humanoid then return end

	-- Initial HP setup
	updateHealth(humanoid.Health, humanoid.MaxHealth)

	humanoid.HealthChanged:Connect(function(newHealth)
		updateHealth(newHealth, humanoid.MaxHealth)
	end)

	humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(function()
		updateHealth(humanoid.Health, humanoid.MaxHealth)
	end)

	-- Attribute listener for Rage meter
	character:GetAttributeChangedSignal("Rage"):Connect(function()
		local rage = character:GetAttribute("Rage")
		if typeof(rage) == "number" then
			setUltimate(rage)
		end
	end)

	character:GetAttributeChangedSignal("IsAwakened"):Connect(function()
		local awakened = character:GetAttribute("IsAwakened") == true
		if awakened ~= isAwakened then
			setAwakeningState(awakened)
		end
	end)

	-- Read initial attributes
	local initRage = character:GetAttribute("Rage")
	if typeof(initRage) == "number" then
		setUltimate(initRage)
	end
	if character:GetAttribute("IsAwakened") == true then
		setAwakeningState(true)
	end
end

if LocalPlayer.Character then
	task.spawn(connectCharacter, LocalPlayer.Character)
end
LocalPlayer.CharacterAdded:Connect(connectCharacter)

--------------------------------------------------------------------------------
-- 6. REMOTE LISTENERS (SKILL COOLDOWNS & AWAKENING BROADCASTS)
--------------------------------------------------------------------------------
local function setupRemoteHooks()
	local Remotes = ReplicatedStorage:WaitForChild("Remotes", 8) :: Folder?
	if not Remotes then return end

	-- 1. SkillEvent
	local skillEvent = Remotes:WaitForChild("SkillEvent", 5) :: RemoteEvent?
	if skillEvent then
		skillEvent.OnClientEvent:Connect(function(action: string, data: any)
			if typeof(data) ~= "table" then return end

			if action == "SkillCooldown" and data then
				local slotId = data.SkillId or (data.ActionKey and tonumber(string.match(data.ActionKey, "(%d+)")))
				if slotId and data.Duration then
					startSkillCooldown(slotId, data.Duration)
				end
			elseif action == "SkillFired" and (data.User == LocalPlayer.Character or data.Player == LocalPlayer) then
				if data.SkillId and data.Cooldown then
					startSkillCooldown(data.SkillId, data.Cooldown)
				end
			elseif action == "AwakeningState" and (data.User == LocalPlayer.Character or data.Character == LocalPlayer.Character or data.Player == LocalPlayer) then
				setAwakeningState(data.Active == true or data.IsAwakened == true, data.Duration)
			elseif action == "AwakeningMeter" and typeof(data.Meter) == "number" then
				setUltimate(data.Meter)
			end
		end)
	end

	-- 2. CombatEvent
	local combatEvent = Remotes:WaitForChild("CombatEvent", 5) :: RemoteEvent?
	if combatEvent then
		combatEvent.OnClientEvent:Connect(function(action: string, data: any)
			if typeof(data) ~= "table" then return end
			if action == "HitConfirm" and data.Attacker == LocalPlayer.Character then
				-- Play subtle punch scale on HUD
				local mScale = elements.MainContainer:FindFirstChild("HUDScale") :: UIScale?
				if mScale then
					local cur = mScale.Scale
					local pTween = TweenService:Create(mScale, TweenInfo.new(0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = cur * 1.02 })
					local rTween = TweenService:Create(mScale, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = cur })
					pTween:Play()
					pTween.Completed:Connect(function() rTween:Play() end)
				end
			end
		end)
	end
end

task.spawn(setupRemoteHooks)

-- Expose global table for local testing / other client scripts
local HUDController = {
	StartCooldown = startSkillCooldown,
	SetHealth = updateHealth,
	SetUltimate = setUltimate,
	SetAwakening = setAwakeningState,
	Elements = elements,
}

_G.HUDController = HUDController

print("[HUDController] Initialized and active.")
return HUDController
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">HUDLayout</string>
          <string name="Source"><![CDATA[--!strict
-- HUDLayout.luau
-- Programmatic ScreenGui constructor for Roblox Battleground Arena HUD
-- Features: Health Bar with ghost damage trail, Ultimate / Awakening % gauge with glowing ready state,
-- 4 Skill Cooldown Slots with animated overlays, keybind badges, and responsive modern anime styling.

local HUDLayout = {}

export type SkillSlotElements = {
	Frame: Frame,
	NameLabel: TextLabel,
	KeyLabel: TextLabel,
	CooldownOverlay: Frame,
	TimerLabel: TextLabel,
	IconLabel: TextLabel,
	UIStroke: UIStroke,
	UIScale: UIScale,
}

export type HUDElements = {
	ScreenGui: ScreenGui,
	MainContainer: Frame,
	HealthContainer: Frame,
	HealthBarFill: Frame,
	HealthGhostFill: Frame,
	HealthText: TextLabel,
	HealthStroke: UIStroke,
	UltContainer: Frame,
	UltBarFill: Frame,
	UltText: TextLabel,
	UltGlowStroke: UIStroke,
	UltGradient: UIGradient,
	AwakeningBanner: Frame,
	AwakeningText: TextLabel,
	SkillSlots: { [number]: SkillSlotElements },
}

local SKILL_DEFAULTS = {
	[1] = { Key = "Z", Name = "Consecutive Punches", Icon = "👊" },
	[2] = { Key = "X", Name = "Heavy Punch", Icon = "💥" },
	[3] = { Key = "C", Name = "Ground Slam", Icon = "⚡" },
	[4] = { Key = "V", Name = "Flash Dash", Icon = "💨" },
}

-- Helper to create rounded corners
local function addCorner(parent: Instance, radius: UDim): UICorner
	local corner = Instance.new("UICorner")
	corner.CornerRadius = radius
	corner.Parent = parent
	return corner
end

-- Helper to create clean UI strokes
local function addStroke(parent: Instance, color: Color3, thickness: number, transparency: number?): UIStroke
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = thickness
	stroke.Transparency = transparency or 0
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = parent
	return stroke
end

function HUDLayout.CreateHUD(parent: Instance?): (ScreenGui, HUDElements)
	-- 1. Root ScreenGui
	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "CombatHUD"
	screenGui.ResetOnSpawn = false
	screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screenGui.IgnoreGuiInset = true

	-- 2. Bottom Main Container (Centered at bottom of screen)
	local mainContainer = Instance.new("Frame")
	mainContainer.Name = "MainContainer"
	mainContainer.Size = UDim2.new(0, 720, 0, 155)
	mainContainer.Position = UDim2.new(0.5, 0, 1, -25)
	mainContainer.AnchorPoint = Vector2.new(0.5, 1)
	mainContainer.BackgroundTransparency = 1
	mainContainer.Parent = screenGui

	-- Aspect / Size Constraint to scale cleanly across 1080p, 1440p, 4K, and mobile
	local uiScale = Instance.new("UIScale")
	uiScale.Name = "HUDScale"
	uiScale.Scale = 1.0
	uiScale.Parent = mainContainer

	-- 3. Health & Ultimate Meter Container (Top half of MainContainer)
	local metersFrame = Instance.new("Frame")
	metersFrame.Name = "MetersFrame"
	metersFrame.Size = UDim2.new(1, 0, 0, 52)
	metersFrame.Position = UDim2.new(0.5, 0, 0, 0)
	metersFrame.AnchorPoint = Vector2.new(0.5, 0)
	metersFrame.BackgroundTransparency = 1
	metersFrame.Parent = mainContainer

	----------------------------------------------------------------------------
	-- HEALTH BAR
	----------------------------------------------------------------------------
	local healthContainer = Instance.new("Frame")
	healthContainer.Name = "HealthContainer"
	healthContainer.Size = UDim2.new(1, 0, 0, 26)
	healthContainer.Position = UDim2.new(0, 0, 0, 0)
	healthContainer.BackgroundColor3 = Color3.fromRGB(18, 20, 24)
	healthContainer.BorderSizePixel = 0
	healthContainer.ClipsDescendants = true
	healthContainer.Parent = metersFrame
	addCorner(healthContainer, UDim.new(0, 7))
	local healthStroke = addStroke(healthContainer, Color3.fromRGB(60, 65, 75), 1.8)

	-- Ghost Fill (Damage trail / damage chunk buffer)
	local healthGhostFill = Instance.new("Frame")
	healthGhostFill.Name = "GhostFill"
	healthGhostFill.Size = UDim2.new(1, 0, 1, 0)
	healthGhostFill.BackgroundColor3 = Color3.fromRGB(240, 80, 70)
	healthGhostFill.BorderSizePixel = 0
	healthGhostFill.Parent = healthContainer
	addCorner(healthGhostFill, UDim.new(0, 6))

	-- Current Health Fill (Vibrant green gradient)
	local healthBarFill = Instance.new("Frame")
	healthBarFill.Name = "HealthFill"
	healthBarFill.Size = UDim2.new(1, 0, 1, 0)
	healthBarFill.BackgroundColor3 = Color3.fromRGB(45, 215, 95)
	healthBarFill.BorderSizePixel = 0
	healthBarFill.Parent = healthContainer
	addCorner(healthBarFill, UDim.new(0, 6))

	local healthGradient = Instance.new("UIGradient")
	healthGradient.Rotation = 90
	healthGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(90, 245, 135)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(30, 175, 70)),
	})
	healthGradient.Parent = healthBarFill

	-- Health Label (Centered: "100 / 100")
	local healthText = Instance.new("TextLabel")
	healthText.Name = "HealthText"
	healthText.Size = UDim2.new(1, 0, 1, 0)
	healthText.Position = UDim2.new(0.5, 0, 0.5, 0)
	healthText.AnchorPoint = Vector2.new(0.5, 0.5)
	healthText.BackgroundTransparency = 1
	healthText.Font = Enum.Font.GothamBlack
	healthText.TextSize = 15
	healthText.TextColor3 = Color3.fromRGB(255, 255, 255)
	healthText.TextStrokeColor3 = Color3.fromRGB(10, 15, 20)
	healthText.TextStrokeTransparency = 0.2
	healthText.Text = "100 / 100"
	healthText.ZIndex = 5
	healthText.Parent = healthContainer

	----------------------------------------------------------------------------
	-- ULTIMATE / AWAKENING METER
	----------------------------------------------------------------------------
	local ultContainer = Instance.new("Frame")
	ultContainer.Name = "UltContainer"
	ultContainer.Size = UDim2.new(1, 0, 0, 18)
	ultContainer.Position = UDim2.new(0, 0, 0, 31)
	ultContainer.BackgroundColor3 = Color3.fromRGB(15, 12, 22)
	ultContainer.BorderSizePixel = 0
	ultContainer.ClipsDescendants = true
	ultContainer.Parent = metersFrame
	addCorner(ultContainer, UDim.new(0, 6))
	local ultGlowStroke = addStroke(ultContainer, Color3.fromRGB(90, 50, 140), 1.5)

	-- Ultimate Fill Bar (Fiery Electric Magenta/Purple)
	local ultBarFill = Instance.new("Frame")
	ultBarFill.Name = "UltFill"
	ultBarFill.Size = UDim2.new(0, 0, 1, 0) -- Starts at 0%
	ultBarFill.BackgroundColor3 = Color3.fromRGB(190, 45, 255)
	ultBarFill.BorderSizePixel = 0
	ultBarFill.Parent = ultContainer
	addCorner(ultBarFill, UDim.new(0, 5))

	local ultGradient = Instance.new("UIGradient")
	ultGradient.Rotation = 0
	ultGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(120, 25, 220)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(225, 50, 200)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 160, 40)),
	})
	ultGradient.Parent = ultBarFill

	-- Ultimate Text ("ULTIMATE 0%")
	local ultText = Instance.new("TextLabel")
	ultText.Name = "UltText"
	ultText.Size = UDim2.new(1, 0, 1, 0)
	ultText.Position = UDim2.new(0.5, 0, 0.5, 0)
	ultText.AnchorPoint = Vector2.new(0.5, 0.5)
	ultText.BackgroundTransparency = 1
	ultText.Font = Enum.Font.GothamBold
	ultText.TextSize = 12
	ultText.TextColor3 = Color3.fromRGB(240, 230, 255)
	ultText.TextStrokeColor3 = Color3.fromRGB(20, 5, 30)
	ultText.TextStrokeTransparency = 0.3
	ultText.Text = "ULTIMATE: 0%"
	ultText.ZIndex = 5
	ultText.Parent = ultContainer

	----------------------------------------------------------------------------
	-- AWAKENING BANNER (Pops up when active or ready)
	----------------------------------------------------------------------------
	local awakeningBanner = Instance.new("Frame")
	awakeningBanner.Name = "AwakeningBanner"
	awakeningBanner.Size = UDim2.new(0, 260, 0, 28)
	awakeningBanner.Position = UDim2.new(0.5, 0, 0, -34)
	awakeningBanner.AnchorPoint = Vector2.new(0.5, 0)
	awakeningBanner.BackgroundColor3 = Color3.fromRGB(25, 10, 35)
	awakeningBanner.BorderSizePixel = 0
	awakeningBanner.Visible = false
	awakeningBanner.Parent = mainContainer
	addCorner(awakeningBanner, UDim.new(0, 8))
	addStroke(awakeningBanner, Color3.fromRGB(255, 200, 50), 2)

	local awakeningText = Instance.new("TextLabel")
	awakeningText.Name = "AwakeningText"
	awakeningText.Size = UDim2.new(1, 0, 1, 0)
	awakeningText.BackgroundTransparency = 1
	awakeningText.Font = Enum.Font.GothamBlack
	awakeningText.TextSize = 14
	awakeningText.TextColor3 = Color3.fromRGB(255, 215, 60)
	awakeningText.TextStrokeColor3 = Color3.fromRGB(80, 15, 0)
	awakeningText.TextStrokeTransparency = 0
	awakeningText.Text = "🔥 AWAKENING READY [G] 🔥"
	awakeningText.Parent = awakeningBanner

	----------------------------------------------------------------------------
	-- 4 SKILL SLOTS CONTAINER (Bottom half of MainContainer)
	----------------------------------------------------------------------------
	local skillsContainer = Instance.new("Frame")
	skillsContainer.Name = "SkillsContainer"
	skillsContainer.Size = UDim2.new(1, 0, 0, 90)
	skillsContainer.Position = UDim2.new(0.5, 0, 0, 60)
	skillsContainer.AnchorPoint = Vector2.new(0.5, 0)
	skillsContainer.BackgroundTransparency = 1
	skillsContainer.Parent = mainContainer

	local listLayout = Instance.new("UIListLayout")
	listLayout.FillDirection = Enum.FillDirection.Horizontal
	listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	listLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	listLayout.Padding = UDim.new(0, 14)
	listLayout.Parent = skillsContainer

	local skillSlots: { [number]: SkillSlotElements } = {}

	for slotIndex = 1, 4 do
		local defaultData = SKILL_DEFAULTS[slotIndex]

		-- Skill Slot Card Frame (82 x 82)
		local slotFrame = Instance.new("Frame")
		slotFrame.Name = "Slot_" .. slotIndex
		slotFrame.Size = UDim2.new(0, 160, 0, 82)
		slotFrame.BackgroundColor3 = Color3.fromRGB(22, 25, 32)
		slotFrame.BorderSizePixel = 0
		slotFrame.ClipsDescendants = true
		slotFrame.Parent = skillsContainer
		addCorner(slotFrame, UDim.new(0, 10))
		local slotStroke = addStroke(slotFrame, Color3.fromRGB(55, 60, 75), 1.8)

		local slotScale = Instance.new("UIScale")
		slotScale.Name = "SlotScale"
		slotScale.Scale = 1.0
		slotScale.Parent = slotFrame

		-- Background subtle gradient
		local slotGradient = Instance.new("UIGradient")
		slotGradient.Rotation = 45
		slotGradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(28, 32, 42)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(16, 18, 24)),
		})
		slotGradient.Parent = slotFrame

		-- Keybind Badge (Top-left pill: "[Z]")
		local keyBadge = Instance.new("Frame")
		keyBadge.Name = "KeyBadge"
		keyBadge.Size = UDim2.new(0, 24, 0, 22)
		keyBadge.Position = UDim2.new(0, 6, 0, 6)
		keyBadge.BackgroundColor3 = Color3.fromRGB(40, 45, 60)
		keyBadge.BorderSizePixel = 0
		keyBadge.ZIndex = 6
		keyBadge.Parent = slotFrame
		addCorner(keyBadge, UDim.new(0, 5))
		addStroke(keyBadge, Color3.fromRGB(75, 85, 110), 1)

		local keyLabel = Instance.new("TextLabel")
		keyLabel.Name = "KeyLabel"
		keyLabel.Size = UDim2.new(1, 0, 1, 0)
		keyLabel.BackgroundTransparency = 1
		keyLabel.Font = Enum.Font.GothamBlack
		keyLabel.TextSize = 13
		keyLabel.TextColor3 = Color3.fromRGB(255, 220, 60)
		keyLabel.Text = defaultData.Key
		keyLabel.ZIndex = 7
		keyLabel.Parent = keyBadge

		-- Skill Graphic Icon
		local iconLabel = Instance.new("TextLabel")
		iconLabel.Name = "IconLabel"
		iconLabel.Size = UDim2.new(0, 36, 0, 36)
		iconLabel.Position = UDim2.new(0.5, 0, 0.38, 0)
		iconLabel.AnchorPoint = Vector2.new(0.5, 0.5)
		iconLabel.BackgroundTransparency = 1
		iconLabel.Font = Enum.Font.GothamBlack
		iconLabel.TextSize = 24
		iconLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		iconLabel.Text = defaultData.Icon
		iconLabel.ZIndex = 4
		iconLabel.Parent = slotFrame

		-- Skill Name Label (Bottom centered)
		local nameLabel = Instance.new("TextLabel")
		nameLabel.Name = "NameLabel"
		nameLabel.Size = UDim2.new(1, -12, 0, 22)
		nameLabel.Position = UDim2.new(0.5, 0, 1, -4)
		nameLabel.AnchorPoint = Vector2.new(0.5, 1)
		nameLabel.BackgroundTransparency = 1
		nameLabel.Font = Enum.Font.GothamBold
		nameLabel.TextSize = 11
		nameLabel.TextColor3 = Color3.fromRGB(220, 225, 235)
		nameLabel.TextStrokeColor3 = Color3.fromRGB(10, 12, 16)
		nameLabel.TextStrokeTransparency = 0.4
		nameLabel.TextWrapped = true
		nameLabel.Text = defaultData.Name
		nameLabel.ZIndex = 5
		nameLabel.Parent = slotFrame

		-- Cooldown Overlay (Covers the slot, sweeps down as cooldown progresses)
		local cdOverlay = Instance.new("Frame")
		cdOverlay.Name = "CooldownOverlay"
		cdOverlay.Size = UDim2.new(1, 0, 0, 0) -- Starts at height 0 (ready)
		cdOverlay.Position = UDim2.new(0, 0, 1, 0)
		cdOverlay.AnchorPoint = Vector2.new(0, 1)
		cdOverlay.BackgroundColor3 = Color3.fromRGB(10, 12, 16)
		cdOverlay.BackgroundTransparency = 0.32
		cdOverlay.BorderSizePixel = 0
		cdOverlay.ZIndex = 8
		cdOverlay.Visible = false
		cdOverlay.Parent = slotFrame
		addCorner(cdOverlay, UDim.new(0, 10))

		-- Cooldown Countdown Timer Label ("12.4s")
		local timerLabel = Instance.new("TextLabel")
		timerLabel.Name = "TimerLabel"
		timerLabel.Size = UDim2.new(1, 0, 1, 0)
		timerLabel.Position = UDim2.new(0.5, 0, 0.5, 0)
		timerLabel.AnchorPoint = Vector2.new(0.5, 0.5)
		timerLabel.BackgroundTransparency = 1
		timerLabel.Font = Enum.Font.GothamBlack
		timerLabel.TextSize = 18
		timerLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		timerLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		timerLabel.TextStrokeTransparency = 0
		timerLabel.Text = ""
		timerLabel.ZIndex = 9
		timerLabel.Parent = cdOverlay

		skillSlots[slotIndex] = {
			Frame = slotFrame,
			NameLabel = nameLabel,
			KeyLabel = keyLabel,
			CooldownOverlay = cdOverlay,
			TimerLabel = timerLabel,
			IconLabel = iconLabel,
			UIStroke = slotStroke,
			UIScale = slotScale,
		}
	end

	-- Parent ScreenGui if a parent is provided (e.g. PlayerGui or StarterGui)
	if parent then
		screenGui.Parent = parent
	end

	local elements: HUDElements = {
		ScreenGui = screenGui,
		MainContainer = mainContainer,
		HealthContainer = healthContainer,
		HealthBarFill = healthBarFill,
		HealthGhostFill = healthGhostFill,
		HealthText = healthText,
		HealthStroke = healthStroke,
		UltContainer = ultContainer,
		UltBarFill = ultBarFill,
		UltText = ultText,
		UltGlowStroke = ultGlowStroke,
		UltGradient = ultGradient,
		AwakeningBanner = awakeningBanner,
		AwakeningText = awakeningText,
		SkillSlots = skillSlots,
	}

	return screenGui, elements
end

return HUDLayout
]]></string>
        </Properties>
      </Item>
    </Item>
