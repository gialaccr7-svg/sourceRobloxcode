--!strict
-- DestructibleManager.luau
-- Server-side Destructible Environment Engine for Roblox Battleground Arena
-- ("The Strongest Battlegrounds" style)
--
-- Features:
-- - BreakPillar / BreakObstacle: Fractures structures into physical unanchored debris parts
--   with randomized angular and linear velocity impulses and dust/shatter VFX.
-- - ExplodeGround: Procedurally fractures ground around impact point, launching stone shards into the air.
-- - BreakInRadius: AOE destruction for Skill 3 Ground Slam, Awakening Serious Punch, and heavy impacts.
-- - DamageDestructible: Health/durability system on destructibles with chipping feedback.
-- - Ragdoll Impact detection: Characters colliding with obstacles at high speed shatter them.
-- - Auto-Cleanup: Smoothly fades out debris shards after lifetime (8-10 seconds).
-- - Continuous Arena Respawn: Automatically restores destroyed structures after timer (15-25 seconds).

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

type DestructibleRecord = {
	Instance: BasePart,
	OriginalCFrame: CFrame,
	OriginalSize: Vector3,
	OriginalMaterial: Enum.Material,
	OriginalColor: Color3,
	OriginalTransparency: number,
	OriginalCanCollide: boolean,
	OriginalParent: Instance,
	MaxHealth: number,
	RespawnTime: number,
	RespawnAt: number,
	IsDestroyed: boolean,
}

local DestructibleManager = {}

-- Engine Configuration
DestructibleManager.Config = {
	DefaultDebrisLifetime = 8.0, -- seconds before debris fades out and is destroyed
	DefaultRespawnTime = 20.0, -- seconds before destroyed obstacle respawns
	DefaultDebrisCount = 12, -- number of physical fragments per fractured pillar
	DebrisFadeDuration = 1.2, -- fade-out tween duration
	MinCutDimension = 1.8, -- minimum stud size for a debris shard
	GroundShardCount = 10, -- number of rock shards generated by ExplodeGround
	GroundShardLifetime = 5.5,
	DefaultImpactForce = 55.0,
}

local registeredDestructibles: { [BasePart]: DestructibleRecord } = {}
local respawnQueue: { DestructibleRecord } = {}
local debrisFolder: Folder? = nil
local isInitialized = false

-- Ensures a dedicated Debris folder exists in Workspace
local function getDebrisFolder(): Folder
	if debrisFolder and debrisFolder.Parent then
		return debrisFolder
	end

	local existing = workspace:FindFirstChild("BattlegroundDebris")
	if existing and existing:IsA("Folder") then
		debrisFolder = existing
		return existing
	end

	local newFolder = Instance.new("Folder")
	newFolder.Name = "BattlegroundDebris"
	newFolder.Parent = workspace
	debrisFolder = newFolder
	return newFolder
end

-- Creates anime dust puff particle emitter at a world position
local function spawnDustEffect(position: Vector3, particleCount: number?, tintColor: Color3?)
	local count = particleCount or 25
	local color = tintColor or Color3.fromRGB(190, 185, 175)

	local attachment = Instance.new("Attachment")
	attachment.WorldPosition = position
	attachment.Parent = workspace.Terrain

	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "DestructibleDust"
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 0.1
	emitter.LightInfluence = 0.8
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1.2),
		NumberSequenceKeypoint.new(0.5, 4.0),
		NumberSequenceKeypoint.new(1.0, 6.5),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.35),
		NumberSequenceKeypoint.new(0.7, 0.65),
		NumberSequenceKeypoint.new(1.0, 1.0),
	})
	emitter.Lifetime = NumberRange.new(0.6, 1.2)
	emitter.Rate = 0
	emitter.Speed = NumberRange.new(10, 24)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Drag = 3.5
	emitter.VelocityInheritance = 0.2
	emitter.Parent = attachment

	-- Emit burst immediately
	emitter:Emit(count)

	-- Auto-cleanup attachment after particles expire
	task.delay(1.5, function()
		attachment:Destroy()
	end)
end

-- Creates an expanding ground shockwave ring
local function spawnGroundShockwave(center: Vector3, radius: number)
	local shockwave = Instance.new("Part")
	shockwave.Name = "GroundShockwave"
	shockwave.Shape = Enum.PartType.Cylinder
	shockwave.Size = Vector3.new(0.4, 2.0, 2.0)
	-- Orient cylinder flat on the ground (Cylinder height aligns along X axis)
	shockwave.CFrame = CFrame.new(center.X, center.Y + 0.2, center.Z) * CFrame.Angles(0, 0, math.rad(90))
	shockwave.Material = Enum.Material.Neon
	shockwave.Color = Color3.fromRGB(220, 210, 195)
	shockwave.Transparency = 0.3
	shockwave.Anchored = true
	shockwave.CanCollide = false
	shockwave.CastShadow = false
	shockwave.Parent = getDebrisFolder()

	local targetSize = Vector3.new(0.2, radius * 2.2, radius * 2.2)
	local tweenInfo = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local tween = TweenService:Create(shockwave, tweenInfo, {
		Size = targetSize,
		Transparency = 1.0,
	})
	tween:Play()
	tween.Completed:Connect(function()
		shockwave:Destroy()
	end)
end

-- Plays rock crumble / shatter sound at position
local function playShatterSound(position: Vector3)
	local soundPart = Instance.new("Part")
	soundPart.Name = "ShatterAudioEmitter"
	soundPart.Size = Vector3.new(0.5, 0.5, 0.5)
	soundPart.CFrame = CFrame.new(position)
	soundPart.Anchored = true
	soundPart.CanCollide = false
	soundPart.Transparency = 1
	soundPart.Parent = getDebrisFolder()

	local sound = Instance.new("Sound")
	sound.SoundId = "rbxassetid://138090596" -- Heavy stone impact / shatter SFX
	sound.Volume = 1.2
	sound.PlaybackSpeed = math.random(85, 115) / 100
	sound.RollOffMaxDistance = 150
	sound.Parent = soundPart
	sound:Play()

	sound.Ended:Connect(function()
		soundPart:Destroy()
	end)

	-- Fallback timeout
	task.delay(3.0, function()
		if soundPart and soundPart.Parent then
			soundPart:Destroy()
		end
	end)
end

-- Registers a destructible part and caches its baseline transform
local function registerPart(part: BasePart): DestructibleRecord
	local existing = registeredDestructibles[part]
	if existing then
		return existing
	end

	local maxHealth = part:GetAttribute("MaxHealth")
	if not maxHealth or typeof(maxHealth) ~= "number" then
		maxHealth = 100
		part:SetAttribute("MaxHealth", maxHealth)
	end

	local currentHealth = part:GetAttribute("CurrentHealth")
	if not currentHealth or typeof(currentHealth) ~= "number" then
		currentHealth = maxHealth
		part:SetAttribute("CurrentHealth", currentHealth)
	end

	local respawnTime = part:GetAttribute("RespawnTime")
	if not respawnTime or typeof(respawnTime) ~= "number" then
		respawnTime = DestructibleManager.Config.DefaultRespawnTime
		part:SetAttribute("RespawnTime", respawnTime)
	end

	local record: DestructibleRecord = {
		Instance = part,
		OriginalCFrame = part.CFrame,
		OriginalSize = part.Size,
		OriginalMaterial = part.Material,
		OriginalColor = part.Color,
		OriginalTransparency = part.Transparency,
		OriginalCanCollide = part.CanCollide,
		OriginalParent = part.Parent or workspace,
		MaxHealth = maxHealth,
		RespawnTime = respawnTime,
		RespawnAt = 0,
		IsDestroyed = false,
	}

	registeredDestructibles[part] = record
	return record
end

-- Finds the root BasePart for a destructible (handles direct part or Model)
local function resolveDestructiblePart(instance: Instance): BasePart?
	if instance:IsA("BasePart") then
		if CollectionService:HasTag(instance, "Destructible") or registeredDestructibles[instance] then
			return instance
		end
		-- Check parent model
		if instance.Parent and CollectionService:HasTag(instance.Parent, "Destructible") then
			-- If parent model is tagged, use the hit part or primary part
			return instance
		end
	elseif instance:IsA("Model") then
		local primary = instance.PrimaryPart or instance:FindFirstChildWhichIsA("BasePart")
		return primary
	end
	return nil
end

-- Subdivides a BasePart into multiple unanchored physical debris shards with impulses
local function fracturePartIntoDebris(part: BasePart, impactPos: Vector3, impactForce: number)
	local container = getDebrisFolder()
	local partSize = part.Size
	local partCFrame = part.CFrame

	-- Determine subdivision grid (e.g. 2 x 3 x 2 = 12 shards)
	local cutsX = math.max(1, math.floor(partSize.X / 3.0))
	local cutsY = math.max(1, math.floor(partSize.Y / 3.5))
	local cutsZ = math.max(1, math.floor(partSize.Z / 3.0))

	-- Clamp total shards between 6 and 18 for high physics fidelity without lag
	cutsX = math.clamp(cutsX, 2, 3)
	cutsY = math.clamp(cutsY, 2, 4)
	cutsZ = math.clamp(cutsZ, 2, 3)

	local shardSizeX = partSize.X / cutsX
	local shardSizeY = partSize.Y / cutsY
	local shardSizeZ = partSize.Z / cutsZ

	local debrisList: { BasePart } = {}

	for ix = 1, cutsX do
		for iy = 1, cutsY do
			for iz = 1, cutsZ do
				-- Calculate local offset with slight organic jitter (+-15%)
				local jitterX = (math.random(-15, 15) / 100) * shardSizeX
				local jitterY = (math.random(-15, 15) / 100) * shardSizeY
				local jitterZ = (math.random(-15, 15) / 100) * shardSizeZ

				local localOffset = Vector3.new(
					-partSize.X / 2 + shardSizeX * (ix - 0.5) + jitterX,
					-partSize.Y / 2 + shardSizeY * (iy - 0.5) + jitterY,
					-partSize.Z / 2 + shardSizeZ * (iz - 0.5) + jitterZ
				)

				local worldPos = partCFrame:PointToWorldSpace(localOffset)

				-- Build shard part
				local shard = Instance.new("Part")
				shard.Name = "DebrisShard"
				shard.Size = Vector3.new(
					math.max(DestructibleManager.Config.MinCutDimension, shardSizeX * (math.random(85, 115) / 100)),
					math.max(DestructibleManager.Config.MinCutDimension, shardSizeY * (math.random(85, 115) / 100)),
					math.max(DestructibleManager.Config.MinCutDimension, shardSizeZ * (math.random(85, 115) / 100))
				)
				shard.CFrame = CFrame.new(worldPos) * CFrame.Angles(
					math.rad(math.random(-25, 25)),
					math.rad(math.random(-180, 180)),
					math.rad(math.random(-25, 25))
				)
				shard.Material = part.Material
				shard.Color = part.Color
				shard.Anchored = false
				shard.CanCollide = true
				shard.Massless = false
				shard.CastShadow = true
				shard.Parent = container

				-- Compute outward explosive impulse direction
				local burstDir = (worldPos - impactPos)
				if burstDir.Magnitude < 0.1 then
					burstDir = Vector3.new(math.random(-10, 10), math.random(5, 15), math.random(-10, 10)).Unit
				else
					burstDir = burstDir.Unit
				end

				-- Upward lift & radial velocity
				local lift = math.random(18, 42)
				local radialSpeed = math.random(25, 60) * (impactForce / 50.0)
				local velocity = (burstDir * radialSpeed) + Vector3.new(0, lift, 0)
				local angularVelocity = Vector3.new(
					math.random(-15, 15),
					math.random(-15, 15),
					math.random(-15, 15)
				)

				shard.AssemblyLinearVelocity = velocity
				shard.AssemblyAngularVelocity = angularVelocity

				-- Apply impulse directly to physics engine if supported
				pcall(function()
					shard:ApplyImpulse(velocity * shard:GetMass() * 0.5)
				end)

				table.insert(debrisList, shard)
			end
		end
	end

	-- Schedule smooth fade-out and destruction for all debris shards
	local lifetime = DestructibleManager.Config.DefaultDebrisLifetime
	task.delay(lifetime, function()
		for _, shard in ipairs(debrisList) do
			if shard and shard.Parent then
				local fadeTween = TweenService:Create(
					shard,
					TweenInfo.new(DestructibleManager.Config.DebrisFadeDuration, Enum.EasingStyle.Linear),
					{ Transparency = 1.0 }
				)
				fadeTween:Play()
				fadeTween.Completed:Connect(function()
					shard:Destroy()
				end)
			end
		end
	end)
end

-- =========================================================================
-- PUBLIC API METHODS
-- =========================================================================

-- Slices or breaks the structure into multiple smaller physical debris parts
-- Applies radial/angular impulses, dust particles, and manages respawn queue
function DestructibleManager.BreakPillar(modelOrPart: Instance, impactPoint: Vector3?, impactForce: number?)
	local part = resolveDestructiblePart(modelOrPart)
	if not part then
		return
	end

	local record = registeredDestructibles[part] or registerPart(part)
	if record.IsDestroyed then
		return -- Already broken, awaiting respawn
	end

	record.IsDestroyed = true
	record.RespawnAt = os.clock() + record.RespawnTime
	table.insert(respawnQueue, record)

	local center = part.Position
	local hitPos = impactPoint or center
	local force = impactForce or DestructibleManager.Config.DefaultImpactForce

	-- 1. Fracture into physics debris shards
	fracturePartIntoDebris(part, hitPos, force)

	-- 2. Spawn Dust & Sound VFX
	spawnDustEffect(hitPos, 30, part.Color)
	playShatterSound(hitPos)

	-- 3. Hide intact obstacle (prevent collision and interaction while awaiting respawn)
	part.Transparency = 1.0
	part.CanCollide = false

	-- If part is inside a Model with other parts/decals, hide children as well
	if part.Parent and part.Parent:IsA("Model") and part.Parent.Name ~= "Workspace" then
		for _, child in ipairs(part.Parent:GetDescendants()) do
			if child:IsA("BasePart") then
				child.Transparency = 1.0
				child.CanCollide = false
			elseif child:IsA("Decal") or child:IsA("Texture") then
				child.Transparency = 1.0
			end
		end
	end
end

-- Fractures ground around centerPos (Skill 3 Ground Slam, Heavy Punch impact)
-- Spawns unanchored flying stone shards into the air
function DestructibleManager.ExplodeGround(centerPos: Vector3, radius: number?, force: number?)
	local rad = radius or 16.0
	local blastForce = force or DestructibleManager.Config.DefaultImpactForce
	local container = getDebrisFolder()

	-- 1. Visual shockwave & dust burst
	spawnGroundShockwave(centerPos, rad)
	spawnDustEffect(centerPos, 35, Color3.fromRGB(160, 155, 145))
	playShatterSound(centerPos)

	-- 2. Procedural flying rock shards
	local shardCount = DestructibleManager.Config.GroundShardCount
	local groundShards: { BasePart } = {}

	for i = 1, shardCount do
		local angle = (i / shardCount) * (2 * math.pi) + math.random(-15, 15) / 100
		local dist = math.random(30, math.floor(rad * 85)) / 100
		local offset = Vector3.new(math.cos(angle) * dist, 0.2, math.sin(angle) * dist)
		local spawnPos = centerPos + offset

		local rock = Instance.new("Part")
		rock.Name = "GroundRockShard"
		rock.Size = Vector3.new(
			math.random(15, 32) / 10,
			math.random(15, 25) / 10,
			math.random(15, 32) / 10
		)
		rock.CFrame = CFrame.new(spawnPos) * CFrame.Angles(
			math.rad(math.random(-180, 180)),
			math.rad(math.random(-180, 180)),
			math.rad(math.random(-180, 180))
		)
		rock.Material = Enum.Material.Slate
		rock.Color = Color3.fromRGB(85, 90, 100)
		rock.Anchored = false
		rock.CanCollide = true
		rock.Massless = false
		rock.Parent = container

		-- Radial explosion impulse away from center + strong upward lift
		local radialDir = Vector3.new(offset.X, 0, offset.Z).Unit
		if radialDir.Magnitude < 0.1 then
			radialDir = Vector3.new(math.random(-10, 10), 0, math.random(-10, 10)).Unit
		end

		local horizontalSpeed = math.random(20, 50) * (blastForce / 50.0)
		local upwardSpeed = math.random(32, 65) * (blastForce / 50.0)
		local velocity = (radialDir * horizontalSpeed) + Vector3.new(0, upwardSpeed, 0)
		local angularVelocity = Vector3.new(
			math.random(-25, 25),
			math.random(-25, 25),
			math.random(-25, 25)
		)

		rock.AssemblyLinearVelocity = velocity
		rock.AssemblyAngularVelocity = angularVelocity

		table.insert(groundShards, rock)
	end

	-- Auto-cleanup ground rock shards
	task.delay(DestructibleManager.Config.GroundShardLifetime, function()
		for _, rock in ipairs(groundShards) do
			if rock and rock.Parent then
				local fadeTween = TweenService:Create(
					rock,
					TweenInfo.new(1.0, Enum.EasingStyle.Linear),
					{ Transparency = 1.0 }
				)
				fadeTween:Play()
				fadeTween.Completed:Connect(function()
					rock:Destroy()
				end)
			end
		end
	end)
end

-- Interoperability contract method required by PROJECT.md & HitboxManager.luau
-- Handles BreakObstacle(hitPart, impactVelocity, aoeRadius)
function DestructibleManager.BreakObstacle(hitPart: Instance, impactVelocity: any, aoeRadius: number?)
	local force = DestructibleManager.Config.DefaultImpactForce
	local hitPoint: Vector3? = nil

	if typeof(impactVelocity) == "Vector3" then
		force = math.clamp(impactVelocity.Magnitude, 30, 120)
	elseif typeof(impactVelocity) == "number" then
		force = impactVelocity
	end

	if hitPart:IsA("BasePart") then
		hitPoint = hitPart.Position
	end

	-- 1. Break the hit obstacle if destructible
	local part = resolveDestructiblePart(hitPart)
	if part then
		DestructibleManager.BreakPillar(part, hitPoint, force)
	end

	-- 2. If AOE radius is specified, break nearby obstacles and fracture ground
	if aoeRadius and aoeRadius > 0 and hitPoint then
		DestructibleManager.BreakInRadius(hitPoint, aoeRadius, force)
	end
end

-- Destroys all destructibles within a spatial radius around centerPos
function DestructibleManager.BreakInRadius(centerPos: Vector3, radius: number, force: number?)
	local blastForce = force or DestructibleManager.Config.DefaultImpactForce

	-- 1. Trigger ground explosion visual & shards
	DestructibleManager.ExplodeGround(centerPos, radius, blastForce)

	-- 2. Search for registered and tagged destructibles within distance
	for _, part in ipairs(CollectionService:GetTagged("Destructible")) do
		if part:IsA("BasePart") then
			local dist = (part.Position - centerPos).Magnitude
			if dist <= radius then
				DestructibleManager.BreakPillar(part, centerPos, blastForce)
			end
		elseif part:IsA("Model") then
			local primary = part.PrimaryPart or part:FindFirstChildWhichIsA("BasePart")
			if primary and (primary.Position - centerPos).Magnitude <= radius then
				DestructibleManager.BreakPillar(part, centerPos, blastForce)
			end
		end
	end
end

-- Breaks all destructibles within an oriented bounding box corridor (e.g. Heavy Punch, Kamehameha blast)
function DestructibleManager.BreakObstaclesInBox(boxCFrame: CFrame, boxSize: Vector3, impulse: Vector3?)
	local blastForce = impulse and impulse.Magnitude or DestructibleManager.Config.DefaultImpactForce
	local halfX = boxSize.X / 2
	local halfY = boxSize.Y / 2
	local halfZ = boxSize.Z / 2
	local centerPos = boxCFrame.Position

	-- 1. Explode ground shockwave along the blast corridor
	DestructibleManager.ExplodeGround(centerPos, math.max(boxSize.X, boxSize.Z) * 0.5, blastForce)

	-- 2. Precise 3D OBB intersection test for all registered & tagged destructibles
	for _, inst in ipairs(CollectionService:GetTagged("Destructible")) do
		local part: BasePart? = nil
		if inst:IsA("BasePart") then
			part = inst
		elseif inst:IsA("Model") then
			part = inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart")
		end

		if part then
			local rel = boxCFrame:PointToObjectSpace(part.Position)
			local marginX = part.Size.X / 2
			local marginY = part.Size.Y / 2
			local marginZ = part.Size.Z / 2

			if math.abs(rel.X) <= (halfX + marginX)
				and math.abs(rel.Y) <= (halfY + marginY)
				and math.abs(rel.Z) <= (halfZ + marginZ) then
				DestructibleManager.BreakPillar(part, part.Position, blastForce)
			end
		end
	end
end

-- Decrements health on a destructible, triggering break if depleted
function DestructibleManager.DamageDestructible(
	target: Instance,
	damage: number,
	impactPoint: Vector3?,
	impactVelocity: Vector3?
): boolean
	local part = resolveDestructiblePart(target)
	if not part then
		return false
	end

	local record = registeredDestructibles[part] or registerPart(part)
	if record.IsDestroyed then
		return false
	end

	local currentHealth = part:GetAttribute("CurrentHealth") or record.MaxHealth
	local newHealth = math.max(0, currentHealth - damage)
	part:SetAttribute("CurrentHealth", newHealth)

	local hitPos = impactPoint or part.Position
	local force = impactVelocity and impactVelocity.Magnitude or DestructibleManager.Config.DefaultImpactForce

	if newHealth <= 0 then
		DestructibleManager.BreakPillar(part, hitPos, force)
		return true
	else
		-- Chipping feedback: spawn minor dust and small rock chips
		spawnDustEffect(hitPos, 8, part.Color)
		return false
	end
end

-- Checks whether a ragdolled or knocked-back character has collided with a destructible
function DestructibleManager.CheckRagdollImpact(character: Model, hitPart: BasePart, hitVelocity: Vector3)
	if not hitPart or not hitPart.Parent then
		return
	end

	local speed = hitVelocity.Magnitude
	if speed < 35.0 then
		return -- Below wall splat / destructible fracture threshold
	end

	local isDestructible = CollectionService:HasTag(hitPart, "Destructible")
		or (hitPart.Parent and CollectionService:HasTag(hitPart.Parent, "Destructible"))
		or registeredDestructibles[hitPart] ~= nil

	if isDestructible then
		-- Heavy impact shatters the destructible
		local impactDamage = math.floor(speed * 1.5)
		DestructibleManager.DamageDestructible(hitPart, impactDamage, hitPart.Position, hitVelocity)
	end
end

-- Respawns a previously destroyed structure back to pristine condition
local function respawnRecord(record: DestructibleRecord)
	local part = record.Instance
	if not part or not part.Parent then
		return
	end

	record.IsDestroyed = false
	part.CFrame = record.OriginalCFrame
	part.Size = record.OriginalSize
	part.Material = record.OriginalMaterial
	part.Color = record.OriginalColor
	part.Transparency = record.OriginalTransparency
	part.CanCollide = record.OriginalCanCollide
	part:SetAttribute("CurrentHealth", record.MaxHealth)

	-- If model, restore child parts
	if part.Parent and part.Parent:IsA("Model") and part.Parent.Name ~= "Workspace" then
		for _, child in ipairs(part.Parent:GetDescendants()) do
			if child:IsA("BasePart") then
				child.Transparency = record.OriginalTransparency
				child.CanCollide = record.OriginalCanCollide
			elseif child:IsA("Decal") or child:IsA("Texture") then
				child.Transparency = 0
			end
		end
	end

	-- Rebuild dust puff effect
	spawnDustEffect(part.Position, 20, record.OriginalColor)
end

-- Resets all destructibles immediately (useful for testing or match restarts)
function DestructibleManager.ResetAll()
	for _, record in pairs(registeredDestructibles) do
		respawnRecord(record)
	end
	table.clear(respawnQueue)

	local folder = debrisFolder or workspace:FindFirstChild("BattlegroundDebris")
	if folder then
		folder:ClearAllChildren()
	end
end

-- Initializes DestructibleManager listeners and the continuous respawn cycle
function DestructibleManager.Init()
	if isInitialized then
		return
	end
	isInitialized = true

	getDebrisFolder()

	-- Index existing destructibles tagged in Workspace
	for _, inst in ipairs(CollectionService:GetTagged("Destructible")) do
		if inst:IsA("BasePart") then
			registerPart(inst)
		elseif inst:IsA("Model") then
			for _, child in ipairs(inst:GetDescendants()) do
				if child:IsA("BasePart") then
					registerPart(child)
				end
			end
		end
	end

	-- Listen for dynamically added destructibles
	CollectionService:GetInstanceAddedSignal("Destructible"):Connect(function(inst: Instance)
		if inst:IsA("BasePart") then
			registerPart(inst)
		elseif inst:IsA("Model") then
			for _, child in ipairs(inst:GetDescendants()) do
				if child:IsA("BasePart") then
					registerPart(child)
				end
			end
		end
	end)

	-- Start continuous respawn check loop (checks every 0.5s)
	task.spawn(function()
		while true do
			task.wait(0.5)
			local now = os.clock()
			local i = 1
			while i <= #respawnQueue do
				local record = respawnQueue[i]
				if now >= record.RespawnAt then
					respawnRecord(record)
					table.remove(respawnQueue, i)
				else
					i = i + 1
				end
			end
		end
	end)
end

return DestructibleManager
